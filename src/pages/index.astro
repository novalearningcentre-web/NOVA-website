			'Academic support that strengthens conceptual foundations, learning habits and confidence.',
		labelId: 'SD Kelas 1–6',
		labelEn: 'Primary Years 1–6',
		href: '/programs#primary',
	},
	{
		number: '03',
		titleId: 'Secondary',
		titleEn: 'Secondary',
		descriptionId:
			'Program terarah untuk memahami konsep, mengembangkan strategi belajar, dan mempersiapkan ujian.',
		descriptionEn:
			'Focused support to deepen understanding, build effective learning strategies and prepare for assessments.',
		labelId: 'SMP & SMA',
		labelEn: 'Junior & Senior Secondary',
		href: '/programs#secondary',
	},
	{
		number: '04',
		titleId: 'Skills & Enrichment',
		titleEn: 'Skills & Enrichment',
		descriptionId:
			'Program pengayaan melalui coding, robotics, sensory class, creative art, dan keterampilan praktis.',
		descriptionEn:
			'Enrichment through coding, robotics, sensory learning, creative art and practical future-ready skills.',
		labelId: 'Beragam jenjang',
		labelEn: 'Multiple age groups',
		href: '/programs#skills',
	},
];

const activities: Activity[] = [
	{
		titleId: 'Academic Learning',
		titleEn: 'Academic Learning',
		descriptionId: 'Pendampingan akademik yang terarah dan interaktif.',
		descriptionEn: 'Focused and interactive academic support.',
		image: '/images/program-academic-class.png',
		href: '/programs#academic',
	},
	{
		titleId: 'Coding & Robotics',
		titleEn: 'Coding & Robotics',
		descriptionId: 'Belajar teknologi melalui proyek dan pemecahan masalah.',
		descriptionEn: 'Learn technology through projects and problem-solving.',
		image: '/images/program-coding-robotics.png',
		href: '/programs#coding-robotics',
	},
	{
		titleId: 'Sensory Class',
		titleEn: 'Sensory Class',
		descriptionId: 'Eksplorasi sensorik untuk mendukung perkembangan anak usia dini.',
		descriptionEn: 'Sensory exploration designed for early childhood development.',
		image: '/images/program-sensory-class.png',
		href: '/programs#sensory',
	},
	{
		titleId: 'Drawing & Art',
		titleEn: 'Drawing & Art',
		descriptionId: 'Ruang kreatif untuk menggambar, bereksperimen, dan berekspresi.',
		descriptionEn: 'A creative space to draw, experiment and express ideas.',
		image: '/images/program-drawing-art.png',
		href: '/programs#drawing-art',
	},
];

const teachers: Teacher[] = [
	{
		initials: 'HK',
		name: 'Halley Kuncoro',
		photo: '/images/teacher-1.png',
		credentials:
			'Master of Educational Technology · STEM Certified Educator · Google Certified Educator',
		subjects: ['Matematika', 'ICT', 'Computing'],
		quoteId:
			'Belajar bukan hanya memahami materi, tetapi membangun cara berpikir dan rasa percaya diri.',
		quoteEn:
			'Learning is not only about understanding content, but also about building strong thinking skills and confidence.',
	},
	{
		initials: 'MP',
		name: 'Monica Putri Pertiwi',
		photo: '/images/teacher-4.png',
		credentials: 'S.Pd. · Early Childhood & English Educator',
		subjects: ['English', 'Pre-School', 'Primary'],
		quoteId: 'Nurturing young minds to grow, explore, and shine.',
		quoteEn: 'Nurturing young minds to grow, explore, and shine.',
	},
	{
		initials: 'KF',
		name: 'Karimah Fajriani',
		photo: '/images/teacher-5.png',
		credentials: 'S.Pd. · Physics Educator',
		subjects: ['Science', 'Matematika', 'SMP', 'Fisika', 'SMA'],
		quoteId:
			'Menciptakan ruang belajar yang mendorong siswa untuk bertanya, memahami, dan percaya pada kemampuannya.',
		quoteEn:
			'Creating a learning space that encourages students to ask questions, understand deeply and believe in their abilities.',
	},
	{
		initials: 'JS',
		name: 'Juli Silaen',
		photo: '/images/teacher-6.png',
		credentials:
			'S.I.Kom. · Early Childhood Educator · Child-Centred Learning',
		subjects: ['PAUD', 'TK', 'School Readiness'],
		quoteId:
			'Anak belajar paling baik ketika kegiatan terasa aman, menyenangkan, dan sesuai tahap perkembangannya.',
		quoteEn:
			'Children learn best when activities feel safe, enjoyable and appropriate for their stage of development.',
	},
	
];

/*
	CONTOH TESTIMONI UNTUK PREVIEW DESAIN.
	Jangan dipublikasikan sebagai testimoni nyata.
*/
const testimonials: Testimonial[] = [
	{
		quoteId:
			'Yang paling terasa, anak saya sekarang lebih berani bertanya ketika belum paham. Belajarnya juga jadi lebih teratur dan tidak lagi terasa seperti beban.',
		quoteEn:
			'The biggest change is that my child is now more confident asking questions when something is unclear. Learning also feels more structured and less overwhelming.',
		name: 'Rina Santoso',
		relationId: 'Orang tua siswa SD',
		relationEn: 'Primary school parent',
		programId: 'Program Primary',
		programEn: 'Primary Program',
		rating: 5,
		photo: '',
		demo: true,
	},
	{
		quoteId:
			'Saya suka karena pengajarnya tidak hanya mengejar banyak soal. Konsepnya benar-benar dijelaskan sampai anak paham, lalu baru dilatih supaya lebih mandiri.',
		quoteEn:
			'I like that the teachers do not simply rush through worksheets. Concepts are explained clearly first, then students are guided to become more independent.',
		name: 'Melissa Wijaya',
		relationId: 'Orang tua siswa SMP',
		relationEn: 'Secondary school parent',
		programId: 'Program Secondary',
		programEn: 'Secondary Program',
		rating: 5,
		photo: '',
		demo: true,
	},
	{
		quoteId:
			'Kelasnya terasa nyaman dan tidak membuat saya takut salah. Saya jadi lebih percaya diri untuk mencoba, bertanya, dan menjelaskan jawaban saya sendiri.',
		quoteEn:
			'The class feels comfortable and I am not afraid of making mistakes. I feel more confident trying, asking questions and explaining my own answers.',
		name: 'Jessica Tan',
		relationId: 'Siswa SMP',
		relationEn: 'Secondary student',
		programId: 'English & Academic Skills',
		programEn: 'English & Academic Skills',
		rating: 5,
		photo: '',
		demo: true,
	},
	{
		quoteId:
			'Komunikasi dengan orang tua jelas dan perkembangan belajar anak lebih mudah dipantau. Kami jadi tahu bagian mana yang sudah kuat dan mana yang masih perlu dibantu.',
		quoteEn:
			'Communication with parents is clear and learning progress is easier to monitor. We can see what is already strong and what still needs support.',
		name: 'Dewi Anggraini',
		relationId: 'Orang tua siswa',
		relationEn: 'Parent',
		programId: 'Private Class',
		programEn: 'Private Class',
		rating: 5,
		photo: '',
		demo: true,
	},
	{
		quoteId:
			'Materi online membantu saya mengulang pelajaran kapan saja. Kalau ada bagian yang belum paham, saya bisa kembali ke materinya sebelum lanjut ke latihan berikutnya.',
		quoteEn:
			'The online materials help me revise whenever I need to. If I do not understand something, I can revisit it before moving on to the next activity.',
		name: 'Ethan Hartono',
		relationId: 'Siswa SMA',
		relationEn: 'Senior secondary student',
		programId: 'NOVA E-Learning',
		programEn: 'NOVA E-Learning',
		rating: 5,
		photo: '',
		demo: true,
	},
];

const whatsappUrl =
	'https://wa.me/6285195511236?text=Halo%20NOVA%20Learning%20Centre%2C%20saya%20ingin%20bertanya%20mengenai%20program%20belajar.';
---

<Layout
	title="NOVA Learning Centre"
	description="Pusat pembelajaran modern untuk anak dan remaja di Kelapa Gading."
>
	<main class="overflow-hidden">
		<!-- HERO -->
		<section class="relative bg-[#f7f8fc]">
			<div class="absolute -left-24 top-16 h-72 w-72 rounded-full bg-[#f3bc34]/18 blur-3xl" aria-hidden="true"></div>
			<div class="absolute -right-28 bottom-0 h-80 w-80 rounded-full bg-[#1d2f5c]/10 blur-3xl" aria-hidden="true"></div>

			<div class="relative mx-auto grid min-h-[700px] max-w-7xl items-center gap-12 px-6 py-16 lg:grid-cols-[0.93fr_1.07fr] lg:px-8 lg:py-20">
				<div class="reveal relative z-10">
					<div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#f3bc34]/50 bg-white px-4 py-2 shadow-sm">
						<span class="h-2 w-2 rounded-full bg-[#f3bc34]"></span>
						<span class="text-sm font-semibold text-[#1d2f5c]">
							Inspiring Young Minds, Building Bright Futures
						</span>
					</div>

					<h1 class="max-w-3xl text-5xl font-extrabold leading-[1.05] tracking-[-0.045em] text-[#1d2f5c] sm:text-6xl lg:text-[68px]">
						<span class="lang-id">
							Belajar lebih terarah.
							<span class="mt-2 block text-[#1d2f5c]">
								Tumbuh lebih <span class="relative inline-block">
									percaya diri.
									<span class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/65" aria-hidden="true"></span>
								</span>
							</span>
						</span>

						<span class="lang-en">
							Learn with direction.
							<span class="mt-2 block text-[#1d2f5c]">
								Grow with <span class="relative inline-block">
									confidence.
									<span class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/65" aria-hidden="true"></span>
								</span>
							</span>
						</span>
					</h1>

					<p class="mt-7 max-w-xl text-lg leading-8 text-slate-600">
						<span class="lang-id">
							NOVA menghadirkan pembelajaran personal melalui kelas tatap muka, kelompok kecil, private class, dan e-learning yang fleksibel.
						</span>
						<span class="lang-en">
							NOVA provides personalised learning through face-to-face classes, small groups, private lessons and flexible e-learning.
						</span>
					</p>

					<div class="mt-9 flex flex-col gap-3 sm:flex-row">
						<a href="/programs" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#f3bc34] px-7 py-4 font-bold text-[#1d2f5c] shadow-lg shadow-[#f3bc34]/20 transition hover:-translate-y-0.5 hover:shadow-xl">
							<span class="lang-id">Lihat Program</span>
							<span class="lang-en">Explore Programs</span>
							<span aria-hidden="true">→</span>
						</a>

						<a href={whatsappUrl} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center rounded-lg border border-[#1d2f5c]/20 bg-white px-7 py-4 font-semibold text-[#1d2f5c] transition hover:border-[#1d2f5c] hover:bg-[#1d2f5c] hover:text-white">
							<span class="lang-id">Chat via WhatsApp</span>
							<span class="lang-en">Chat on WhatsApp</span>
						</a>
					</div>

					<div class="mt-9 flex flex-wrap gap-3 text-sm font-semibold text-[#1d2f5c]">
						<span class="rounded-full border border-slate-200 bg-white px-4 py-2">
							<span class="lang-id">Kelompok Kecil</span>
							<span class="lang-en">Small Groups</span>
						</span>
						<span class="rounded-full border border-slate-200 bg-white px-4 py-2">
							<span class="lang-id">Pendampingan Personal</span>
							<span class="lang-en">Personalised Support</span>
						</span>
						<span class="rounded-full border border-slate-200 bg-white px-4 py-2">
							<span class="lang-id">Onsite & Online</span>
							<span class="lang-en">Onsite & Online</span>
						</span>
					</div>
				</div>

				<div class="reveal relative mx-auto w-full max-w-2xl">
					<div class="absolute -bottom-6 -left-6 h-28 w-28 bg-[#f3bc34]" aria-hidden="true"></div>
					<div class="absolute -right-5 -top-5 h-24 w-24 border-2 border-[#1d2f5c]" aria-hidden="true"></div>

					<div class="hero-photo relative overflow-hidden rounded-[28px] bg-white p-3 shadow-[0_30px_80px_rgba(29,47,92,0.18)]">
						<img
							src="/images/homepage-learning-activity.png"
							alt="Students learning together with a NOVA teacher"
							class="h-[520px] w-full rounded-[20px] object-cover"
							fetchpriority="high"
						/>

						<div class="absolute bottom-7 left-7 right-7 grid gap-3 sm:grid-cols-2">
							<div class="rounded-xl bg-white/95 p-4 shadow-lg backdrop-blur">
								<p class="text-xs font-bold uppercase tracking-[0.14em] text-[#1d2f5c]/50">
									<span class="lang-id">Cara Belajar</span>
									<span class="lang-en">Learning Approach</span>
								</p>
								<p class="mt-1 font-bold text-[#1d2f5c]">
									<span class="lang-id">Terarah & Aktif</span>
									<span class="lang-en">Guided & Active</span>
								</p>
							</div>

							<div class="rounded-xl bg-[#1d2f5c]/95 p-4 text-white shadow-lg backdrop-blur">
								<p class="text-xs font-bold uppercase tracking-[0.14em] text-[#f3bc34]">
									NOVA
								</p>
								<p class="mt-1 font-bold">
									<span class="lang-id">Belajar dengan percaya diri</span>
									<span class="lang-en">Learn with confidence</span>
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- STATISTICS -->
		<section class="border-y border-slate-200 bg-white">
			<div class="mx-auto grid max-w-7xl grid-cols-2 px-6 py-7 md:grid-cols-4 lg:px-8">
				{
					statistics.map((stat) => (
						<div class="border-slate-200 px-4 py-5 text-center even:border-l md:border-l md:first:border-l-0">
							<p class="text-2xl font-extrabold text-[#1d2f5c] md:text-3xl">{stat.value}</p>
							<p class="mt-2 text-sm leading-5 text-slate-500">
								<span class="lang-id">{stat.labelId}</span>
								<span class="lang-en">{stat.labelEn}</span>
							</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- PROGRAMS -->
		<section class="bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="reveal flex flex-col justify-between gap-8 md:flex-row md:items-end">
					<div>
						<p class="section-label">
							<span class="lang-id">Program NOVA</span>
							<span class="lang-en">NOVA Programs</span>
						</p>

						<h2 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-[-0.03em] text-[#1d2f5c] md:text-5xl">
							<span class="lang-id">Program belajar untuk setiap tahap perkembangan.</span>
							<span class="lang-en">Learning programs for every stage of development.</span>
						</h2>
					</div>

					<a href="/programs" class="inline-flex items-center gap-2 font-bold text-[#1d2f5c] transition hover:text-[#1d2f5c]/65">
						<span class="lang-id">Lihat semua program</span>
						<span class="lang-en">View all programs</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>

				<div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
					{
						programs.map((program) => (
							<a href={program.href} class="reveal group border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-[#f3bc34] hover:shadow-xl">
								<div class="flex items-center justify-between">
									<div class="flex h-11 w-11 items-center justify-center bg-[#1d2f5c] text-sm font-extrabold text-white transition group-hover:bg-[#f3bc34] group-hover:text-[#1d2f5c]">
										{program.number}
									</div>
									<span class="text-lg text-slate-300 transition group-hover:translate-x-1 group-hover:text-[#1d2f5c]">→</span>
								</div>

								<p class="mt-6 text-xs font-bold uppercase tracking-[0.14em] text-[#1d2f5c]/50">
									<span class="lang-id">{program.labelId}</span>
									<span class="lang-en">{program.labelEn}</span>
								</p>

								<h3 class="mt-2 text-xl font-extrabold text-[#1d2f5c]">
									<span class="lang-id">{program.titleId}</span>
									<span class="lang-en">{program.titleEn}</span>
								</h3>

								<p class="mt-3 text-sm leading-6 text-slate-500">
									<span class="lang-id">{program.descriptionId}</span>
									<span class="lang-en">{program.descriptionEn}</span>
								</p>
							</a>
						))
					}
				</div>

				<!-- ACTIVITY IMAGES -->
				<div class="reveal mt-16 flex items-end justify-between gap-6">
					<div>
						<p class="section-label">
							<span class="lang-id">NOVA dalam Kegiatan</span>
							<span class="lang-en">Learning at NOVA</span>
						</p>
						<h3 class="mt-3 text-3xl font-extrabold text-[#1d2f5c]">
							<span class="lang-id">Belajar lebih mudah dibayangkan ketika bisa melihat kegiatannya.</span>
							<span class="lang-en">See what learning can look like at NOVA.</span>
						</h3>
					</div>
				</div>

				<div class="mt-8 grid gap-5 md:grid-cols-2">
					{
						activities.map((activity) => (
							<a href={activity.href} class="activity-card reveal group relative min-h-[330px] overflow-hidden">
								<img
									src={activity.image}
									alt={activity.titleEn}
									class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-[#1d2f5c]/90 via-[#1d2f5c]/18 to-transparent"></div>
								<div class="absolute bottom-0 left-0 right-0 p-6 text-white">
									<h4 class="text-2xl font-extrabold">
										<span class="lang-id">{activity.titleId}</span>
										<span class="lang-en">{activity.titleEn}</span>
									</h4>
									<p class="mt-2 max-w-md text-sm leading-6 text-white/80">
										<span class="lang-id">{activity.descriptionId}</span>
										<span class="lang-en">{activity.descriptionEn}</span>
									</p>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<!-- WHY NOVA -->
		<section class="bg-[#1d2f5c] py-24 text-white">
			<div class="mx-auto grid max-w-7xl items-center gap-14 px-6 lg:grid-cols-2 lg:px-8">
				<div class="reveal">
					<p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#f3bc34]">
						<span class="lang-id">Mengapa NOVA?</span>
						<span class="lang-en">Why NOVA?</span>
					</p>

					<h2 class="mt-4 max-w-xl text-4xl font-extrabold tracking-[-0.03em] md:text-5xl">
						<span class="lang-id">Bukan sekadar tambahan pelajaran.</span>
						<span class="lang-en">More than extra lessons.</span>
					</h2>

					<p class="mt-6 max-w-xl text-lg leading-8 text-white/75">
						<span class="lang-id">
							Kami membantu siswa memahami cara belajar, membangun kebiasaan yang sehat, dan mengembangkan kepercayaan diri secara bertahap.
						</span>
						<span class="lang-en">
							We help students understand how they learn, build positive learning habits and develop confidence step by step.
						</span>
					</p>

					<a href="/about" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-[#f3bc34] px-7 py-4 font-bold text-[#1d2f5c] transition hover:-translate-y-0.5">
