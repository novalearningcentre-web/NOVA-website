---
import Layout from '../layouts/Layout.astro';

const studentCount = 0;

type Statistic = {
	value: string;
	labelId: string;
	labelEn: string;
};

type Program = {
	number: string;
	titleId: string;
	titleEn: string;
	descriptionId: string;
	descriptionEn: string;
	labelId: string;
	labelEn: string;
	href: string;
};

type Activity = {
	titleId: string;
	titleEn: string;
	descriptionId: string;
	descriptionEn: string;
	image: string;
	href: string;
};

type Teacher = {
	initials: string;
	name: string;
	photo?: string;
	credentials: string;
	subjects: string[];
	quoteId: string;
	quoteEn: string;
};

type Testimonial = {
	quoteId: string;
	quoteEn: string;
	name: string;
	relationId: string;
	relationEn: string;
	programId: string;
	programEn: string;
	rating: number;
	photo?: string;
	demo?: boolean;
};


const statistics: Statistic[] =
	studentCount > 0
		? [
				{
					value: `${studentCount}+`,
					labelId: 'Siswa telah bergabung',
					labelEn: 'Students have joined',
				},
				{
					value: '4+',
					labelId: 'Jenjang pendidikan',
					labelEn: 'Education levels',
				},
				{
					value: 'Small Group',
					labelId: 'Kelas lebih terarah',
					labelEn: 'More focused learning',
				},
				{
					value: 'Onsite & Online',
					labelId: 'Pilihan pembelajaran',
					labelEn: 'Flexible learning options',
				},
			]
		: [
				{
					value: 'Angkatan 1',
					labelId: 'Pendaftaran segera dibuka',
					labelEn: 'Enrolment opening soon',
				},
				{
					value: '4+',
					labelId: 'Jenjang pendidikan',
					labelEn: 'Education levels',
				},
				{
					value: 'Small Group',
					labelId: 'Kelas lebih terarah',
					labelEn: 'More focused learning',
				},
				{
					value: 'Onsite & Online',
					labelId: 'Pilihan pembelajaran',
					labelEn: 'Flexible learning options',
				},
			];

const programs: Program[] = [
	{
		number: '01',
		titleId: 'Early Learners',
		titleEn: 'Early Learners',
		descriptionId:
			'Program eksploratif untuk PAUD dan TK melalui aktivitas bermain, bergerak, berkomunikasi, dan belajar.',
