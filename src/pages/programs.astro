---
import Layout from '../layouts/Layout.astro';

type Program = {
	id: string;
	titleId: string;
	titleEn: string;
	categoryId: string;
	categoryEn: string;
	descriptionId: string;
	descriptionEn: string;
	image: string;
	status?: 'waitlist';
};

type Rhythm = {
	id: string;
	name: string;
	frequencyId: string;
	frequencyEn: string;
	price: string;
	noteId: string;
	noteEn: string;
};

type ClassFormat = {
	id: string;
	title: string;
	metaId: string;
	metaEn: string;
	descriptionId: string;
	descriptionEn: string;
};

const programs: Program[] = [
	{
		id: 'national',
		titleId: 'Kurikulum Nasional',
		titleEn: 'National Curriculum',
		categoryId: 'Akademik',
		categoryEn: 'Academic',
		descriptionId:
			'Pendampingan akademik dari PAUD–TK, SD, SMP hingga SMA untuk mendukung pelajaran sekolah dan perkembangan belajar yang konsisten.',
		descriptionEn:
			'Academic support from early years through primary and secondary school to strengthen school learning and consistent progress.',
		image: '/images/program-academic-class.png',
	},
	{
		id: 'international',
		titleId: 'International Curriculum',
		titleEn: 'International Curriculum',
		categoryId: 'Akademik',
		categoryEn: 'Academic',
		descriptionId:
			'Pendampingan untuk International Early Years, Cambridge Primary, Lower Secondary, IGCSE, A Level, dan IB DP.',
		descriptionEn:
			'Support for International Early Years, Cambridge Primary, Lower Secondary, IGCSE, A Level and IB DP.',
		image: '/images/program-academic-class.png',
	},
	{
		id: 'coding',
		titleId: 'Coding & Digital',
		titleEn: 'Coding & Digital',
		categoryId: 'Teknologi',
		categoryEn: 'Technology',
		descriptionId:
			'Creative coding, game & animation, Python, web, app, data, dan AI sesuai tahap perkembangan siswa.',
		descriptionEn:
			'Creative coding, game and animation, Python, web, apps, data and AI matched to each student’s stage of development.',
		image: '/images/program-coding-robotics.png',
	},
	{
		id: 'robotics',
		titleId: 'Robotics & Engineering',
		titleEn: 'Robotics & Engineering',
		categoryId: 'Teknologi',
		categoryEn: 'Technology',
		descriptionId:
			'Robotics, engineering, IoT, dan project-based learning melalui kegiatan membangun, menguji, dan memecahkan masalah.',
		descriptionEn:
			'Robotics, engineering, IoT and project-based learning through building, testing and problem-solving.',
		image: '/images/program-coding-robotics.png',
	},
	{
		id: 'sensory',
		titleId: 'Sensory Class',
		titleEn: 'Sensory Class',
		categoryId: 'PAUD / Early Years',
		categoryEn: 'Early Years',
		descriptionId:
			'Kelas bermain terarah untuk mengembangkan eksplorasi sensorik, motorik, bahasa, fokus, dan interaksi anak usia dini.',
		descriptionEn:
			'Guided play supporting sensory exploration, motor skills, language, focus and interaction in early childhood.',
		image: '/images/program-sensory-class.png',
	},
	{
		id: 'art',
		titleId: 'Creative Art & Drawing',
		titleEn: 'Creative Art & Drawing',
		categoryId: 'Kreatif',
		categoryEn: 'Creative',
		descriptionId:
			'Eksplorasi warna, bentuk, drawing, illustration, dan kreativitas hingga portfolio sesuai jenjang siswa.',
		descriptionEn:
			'Explore colour, form, drawing, illustration and creativity through to portfolio work, depending on level.',
		image: '/images/program-drawing-art.png',
	},
	{
		id: 'mandarin',
		titleId: 'Mandarin Studio',
		titleEn: 'Mandarin Studio',
		categoryId: 'Coming Soon',
		categoryEn: 'Coming Soon',
		descriptionId:
			'Program Mandarin sedang dalam tahap pengembangan. Daftarkan minat untuk mendapat informasi saat kelas tersedia.',
		descriptionEn:
			'Our Mandarin program is in development. Register your interest to receive updates when classes become available.',
		image: '/images/program-academic-class.png',
		status: 'waitlist',
	},
];

const rhythms: Rhythm[] = [
	{
		id: 'explore',
		name: 'Explore',
		frequencyId: '1× per minggu · 4 sesi / bulan',
		frequencyEn: '1× per week · 4 sessions / month',
		price: 'Rp125.000 / sesi',
		noteId: 'Untuk ritme belajar yang lebih ringan.',
		noteEn: 'For a lighter learning rhythm.',
	},
	{
		id: 'grow',
		name: 'Grow',
		frequencyId: '2× per minggu · 8 sesi / bulan',
		frequencyEn: '2× per week · 8 sessions / month',
		price: 'Rp100.000 / sesi',
		noteId: 'Pilihan paling seimbang dan konsisten.',
		noteEn: 'Our most balanced and consistent option.',
	},
	{
		id: 'accelerate',
		name: 'Accelerate',
		frequencyId: '3× per minggu · 12 sesi / bulan',
		frequencyEn: '3× per week · 12 sessions / month',
		price: 'Rp83.000 / sesi',
		noteId: 'Untuk target belajar yang lebih intensif.',
		noteEn: 'For more intensive learning goals.',
	},
];

const formats: ClassFormat[] = [
	{
		id: 'regular',
		title: 'Regular / Small Cohort',
		metaId: 'Kelompok kecil',
		metaEn: 'Small cohort',
		descriptionId:
			'Belajar bersama beberapa siswa dengan interaksi aktif dan biaya yang lebih efisien.',
		descriptionEn:
			'Learn in a small group with active interaction and a more accessible fee structure.',
	},
	{
		id: 'semi-private',
		title: 'Semi-Private',
		metaId: '2–3 siswa',
		metaEn: '2–3 students',
		descriptionId:
			'Pendampingan lebih dekat, tetapi tetap memiliki partner belajar.',
		descriptionEn:
			'Closer support while still learning alongside one or two peers.',
	},
	{
		id: 'private',
		title: 'Private',
		metaId: '1 siswa',
		metaEn: '1 student',
		descriptionId:
			'Pendampingan 1-on-1 dengan fokus penuh pada kebutuhan dan target siswa.',
		descriptionEn:
			'One-to-one support focused entirely on the student’s needs and goals.',
	},
];

const whatsappNumber = '6285195511236';
---

<Layout
	title="Program | NOVA Learning Centre"
	description="Jelajahi program akademik, coding, robotics, sensory class, art, dan pilihan kelas NOVA Learning Centre."
>
	<main class="overflow-hidden">
		<!-- HERO -->
		<section class="bg-[#1d2f5c] text-white">
			<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
				<div class="grid gap-10 lg:grid-cols-[1fr_0.75fr] lg:items-end">
					<div>
						<p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#f3bc34]">
							<span class="lang-id">Program NOVA</span>
							<span class="lang-en">NOVA Programs</span>
						</p>

						<h1 class="mt-5 max-w-4xl text-5xl font-extrabold leading-[1.03] tracking-[-0.05em] sm:text-6xl lg:text-[70px]">
							<span class="lang-id">
								Temukan kelas yang paling
								<span class="block text-[#f3bc34]">sesuai untuk anak.</span>
							</span>

							<span class="lang-en">
								Find the right class
								<span class="block text-[#f3bc34]">for your child.</span>
							</span>
						</h1>
					</div>

					<div>
						<p class="text-lg leading-8 text-white/75">
							<span class="lang-id">
								Tidak perlu menentukan semuanya sekarang. Lihat program yang tersedia,
								lalu klik <strong class="text-white">“Tanya Program Ini”</strong>.
								Tim NOVA akan membantu menentukan pilihan yang sesuai.
							</span>

							<span class="lang-en">
								You do not need to decide everything now. Browse the programs,
								then select <strong class="text-white">“Enquire About This Program”</strong>.
								The NOVA team can help recommend the best option.
							</span>
						</p>

						<a href="#program-list" class="mt-7 inline-flex bg-[#f3bc34] px-6 py-3.5 font-extrabold text-[#1d2f5c] transition hover:-translate-y-0.5">
							<span class="lang-id">Lihat Program</span>
							<span class="lang-en">Browse Programs</span>
							<span class="ml-2">↓</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- PROGRAMS -->
		<section id="program-list" class="scroll-mt-28 bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-3xl">
					<p class="section-label">
						<span class="lang-id">Program yang Tersedia</span>
						<span class="lang-en">Available Programs</span>
					</p>

					<h2 class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl">
						<span class="lang-id">Mulai dari minat atau kebutuhan anak.</span>
						<span class="lang-en">Start with your child’s interests or needs.</span>
					</h2>

					<p class="mt-5 max-w-2xl text-base leading-7 text-slate-600">
						<span class="lang-id">
							Klik program yang menarik. Pilihan akan otomatis dimasukkan ke form di bawah.
						</span>
						<span class="lang-en">
							Choose any program that interests you. It will be added automatically to the enquiry form below.
						</span>
					</p>
				</div>

				<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{
						programs.map((program) => (
							<article class="program-card group overflow-hidden border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-[#f3bc34] hover:shadow-xl">
								<div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
									<img
										src={program.image}
										alt={program.titleEn}
										class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
										loading="lazy"
									/>

									<div class="absolute inset-0 bg-gradient-to-t from-[#1d2f5c]/45 via-transparent to-transparent"></div>

									<span class="absolute left-4 top-4 bg-white px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-[0.14em] text-[#1d2f5c]">
										<span class="lang-id">{program.categoryId}</span>
										<span class="lang-en">{program.categoryEn}</span>
									</span>
								</div>

								<div class="p-6">
									<h3 class="text-xl font-extrabold text-[#1d2f5c]">
										<span class="lang-id">{program.titleId}</span>
										<span class="lang-en">{program.titleEn}</span>
									</h3>

									<p class="mt-3 min-h-[84px] text-sm leading-7 text-slate-500">
										<span class="lang-id">{program.descriptionId}</span>
										<span class="lang-en">{program.descriptionEn}</span>
									</p>

									<button
										type="button"
										data-program-choice={program.id}
										data-program-id={program.titleId}
										data-program-en={program.titleEn}
										data-program-status={program.status ?? 'active'}
										class:list={[
											'mt-5 inline-flex w-full items-center justify-center px-5 py-3.5 text-sm font-extrabold transition',
											program.status === 'waitlist'
												? 'border border-[#1d2f5c] bg-white text-[#1d2f5c] hover:bg-[#1d2f5c] hover:text-white'
												: 'bg-[#f3bc34] text-[#1d2f5c] hover:bg-[#1d2f5c] hover:text-white',
										]}
									>
										{program.status === 'waitlist' ? (
											<>
												<span class="lang-id">Daftar Minat</span>
												<span class="lang-en">Register Interest</span>
											</>
										) : (
											<>
												<span class="lang-id">Tanya Program Ini</span>
												<span class="lang-en">Enquire About This Program</span>
											</>
										)}
									</button>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- QUICK GUIDANCE -->
		<section class="bg-[#f7f8fc] py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr]">
					<div>
						<p class="section-label">
							<span class="lang-id">Pilihan Belajar</span>
							<span class="lang-en">Learning Options</span>
						</p>

						<h2 class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl">
							<span class="lang-id">Tidak yakin harus pilih yang mana?</span>
							<span class="lang-en">Not sure which option to choose?</span>
						</h2>

						<p class="mt-5 max-w-md text-base leading-7 text-slate-600">
							<span class="lang-id">
								Bagian ini hanya untuk gambaran. Anda tidak wajib memilih sekarang.
								Tim NOVA dapat merekomendasikan ritme dan format kelas setelah mengetahui kebutuhan anak.
							</span>

							<span class="lang-en">
								This section is only a guide. You do not need to choose now.
								The NOVA team can recommend a rhythm and class format after understanding your child’s needs.
							</span>
						</p>
					</div>

					<div class="space-y-10">
						<div>
							<div class="flex items-end justify-between gap-5">
								<h3 class="text-2xl font-extrabold text-[#1d2f5c]">
									<span class="lang-id">Ritme Belajar</span>
									<span class="lang-en">Learning Rhythm</span>
								</h3>
								<p class="text-xs text-slate-400">
									<span class="lang-id">Harga rata-rata per sesi</span>
									<span class="lang-en">Indicative average per session</span>
								</p>
							</div>

							<div class="mt-5 grid gap-4 md:grid-cols-3">
								{
									rhythms.map((rhythm) => (
										<button
											type="button"
											data-rhythm-choice={rhythm.name}
											class="choice-card border border-slate-200 bg-white p-5 text-left transition hover:-translate-y-1 hover:border-[#f3bc34] hover:shadow-lg"
										>
											<div class="flex items-center justify-between gap-3">
												<h4 class="text-xl font-extrabold text-[#1d2f5c]">{rhythm.name}</h4>
												<span class="choice-check hidden h-7 w-7 items-center justify-center rounded-full bg-[#f3bc34] text-sm font-black text-[#1d2f5c]">✓</span>
											</div>

											<p class="mt-3 text-sm font-semibold text-slate-500">
												<span class="lang-id">{rhythm.frequencyId}</span>
												<span class="lang-en">{rhythm.frequencyEn}</span>
											</p>

											<p class="mt-5 text-lg font-extrabold text-[#1d2f5c]">
												{rhythm.price}
											</p>

											<p class="mt-2 text-xs leading-5 text-slate-400">
												<span class="lang-id">{rhythm.noteId}</span>
												<span class="lang-en">{rhythm.noteEn}</span>
											</p>
										</button>
									))
								}
							</div>
						</div>

						<div>
							<h3 class="text-2xl font-extrabold text-[#1d2f5c]">
								<span class="lang-id">Format Kelas</span>
								<span class="lang-en">Class Format</span>
							</h3>

							<div class="mt-5 grid gap-4 md:grid-cols-3">
								{
									formats.map((format) => (
										<button
											type="button"
											data-format-choice={format.title}
											class="choice-card border border-slate-200 bg-white p-5 text-left transition hover:-translate-y-1 hover:border-[#f3bc34] hover:shadow-lg"
										>
											<div class="flex items-start justify-between gap-3">
												<div>
													<p class="text-[10px] font-extrabold uppercase tracking-[0.14em] text-slate-400">
														<span class="lang-id">{format.metaId}</span>
														<span class="lang-en">{format.metaEn}</span>
													</p>

													<h4 class="mt-2 text-lg font-extrabold text-[#1d2f5c]">
														{format.title}
													</h4>
												</div>

												<span class="choice-check hidden h-7 w-7 items-center justify-center rounded-full bg-[#f3bc34] text-sm font-black text-[#1d2f5c]">✓</span>
											</div>

											<p class="mt-4 text-xs leading-6 text-slate-500">
												<span class="lang-id">{format.descriptionId}</span>
												<span class="lang-en">{format.descriptionEn}</span>
											</p>
										</button>
									))
								}
							</div>
						</div>

						<p class="border-l-4 border-[#f3bc34] bg-white px-5 py-4 text-xs leading-6 text-slate-500">
							<span class="lang-id">
								*Harga dapat berbeda berdasarkan program, usia, kurikulum, durasi sesi, dan format kelas.
							</span>
							<span class="lang-en">
								*Final pricing may vary depending on program, age group, curriculum, session duration and class format.
							</span>
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- SIMPLE ENQUIRY -->
		<section id="enquiry" class="scroll-mt-28 bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr]">
					<div>
						<p class="section-label">
							<span class="lang-id">Konsultasi Program</span>
							<span class="lang-en">Program Enquiry</span>
						</p>

						<h2 class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl">
							<span class="lang-id">Kami bantu pilihkan yang paling sesuai.</span>
							<span class="lang-en">We can help you choose the right option.</span>
						</h2>

						<p class="mt-5 max-w-md text-base leading-7 text-slate-600">
							<span class="lang-id">
								Cukup isi informasi dasar. Ritme belajar dan format kelas boleh dikosongkan jika masih belum yakin.
							</span>
							<span class="lang-en">
								Simply provide the basic details. Learning rhythm and class format can be left blank if you are still unsure.
							</span>
						</p>

						<div class="mt-8 bg-[#1d2f5c] p-5 text-white">
							<p class="text-sm font-extrabold text-[#f3bc34]">
								<span class="lang-id">Pilihan Anda</span>
								<span class="lang-en">Your Selection</span>
							</p>

							<div class="mt-4 space-y-2 text-sm text-white/75">
								<p>
									<span class="font-semibold text-white">
										<span class="lang-id">Program:</span>
										<span class="lang-en">Program:</span>
									</span>
									<span id="summary-program"> Belum dipilih</span>
								</p>

								<p>
									<span class="font-semibold text-white">
										<span class="lang-id">Ritme:</span>
										<span class="lang-en">Rhythm:</span>
									</span>
									<span id="summary-rhythm"> Belum dipilih</span>
								</p>

								<p>
									<span class="font-semibold text-white">
										<span class="lang-id">Format:</span>
										<span class="lang-en">Format:</span>
									</span>
									<span id="summary-format"> Belum dipilih</span>
								</p>
							</div>
						</div>
					</div>

					<div class="border border-slate-200 bg-[#f7f8fc] p-6 md:p-8">
						<div class="grid gap-5 sm:grid-cols-2">
							<label class="block sm:col-span-2">
								<span class="form-label">
									<span class="lang-id">Yang ingin dilakukan</span>
									<span class="lang-en">I would like to</span>
								</span>

								<select id="request-type" class="form-input">
									<option value="quotation">Request Quotation</option>
									<option value="trial">Daftar Kelas</option>
									<option value="recommendation">Minta Rekomendasi Program / Ask for a Recommendation</option>
							
								</select>
							</label>

							<label class="block">
								<span class="form-label">
									<span class="lang-id">Program</span>
									<span class="lang-en">Program</span>
								</span>

								<select id="program-select" class="form-input">
									<option value="">Belum yakin / Not sure yet</option>
									{programs.map((program) => (
										<option value={program.titleId}>
											{program.titleId}
										</option>
									))}
								</select>
							</label>

							<label class="block">
								<span class="form-label">
									<span class="lang-id">Jenjang / Usia Anak</span>
									<span class="lang-en">Student Level / Age</span>
								</span>

								<input
									id="student-level"
									type="text"
									class="form-input"
									placeholder="Contoh: Grade 5 / 10 tahun"
								/>
							</label>

							<label class="block">
								<span class="form-label">
									<span class="lang-id">Ritme Belajar (Opsional)</span>
									<span class="lang-en">Learning Rhythm (Optional)</span>
								</span>

								<select id="rhythm-select" class="form-input">
									<option value="">Belum yakin / Not sure yet</option>
									{rhythms.map((rhythm) => (
										<option value={rhythm.name}>{rhythm.name}</option>
									))}
								</select>
							</label>

							<label class="block">
								<span class="form-label">
									<span class="lang-id">Format Kelas (Opsional)</span>
									<span class="lang-en">Class Format (Optional)</span>
								</span>

								<select id="format-select" class="form-input">
									<option value="">Belum yakin / Not sure yet</option>
									{formats.map((format) => (
										<option value={format.title}>{format.title}</option>
									))}
								</select>
							</label>

							<label class="block">
								<span class="form-label">
									<span class="lang-id">Nama Orang Tua</span>
									<span class="lang-en">Parent Name</span>
								</span>

								<input id="parent-name" type="text" class="form-input" placeholder="Nama" />
							</label>

							<label class="block">
								<span class="form-label">
									<span class="lang-id">Nomor WhatsApp</span>
									<span class="lang-en">WhatsApp Number</span>
								</span>

								<input id="phone-number" type="tel" class="form-input" placeholder="08..." />
							</label>

							<label class="block sm:col-span-2">
								<span class="form-label">
									<span class="lang-id">Kebutuhan / Catatan (Opsional)</span>
									<span class="lang-en">Learning Needs / Notes (Optional)</span>
								</span>

								<textarea
									id="notes"
									rows="4"
									class="form-input resize-none"
									placeholder="Ceritakan sedikit kebutuhan belajar anak..."
								></textarea>
							</label>
						</div>

						<button
							id="submit-enquiry"
							type="button"
							class="mt-6 inline-flex w-full items-center justify-center bg-[#f3bc34] px-6 py-4 font-extrabold text-[#1d2f5c] transition hover:bg-[#1d2f5c] hover:text-white"
						>
							<span class="lang-id">Lanjutkan via WhatsApp</span>
							<span class="lang-en">Continue on WhatsApp</span>
							<span class="ml-2">→</span>
						</button>

						<p class="mt-4 text-center text-xs leading-5 text-slate-400">
							<span class="lang-id">
								Tidak ada pembayaran pada tahap ini. Tim NOVA akan mengonfirmasi program, jadwal, dan biaya terlebih dahulu.
							</span>

							<span class="lang-en">
								No payment is required at this stage. The NOVA team will confirm the program, schedule and fees first.
							</span>
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- MOBILE QUICK CTA -->
		<a
			href="#enquiry"
			class="fixed bottom-4 left-4 right-4 z-40 flex items-center justify-center bg-[#f3bc34] px-5 py-4 text-center text-sm font-extrabold text-[#1d2f5c] shadow-2xl lg:hidden"
		>
			<span class="lang-id">Minta Rekomendasi Program</span>
			<span class="lang-en">Ask for a Program Recommendation</span>
		</a>
	</main>
</Layout>

<script>
	const whatsappNumber = '6285195511236';

	const programButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-program-choice]'),
	);
	const rhythmButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-rhythm-choice]'),
	);
	const formatButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-format-choice]'),
	);

	const programSelect =
		document.querySelector<HTMLSelectElement>('#program-select');
	const rhythmSelect =
		document.querySelector<HTMLSelectElement>('#rhythm-select');
	const formatSelect =
		document.querySelector<HTMLSelectElement>('#format-select');
	const requestType =
		document.querySelector<HTMLSelectElement>('#request-type');

	const summaryProgram =
		document.querySelector<HTMLElement>('#summary-program');
	const summaryRhythm =
		document.querySelector<HTMLElement>('#summary-rhythm');
	const summaryFormat =
		document.querySelector<HTMLElement>('#summary-format');

	const updateSummary = () => {
		if (summaryProgram) {
			summaryProgram.textContent =
				programSelect?.value || ' Belum dipilih';
		}

		if (summaryRhythm) {
			summaryRhythm.textContent =
				rhythmSelect?.value || ' Belum dipilih';
		}

		if (summaryFormat) {
			summaryFormat.textContent =
				formatSelect?.value || ' Belum dipilih';
		}
	};

	const scrollToEnquiry = () => {
		document
			.querySelector('#enquiry')
			?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	};

	programButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const program =
				button.dataset.programId ?? '';
			const status =
				button.dataset.programStatus ?? 'active';

			if (programSelect) {
				programSelect.value = program;
			}

			if (requestType && status === 'waitlist') {
				requestType.value = 'waitlist';
			}

			updateSummary();

			window.setTimeout(scrollToEnquiry, 80);
		});
	});

	const setChoiceState = (
		buttons: HTMLButtonElement[],
		activeButton: HTMLButtonElement,
	) => {
		buttons.forEach((button) => {
			const active = button === activeButton;
			button.classList.toggle('is-selected', active);

			const check =
				button.querySelector<HTMLElement>('.choice-check');

			check?.classList.toggle('hidden', !active);
			check?.classList.toggle('flex', active);
		});
	};

	rhythmButtons.forEach((button) => {
		button.addEventListener('click', () => {
			if (rhythmSelect) {
				rhythmSelect.value =
					button.dataset.rhythmChoice ?? '';
			}

			setChoiceState(rhythmButtons, button);
			updateSummary();
		});
	});

	formatButtons.forEach((button) => {
		button.addEventListener('click', () => {
			if (formatSelect) {
				formatSelect.value =
					button.dataset.formatChoice ?? '';
			}

			setChoiceState(formatButtons, button);
			updateSummary();
		});
	});

	programSelect?.addEventListener('change', updateSummary);
	rhythmSelect?.addEventListener('change', updateSummary);
	formatSelect?.addEventListener('change', updateSummary);

	const submitButton =
		document.querySelector<HTMLButtonElement>('#submit-enquiry');

	submitButton?.addEventListener('click', () => {
		const parentName =
			document.querySelector<HTMLInputElement>('#parent-name')?.value || '-';
		const phone =
			document.querySelector<HTMLInputElement>('#phone-number')?.value || '-';
		const level =
			document.querySelector<HTMLInputElement>('#student-level')?.value || '-';
		const notes =
			document.querySelector<HTMLTextAreaElement>('#notes')?.value || '-';

		const selectedProgram =
			programSelect?.value || 'Belum yakin / Not sure yet';
		const selectedRhythm =
			rhythmSelect?.value || 'Belum yakin / Not sure yet';
		const selectedFormat =
			formatSelect?.value || 'Belum yakin / Not sure yet';
		const selectedRequest =
			requestType?.value || 'quotation';

		const language =
			document.documentElement.dataset.lang === 'en' ? 'en' : 'id';

		const typeLabelId: Record<string, string> = {
			quotation: 'Request Quotation',
			trial: 'Trial Class',
			recommendation: 'Minta Rekomendasi Program',
			waitlist: 'Join Waitlist / Daftar Minat',
		};

		const typeLabelEn: Record<string, string> = {
			quotation: 'Request Quotation',
			trial: 'Trial Class',
			recommendation: 'Ask for a Program Recommendation',
			waitlist: 'Join Waitlist / Register Interest',
		};

		const messageId = [
			'Halo NOVA Learning Centre,',
			'',
			`Saya ingin: ${typeLabelId[selectedRequest] || selectedRequest}`,
			`Nama orang tua: ${parentName}`,
			`Nomor WhatsApp: ${phone}`,
			`Jenjang / usia anak: ${level}`,
			`Program: ${selectedProgram}`,
			`Ritme belajar: ${selectedRhythm}`,
			`Format kelas: ${selectedFormat}`,
			`Catatan: ${notes}`,
			'',
			'Mohon bantu rekomendasi program, jadwal, dan informasi biayanya. Terima kasih.',
		].join('\n');

		const messageEn = [
			'Hello NOVA Learning Centre,',
			'',
			`I would like to: ${typeLabelEn[selectedRequest] || selectedRequest}`,
			`Parent name: ${parentName}`,
			`WhatsApp number: ${phone}`,
			`Student level / age: ${level}`,
			`Program: ${selectedProgram}`,
			`Learning rhythm: ${selectedRhythm}`,
			`Class format: ${selectedFormat}`,
			`Notes: ${notes}`,
			'',
			'Please help recommend a suitable program, schedule and fee. Thank you.',
		].join('\n');

		const message =
			language === 'en' ? messageEn : messageId;

		window.open(
			`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`,
			'_blank',
			'noopener,noreferrer',
		);
	});

	updateSummary();
</script>

