		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: #1d2f5c;
	}

	.section-label::before {
		content: '';
		width: 2.2rem;
		height: 0.22rem;
		background: #f3bc34;
	}

	.choice-card.is-selected {
		border-color: #f3bc34;
		background: #fff9e8;
		box-shadow: 0 12px 30px rgba(29, 47, 92, 0.1);
	}

	.form-label {
		display: block;
		margin-bottom: 0.45rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #64748b;
	}

	.form-input {
		width: 100%;
