---
import Layout from '../layouts/Layout.astro';

type Facility = {
	src: string;
	titleId: string;
	titleEn: string;
	categoryId: string;
	categoryEn: string;
	descriptionId: string;
	descriptionEn: string;
};

const facilities: Facility[] = [
	{
		src: '/images/reception-area.jpeg',
		titleId: 'Reception Area',
		titleEn: 'Reception Area',
		categoryId: 'Area Utama',
		categoryEn: 'Main Area',
		descriptionId:
			'Area penerimaan yang nyaman untuk konsultasi, informasi program, dan komunikasi dengan orang tua.',
		descriptionEn:
			'A welcoming reception area for consultations, program information and parent communication.',
	},
	{
		src: '/images/main-classroom.jpeg',
		titleId: 'Main Classroom',
		titleEn: 'Main Classroom',
		categoryId: 'Academic',
		categoryEn: 'Academic',
		descriptionId:
			'Ruang belajar utama untuk small group class, diskusi, dan pembelajaran akademik yang terarah.',
		descriptionEn:
			'Our main learning space for small-group classes, discussion and focused academic learning.',
	},
	{
		src: '/images/small-group-classroom.jpeg',
		titleId: 'Small Group Classroom',
		titleEn: 'Small Group Classroom',
		categoryId: 'Academic',
		categoryEn: 'Academic',
		descriptionId:
			'Ruang yang mendukung interaksi lebih dekat antara pengajar dan siswa dalam kelompok kecil.',
		descriptionEn:
			'A learning space designed for closer interaction between teachers and students in small groups.',
	},
	{
		src: '/images/multimedia-classroom.png',
		titleId: 'Multimedia Classroom',
		titleEn: 'Multimedia Classroom',
		categoryId: 'Technology',
		categoryEn: 'Technology',
		descriptionId:
			'Ruang pembelajaran dengan dukungan multimedia untuk presentasi, digital learning, dan aktivitas interaktif.',
		descriptionEn:
			'A multimedia-enabled classroom for presentations, digital learning and interactive activities.',
	},
	{
		src: '/images/early-learners-classroom.jpeg',
		titleId: 'Early Learners Classroom',
		titleEn: 'Early Learners Classroom',
		categoryId: 'Early Years',
		categoryEn: 'Early Years',
		descriptionId:
			'Ruang yang dirancang untuk anak usia dini dengan suasana hangat, aman, dan mudah dieksplorasi.',
		descriptionEn:
			'A warm, safe and engaging learning environment designed for young children.',
	},
	{
		src: '/images/early-learners-activity-room.jpeg',
		titleId: 'Early Learners Activity Room',
		titleEn: 'Early Learners Activity Room',
		categoryId: 'Early Years',
		categoryEn: 'Early Years',
		descriptionId:
			'Area aktivitas untuk bermain terarah, kegiatan sensorik, motorik, kreativitas, dan interaksi sosial.',
		descriptionEn:
			'An activity space for guided play, sensory exploration, motor development, creativity and social interaction.',
	},
	{
		src: '/images/play-discovery-space.png',
		titleId: 'Play & Discovery Space',
		titleEn: 'Play & Discovery Space',
		categoryId: 'Early Years',
		categoryEn: 'Early Years',
		descriptionId:
			'Ruang eksplorasi yang memberi kesempatan anak untuk belajar melalui bermain, mencoba, dan menemukan.',
		descriptionEn:
			'A discovery space where children learn through play, exploration and hands-on experiences.',
	},
];

const featuredFacilities = [facilities[1], facilities[0]];
const galleryFacilities = [facilities[2], facilities[3], facilities[4], facilities[5], facilities[6]];

const whatsappUrl =
	'https://wa.me/6285195511236?text=Halo%20NOVA%20Learning%20Centre%2C%20saya%20ingin%20menjadwalkan%20kunjungan%20ke%20NOVA.';
---

<Layout
	title="Fasilitas | NOVA Learning Centre"
	description="Jelajahi ruang belajar dan fasilitas NOVA Learning Centre yang dirancang untuk small group learning, early years, technology, dan pembelajaran interaktif."
>
	<main class="overflow-hidden">
		<section class="relative bg-white">
			<div
				class="absolute -right-20 top-10 h-80 w-80 rounded-full bg-[#f3bc34]/16 blur-3xl"
				aria-hidden="true"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
				<div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
					<div>
						<p class="section-label">
							<span class="lang-id">Fasilitas NOVA</span>
							<span class="lang-en">NOVA Facilities</span>
						</p>

						<h1
							class="mt-5 max-w-4xl text-5xl font-extrabold leading-[1.03] tracking-[-0.05em] text-[#1d2f5c] sm:text-6xl lg:text-[70px]"
						>
							<span class="lang-id">
								Ruang yang membuat belajar terasa
								<span class="relative inline-block">
									lebih nyaman.
									<span
										class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/70"
										aria-hidden="true"
									></span>
								</span>
							</span>

							<span class="lang-en">
								A space where learning feels
								<span class="relative inline-block">
									more comfortable.
									<span
										class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/70"
										aria-hidden="true"
									></span>
								</span>
							</span>
						</h1>

						<p class="mt-7 max-w-xl text-lg leading-8 text-slate-600">
							<span class="lang-id">
								Setiap area NOVA dirancang untuk mendukung cara belajar yang
								berbeda — dari small group learning, pembelajaran individual,
								hingga aktivitas early years dan technology-based learning.
							</span>

							<span class="lang-en">
								Each NOVA space is designed to support different ways of learning
								— from small-group and individual learning to early-years
								activities and technology-enabled lessons.
							</span>
						</p>

						<a
							href="#gallery"
							class="mt-8 inline-flex bg-[#f3bc34] px-6 py-3.5 font-extrabold text-[#1d2f5c] transition hover:-translate-y-0.5 hover:shadow-lg"
						>
							<span class="lang-id">Lihat Fasilitas</span>
							<span class="lang-en">View Facilities</span>
							<span class="ml-2">↓</span>
						</a>
					</div>

					<div class="relative">
						<div class="absolute -bottom-5 -left-5 h-24 w-24 bg-[#f3bc34]" aria-hidden="true"></div>
						<div class="relative overflow-hidden bg-[#1d2f5c] p-3 shadow-[0_24px_60px_rgba(29,47,92,0.16)]">
							<img
								src="/images/main-classroom.jpeg"
								alt="NOVA Learning Centre classroom"
								class="h-[470px] w-full object-cover"
								fetchpriority="high"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="border-y border-slate-200 bg-[#f7f8fc]">
			<div class="mx-auto grid max-w-7xl gap-px bg-slate-200 md:grid-cols-4">
				<div class="bg-[#f7f8fc] px-6 py-7">
					<p class="text-sm font-extrabold text-[#1d2f5c]">Small Group</p>
					<p class="mt-2 text-sm leading-6 text-slate-500">
						<span class="lang-id">Interaksi lebih dekat dan terarah.</span>
						<span class="lang-en">Closer and more focused interaction.</span>
					</p>
				</div>

				<div class="bg-[#f7f8fc] px-6 py-7">
					<p class="text-sm font-extrabold text-[#1d2f5c]">Early Years</p>
					<p class="mt-2 text-sm leading-6 text-slate-500">
						<span class="lang-id">Ruang aman untuk bermain dan bereksplorasi.</span>
						<span class="lang-en">A safe space for play and exploration.</span>
					</p>
				</div>

				<div class="bg-[#f7f8fc] px-6 py-7">
					<p class="text-sm font-extrabold text-[#1d2f5c]">Multimedia</p>
					<p class="mt-2 text-sm leading-6 text-slate-500">
						<span class="lang-id">Dukungan teknologi untuk pembelajaran interaktif.</span>
						<span class="lang-en">Technology support for interactive learning.</span>
					</p>
				</div>

				<div class="bg-[#f7f8fc] px-6 py-7">
					<p class="text-sm font-extrabold text-[#1d2f5c]">Comfort & Focus</p>
					<p class="mt-2 text-sm leading-6 text-slate-500">
						<span class="lang-id">Suasana belajar yang nyaman dan minim distraksi.</span>
						<span class="lang-en">A comfortable environment with fewer distractions.</span>
					</p>
				</div>
			</div>
		</section>

		<section id="gallery" class="scroll-mt-28 bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-8 lg:grid-cols-[0.76fr_1.24fr] lg:items-end">
					<div>
						<p class="section-label">
							<span class="lang-id">Gallery Fasilitas</span>
							<span class="lang-en">Facilities Gallery</span>
						</p>

						<h2
							class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
						>
							<span class="lang-id">Lihat lebih dekat ruang belajar NOVA.</span>
							<span class="lang-en">Take a closer look at our learning spaces.</span>
						</h2>
					</div>

					<p class="max-w-xl text-base leading-7 text-slate-600 lg:justify-self-end">
						<span class="lang-id">
							Klik gambar untuk melihat ukuran lebih besar. Setiap ruang memiliki
							fungsi berbeda agar kegiatan belajar dapat disesuaikan dengan usia,
							jumlah siswa, dan jenis aktivitas.
						</span>

						<span class="lang-en">
							Select any image to view it in more detail. Each space serves a
							different purpose so learning can be matched to age group, class size
							and activity type.
						</span>
					</p>
				</div>

				<div class="mt-12 grid gap-6 lg:grid-cols-2">
					{
						featuredFacilities.map((facility) => {
							const index = facilities.findIndex((item) => item.src === facility.src);

							return (
								<button
									type="button"
									data-gallery-item
									data-index={index}
									data-src={facility.src}
									data-title-id={facility.titleId}
									data-title-en={facility.titleEn}
									data-description-id={facility.descriptionId}
									data-description-en={facility.descriptionEn}
									class="featured-facility group relative overflow-hidden bg-slate-100 text-left"
								>
									<img
										src={facility.src}
										alt={facility.titleEn}
										class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
										loading="eager"
									/>

									<div class="absolute inset-0 bg-gradient-to-t from-[#1d2f5c]/85 via-[#1d2f5c]/10 to-transparent"></div>

									<div class="absolute bottom-0 left-0 right-0 p-6 text-white">
										<p class="text-[10px] font-extrabold uppercase tracking-[0.15em] text-[#f3bc34]">
											<span class="lang-id">{facility.categoryId}</span>
											<span class="lang-en">{facility.categoryEn}</span>
										</p>

										<div class="mt-2 flex items-end justify-between gap-4">
											<div>
												<h3 class="text-2xl font-extrabold">
													<span class="lang-id">{facility.titleId}</span>
													<span class="lang-en">{facility.titleEn}</span>
												</h3>

												<p class="mt-2 max-w-md text-sm leading-6 text-white/75">
													<span class="lang-id">{facility.descriptionId}</span>
													<span class="lang-en">{facility.descriptionEn}</span>
												</p>
											</div>

											<span
												class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/95 text-lg font-bold text-[#1d2f5c] opacity-0 transition group-hover:opacity-100"
												aria-hidden="true"
											>
												+
											</span>
										</div>
									</div>
								</button>
							);
						})
					}
				</div>

				<div class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{
						galleryFacilities.map((facility) => {
							const index = facilities.findIndex((item) => item.src === facility.src);

							return (
								<button
									type="button"
									data-gallery-item
									data-index={index}
									data-src={facility.src}
									data-title-id={facility.titleId}
									data-title-en={facility.titleEn}
									data-description-id={facility.descriptionId}
									data-description-en={facility.descriptionEn}
									class="gallery-card group overflow-hidden border border-slate-200 bg-white text-left transition hover:-translate-y-1 hover:border-[#f3bc34] hover:shadow-xl"
								>
									<div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
										<img
											src={facility.src}
											alt={facility.titleEn}
											class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
											loading="lazy"
										/>

										<div class="absolute inset-0 bg-gradient-to-t from-[#1d2f5c]/55 via-transparent to-transparent"></div>
									</div>

									<div class="p-5">
										<p class="text-[10px] font-extrabold uppercase tracking-[0.15em] text-[#f3bc34]">
											<span class="lang-id">{facility.categoryId}</span>
											<span class="lang-en">{facility.categoryEn}</span>
										</p>

										<div class="mt-2 flex items-start justify-between gap-3">
											<div>
												<h3 class="text-lg font-extrabold text-[#1d2f5c]">
													<span class="lang-id">{facility.titleId}</span>
													<span class="lang-en">{facility.titleEn}</span>
												</h3>

												<p class="mt-2 text-sm leading-6 text-slate-500">
													<span class="lang-id">{facility.descriptionId}</span>
													<span class="lang-en">{facility.descriptionEn}</span>
												</p>
											</div>

											<span
												class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#f3bc34] text-sm font-bold text-[#1d2f5c]"
												aria-hidden="true"
											>
												+
											</span>
										</div>
									</div>
								</button>
							);
						})
					}
				</div>
			</div>
		</section>

		<section class="bg-[#1d2f5c] py-24 text-white">
			<div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
				<div>
					<p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#f3bc34]">
						<span class="lang-id">Mengapa Ruang Itu Penting?</span>
						<span class="lang-en">Why Does the Learning Space Matter?</span>
					</p>

					<h2
						class="mt-4 text-4xl font-extrabold tracking-[-0.035em] md:text-5xl"
					>
						<span class="lang-id">Lingkungan belajar ikut membentuk pengalaman anak.</span>
						<span class="lang-en">The learning environment shapes the student experience.</span>
					</h2>
				</div>

				<div class="grid gap-4 sm:grid-cols-2">
					<article class="border border-white/15 bg-white/[0.06] p-6">
						<div class="flex h-10 w-10 items-center justify-center bg-[#f3bc34] font-black text-[#1d2f5c]">
							01
						</div>
						<h3 class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Lebih Fokus</span>
							<span class="lang-en">Better Focus</span>
						</h3>
						<p class="mt-3 text-sm leading-7 text-white/70">
							<span class="lang-id">
								Ruang yang terstruktur membantu siswa lebih mudah berkonsentrasi
								dan mengikuti kegiatan belajar.
							</span>
							<span class="lang-en">
								A structured environment helps students focus and engage more
								effectively in learning.
							</span>
						</p>
					</article>

					<article class="border border-white/15 bg-white/[0.06] p-6">
						<div class="flex h-10 w-10 items-center justify-center bg-[#f3bc34] font-black text-[#1d2f5c]">
							02
						</div>
						<h3 class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Lebih Nyaman</span>
							<span class="lang-en">More Comfortable</span>
						</h3>
						<p class="mt-3 text-sm leading-7 text-white/70">
							<span class="lang-id">
								Suasana yang nyaman membantu siswa merasa lebih aman untuk bertanya,
								mencoba, dan melakukan kesalahan.
							</span>
							<span class="lang-en">
								A comfortable environment helps students feel safe to ask,
								experiment and make mistakes.
							</span>
						</p>
					</article>

					<article class="border border-white/15 bg-white/[0.06] p-6">
						<div class="flex h-10 w-10 items-center justify-center bg-[#f3bc34] font-black text-[#1d2f5c]">
							03
						</div>
						<h3 class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Sesuai Usia</span>
							<span class="lang-en">Age Appropriate</span>
						</h3>
						<p class="mt-3 text-sm leading-7 text-white/70">
							<span class="lang-id">
								Area early years dibuat berbeda dari classroom siswa yang lebih
								besar agar aktivitas lebih sesuai tahap perkembangan.
							</span>
							<span class="lang-en">
								Early-years spaces are designed differently from older student
								classrooms so activities better suit each stage of development.
							</span>
						</p>
					</article>

					<article class="border border-white/15 bg-white/[0.06] p-6">
						<div class="flex h-10 w-10 items-center justify-center bg-[#f3bc34] font-black text-[#1d2f5c]">
							04
						</div>
						<h3 class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Fleksibel</span>
							<span class="lang-en">Flexible</span>
						</h3>
						<p class="mt-3 text-sm leading-7 text-white/70">
							<span class="lang-id">
								Ruang dapat digunakan untuk diskusi, small group learning,
								technology activities, dan pembelajaran individual.
							</span>
							<span class="lang-en">
								Spaces can support discussion, small-group learning, technology
								activities and individual learning.
							</span>
						</p>
					</article>
				</div>
			</div>
		</section>

		<section class="bg-[#f7f8fc] py-24">
			<div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[0.78fr_1.22fr] lg:items-center lg:px-8">
				<div>
					<p class="section-label">
						<span class="lang-id">Video Tour</span>
						<span class="lang-en">Video Tour</span>
					</p>

					<h2
						class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
					>
						<span class="lang-id">Ingin melihat suasana NOVA lebih lengkap?</span>
						<span class="lang-en">Want to see more of the NOVA learning environment?</span>
					</h2>

					<p class="mt-5 max-w-lg text-base leading-7 text-slate-600">
						<span class="lang-id">
							Video tour asli NOVA akan ditambahkan setelah dokumentasi ruang dan
							kegiatan tersedia. Area ini sudah disiapkan agar video dapat langsung
							dimasukkan tanpa mengubah layout halaman.
						</span>

						<span class="lang-en">
							An original NOVA video tour will be added once footage of the learning
							centre and activities is available. This section is already prepared
							so the video can be added without redesigning the page.
						</span>
					</p>
				</div>

				<div class="relative overflow-hidden bg-[#1d2f5c]">
					<img
						src="/images/multimedia-classroom.png"
						alt="NOVA multimedia learning space"
						class="aspect-video w-full object-cover opacity-55"
						loading="lazy"
					/>

					<div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center text-white">
						<div
							class="flex h-16 w-16 items-center justify-center rounded-full bg-[#f3bc34] text-xl font-black text-[#1d2f5c]"
						>
							▶
						</div>

						<p class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Video Tour Segera Hadir</span>
							<span class="lang-en">Video Tour Coming Soon</span>
						</p>

						<p class="mt-2 max-w-md text-sm leading-6 text-white/70">
							<span class="lang-id">Dokumentasi asli kelas dan area NOVA.</span>
							<span class="lang-en">Original footage of NOVA classrooms and facilities.</span>
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-[#f3bc34] py-20">
			<div class="mx-auto max-w-4xl px-6 text-center">
				<p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#1d2f5c]/60">
					<span class="lang-id">Kunjungi NOVA</span>
					<span class="lang-en">Visit NOVA</span>
				</p>

				<h2
					class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
				>
					<span class="lang-id">Lihat langsung ruang belajar kami.</span>
					<span class="lang-en">See our learning spaces in person.</span>
				</h2>

				<p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-[#1d2f5c]/70">
					<span class="lang-id">
						Hubungi tim NOVA untuk menjadwalkan kunjungan dan melihat fasilitas
						yang sesuai dengan kebutuhan belajar anak.
					</span>

					<span class="lang-en">
						Contact the NOVA team to arrange a visit and explore the facilities that
						best suit your child's learning needs.
					</span>
				</p>

				<a
					href={whatsappUrl}
					target="_blank"
					rel="noreferrer"
					class="mt-8 inline-flex bg-[#1d2f5c] px-8 py-4 font-extrabold text-white transition hover:-translate-y-0.5 hover:shadow-xl"
				>
					<span class="lang-id">Jadwalkan Kunjungan via WhatsApp</span>
					<span class="lang-en">Arrange a Visit on WhatsApp</span>
				</a>
			</div>
		</section>
	</main>

	<div
		id="gallery-lightbox"
		class="fixed inset-0 z-[100] hidden items-center justify-center bg-[#0b1730]/95 p-4 md:p-8"
		role="dialog"
		aria-modal="true"
		aria-label="Facility image"
	>
		<button
			id="lightbox-close"
			type="button"
			class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center rounded-full bg-white text-xl font-bold text-[#1d2f5c] transition hover:bg-[#f3bc34]"
			aria-label="Close image"
		>
			×
		</button>

		<button
			id="lightbox-prev"
			type="button"
			class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 text-xl font-bold text-[#1d2f5c] transition hover:bg-[#f3bc34] md:left-6"
			aria-label="Previous image"
		>
			←
		</button>

		<div class="mx-auto grid max-h-[90vh] w-full max-w-6xl overflow-hidden bg-white lg:grid-cols-[1.35fr_0.65fr]">
			<div class="min-h-0 bg-black">
				<img
					id="lightbox-image"
					src=""
					alt=""
					class="h-full max-h-[78vh] w-full object-contain"
				/>
			</div>

			<div class="flex flex-col justify-center p-7 md:p-9">
				<p class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#f3bc34]">
					NOVA Learning Centre
				</p>

				<h3 id="lightbox-title-id" class="lang-id mt-3 text-2xl font-extrabold text-[#1d2f5c]"></h3>
				<h3 id="lightbox-title-en" class="lang-en mt-3 text-2xl font-extrabold text-[#1d2f5c]"></h3>

				<p id="lightbox-description-id" class="lang-id mt-4 text-sm leading-7 text-slate-600"></p>
				<p id="lightbox-description-en" class="lang-en mt-4 text-sm leading-7 text-slate-600"></p>
			</div>
		</div>

		<button
			id="lightbox-next"
			type="button"
			class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 text-xl font-bold text-[#1d2f5c] transition hover:bg-[#f3bc34] md:right-6"
			aria-label="Next image"
		>
			→
		</button>
	</div>
</Layout>

<script>
	const galleryItems = Array.from(
		document.querySelectorAll('[data-gallery-item]'),
	);

	const lightbox =
		document.querySelector('#gallery-lightbox');
	const lightboxImage =
		document.querySelector('#lightbox-image');
	const lightboxTitleId =
		document.querySelector('#lightbox-title-id');
	const lightboxTitleEn =
		document.querySelector('#lightbox-title-en');
	const lightboxDescriptionId =
		document.querySelector('#lightbox-description-id');
	const lightboxDescriptionEn =
		document.querySelector('#lightbox-description-en');

	const closeButton =
		document.querySelector('#lightbox-close');
	const previousButton =
		document.querySelector('#lightbox-prev');
	const nextButton =
		document.querySelector('#lightbox-next');

	let activeIndex = 0;

	const showImage = (index) => {
		if (galleryItems.length === 0) return;

		activeIndex =
			(index + galleryItems.length) % galleryItems.length;

		const item = galleryItems[activeIndex];

		if (lightboxImage) {
			lightboxImage.src = item.dataset.src ?? '';
			lightboxImage.alt =
				item.dataset.titleEn ?? 'NOVA facility';
		}

		if (lightboxTitleId) {
			lightboxTitleId.textContent =
				item.dataset.titleId ?? '';
		}

		if (lightboxTitleEn) {
			lightboxTitleEn.textContent =
				item.dataset.titleEn ?? '';
		}

		if (lightboxDescriptionId) {
			lightboxDescriptionId.textContent =
				item.dataset.descriptionId ?? '';
		}

		if (lightboxDescriptionEn) {
			lightboxDescriptionEn.textContent =
				item.dataset.descriptionEn ?? '';
		}
	};

	const openLightbox = (index) => {
		showImage(index);

		lightbox?.classList.remove('hidden');
		lightbox?.classList.add('flex');

		document.body.style.overflow = 'hidden';
		closeButton?.focus();
	};

	const closeLightbox = () => {
		lightbox?.classList.add('hidden');
		lightbox?.classList.remove('flex');

		document.body.style.overflow = '';
	};

	galleryItems.forEach((item, index) => {
		item.addEventListener('click', () => {
			openLightbox(index);
		});
	});

	closeButton?.addEventListener('click', closeLightbox);
	previousButton?.addEventListener('click', () => showImage(activeIndex - 1));
	nextButton?.addEventListener('click', () => showImage(activeIndex + 1));

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) {
			closeLightbox();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (!lightbox || lightbox.classList.contains('hidden')) return;

		if (event.key === 'Escape') closeLightbox();
		if (event.key === 'ArrowLeft') showImage(activeIndex - 1);
		if (event.key === 'ArrowRight') showImage(activeIndex + 1);
	});
</script>

