<script>
	// MOBILE MENU
	const mobileMenuButton =
		document.querySelector<HTMLButtonElement>('#mobile-menu-button');
	const mobileMenu =
		document.querySelector<HTMLElement>('#mobile-menu');
	const mobileNavLinks =
		document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

	const closeMobileMenu = () => {
		mobileMenu?.classList.add('hidden');
		mobileMenuButton?.setAttribute('aria-expanded', 'false');
	};

	mobileMenuButton?.addEventListener('click', () => {
		const isNowHidden = mobileMenu?.classList.toggle('hidden') ?? true;
		mobileMenuButton.setAttribute('aria-expanded', String(!isNowHidden));
	});

	mobileNavLinks.forEach((link) => {
		link.addEventListener('click', closeMobileMenu);
	});

	// WHATSAPP CONTACT FORM
	const contactForm =
		document.querySelector<HTMLFormElement>('#contact-form');

	contactForm?.addEventListener('submit', (event) => {
		event.preventDefault();

		const name =
			(document.querySelector<HTMLInputElement>('#contact-name')?.value ?? '').trim();

		const phone =
			(document.querySelector<HTMLInputElement>('#contact-phone')?.value ?? '').trim();

		const program =
			(document.querySelector<HTMLSelectElement>('#contact-program')?.value ?? '').trim();

		const studentName =
			(document.querySelector<HTMLInputElement>('#student-name')?.value ?? '').trim();

		const message =
			(document.querySelector<HTMLTextAreaElement>('#contact-message')?.value ?? '').trim();

		const lines = [
			'Halo NOVA Learning Centre, saya ingin berkonsultasi mengenai program belajar.',
			'',
			`Nama: ${name}`,
			`No. WhatsApp: ${phone}`,
			`Program/Jenjang: ${program}`,
			studentName ? `Nama Siswa: ${studentName}` : '',
			'',
			'Kebutuhan belajar:',
			message,
		].filter(Boolean);

		const whatsappUrl =
			`https://wa.me/6285195511236?text=${encodeURIComponent(lines.join('\n'))}`;

		window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
	});
</script>

