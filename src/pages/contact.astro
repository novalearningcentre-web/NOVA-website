---
import Layout from '../layouts/Layout.astro';

const currentYear = new Date().getFullYear();

const navItems = [
	{ name: 'Beranda', href: '/' },
	{ name: 'Tentang Kami', href: '/about' },
	{ name: 'Program', href: '/programs' },
	{ name: 'Fasilitas', href: '/facilities' },
	{ name: 'E-Learning', href: '/elearning' },
	{ name: 'Kontak', href: '/contact' },
];

const contactItems = [
	{
		label: 'WhatsApp',
		value: '+62 851 9551 1236',
		href: 'https://wa.me/6285195511236',
		icon: 'chat',
	},
	{
		label: 'Email',
		value: 'halo@novalearningcentre.id',
		href: 'mailto:halo@novalearningcentre.id',
		icon: 'mail',
	},
	{
		label: 'Lokasi',
		value: 'Ruko Grand Orchard Blok C-21, Jakarta Utara',
		href: 'https://www.google.com/maps/search/?api=1&query=Ruko+Grand+Orchard+Blok+C-21+Jl.+Terusan+Kelapa+Hybrida+Sukapura+Cilincing+Jakarta+Utara+14140',
		icon: 'pin',
	},
];

const programs = [
	'Early Learners',
	'Primary',
	'Secondary',
	'Language & Skills',
	'Coding & Robotics',
	'Private Class',
	'E-Learning',
	'Lainnya',
];

const footerLinks = [
	{ name: 'Beranda', href: '/' },
	{ name: 'Tentang Kami', href: '/about' },
	{ name: 'Program', href: '/programs' },
	{ name: 'Fasilitas', href: '/facilities' },
	{ name: 'E-Learning', href: '/elearning' },
	{ name: 'Kontak', href: '/contact' },
];
---

<Layout
	title="Kontak | NOVA Learning Centre"
	description="Hubungi NOVA Learning Centre untuk konsultasi program, jadwal kelas, dan informasi pendaftaran."
>
	<!-- NAVBAR -->
	<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
		<nav
			class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8"
			aria-label="Navigasi utama"
		>
			<a href="/" class="flex items-center" aria-label="NOVA Learning Centre">
				<img
					src="/images/primary-logo-icon.png"
					alt="NOVA Learning Centre"
					class="h-10 w-10 object-contain sm:hidden"
				/>

				<img
					src="/images/primary-logo.png"
					alt="NOVA Learning Centre"
					class="hidden h-11 w-auto object-contain sm:block"
				/>
			</a>

			<div class="hidden items-center gap-7 lg:flex">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class:list={[
								'text-sm font-semibold transition',
								item.href === '/contact'
									? 'text-[#0F2747]'
									: 'text-slate-600 hover:text-[#A87300]',
							]}
						>
							{item.name}
						</a>
					))
				}
			</div>

			<a
				href="https://wa.me/6285195511236"
				target="_blank"
				rel="noreferrer"
				class="hidden rounded-xl bg-[#F3BC34] px-5 py-3 text-sm font-bold text-[#0F2747] transition hover:bg-[#DFA722] lg:inline-flex"
			>
				Chat WhatsApp
			</a>

			<button
				id="mobile-menu-button"
				type="button"
				class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-300 bg-white text-[#0F2747] lg:hidden"
				aria-label="Buka menu navigasi"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg
					width="23"
					height="23"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16"></path>
					<path d="M4 12h16"></path>
					<path d="M4 17h16"></path>
				</svg>
			</button>
		</nav>

		<div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-5 lg:hidden">
			<div class="flex flex-col gap-4">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class="mobile-nav-link text-sm font-semibold text-slate-700 transition hover:text-[#A87300]"
						>
							{item.name}
						</a>
					))
				}

				<a
					href="https://wa.me/6285195511236"
					target="_blank"
					rel="noreferrer"
					class="mobile-nav-link mt-2 rounded-xl bg-[#F3BC34] px-5 py-3 text-center text-sm font-bold text-[#0F2747]"
				>
					Chat WhatsApp
				</a>
			</div>
		</div>
	</header>

	<main>
		<!-- CONTACT INTRO -->
		<section class="bg-white">
			<div class="mx-auto max-w-7xl px-6 pb-14 pt-20 lg:px-8 lg:pb-20 lg:pt-28">
				<div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							Kontak NOVA
						</p>

						<h1
							class="mt-5 max-w-4xl text-5xl font-bold leading-[1.04] tracking-[-0.05em] text-[#0F2747] sm:text-6xl lg:text-[74px]"
						>
							Mari mulai dari kebutuhan
							<span class="text-[#A87300]">belajarnya.</span>
						</h1>
					</div>

					<p class="max-w-xl border-l-4 border-[#F3BC34] pl-6 text-lg leading-8 text-slate-600">
						Ceritakan kebutuhan siswa kepada kami. Tim NOVA akan membantu
						mengarahkan pilihan program, format kelas, dan langkah
						selanjutnya.
					</p>
				</div>
			</div>
		</section>

		<!-- CONTACT OPTIONS -->
		<section class="border-y border-slate-200 bg-[#F7F8FC]">
			<div class="mx-auto grid max-w-7xl divide-y divide-slate-200 px-6 md:grid-cols-3 md:divide-x md:divide-y-0 lg:px-8">
				{
					contactItems.map((item) => (
						<a
							href={item.href}
							target={item.label === 'Email' ? undefined : '_blank'}
							rel={item.label === 'Email' ? undefined : 'noreferrer'}
							class="group flex items-start gap-4 px-0 py-7 transition md:px-7 lg:py-8"
						>
							<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#F3BC34] text-[#0F2747] transition group-hover:scale-105">
								{item.icon === 'chat' && (
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
										<path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
									</svg>
								)}

								{item.icon === 'mail' && (
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
										<rect x="3" y="5" width="18" height="14" rx="2"></rect>
										<path d="m3 7 9 6 9-6"></path>
									</svg>
								)}

								{item.icon === 'pin' && (
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
										<path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
										<circle cx="12" cy="10" r="2.5"></circle>
									</svg>
								)}
							</div>

							<div class="min-w-0">
								<p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
									{item.label}
								</p>

								<p class="mt-2 break-words font-bold leading-6 text-[#0F2747] transition group-hover:text-[#A87300]">
									{item.value}
								</p>
							</div>
						</a>
					))
				}
			</div>
		</section>

		<!-- FORM + INFO -->
		<section class="bg-white py-24">
			<div class="mx-auto grid max-w-7xl gap-16 px-6 lg:grid-cols-[0.72fr_1.28fr] lg:px-8">
				<!-- LEFT COPY -->
				<div>
					<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
						Konsultasi Awal
					</p>

					<h2 class="mt-4 text-4xl font-bold tracking-tight text-[#0F2747] md:text-5xl">
						Tidak perlu tahu programnya dulu.
					</h2>

					<p class="mt-6 text-lg leading-8 text-slate-600">
						Cukup ceritakan kebutuhan belajarnya. Kami akan membantu
						mencari opsi yang lebih sesuai berdasarkan jenjang, tujuan,
						dan format belajar yang diinginkan.
					</p>

					<div class="mt-10 space-y-6">
						<div class="flex gap-4">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#F3BC34] text-xs font-bold text-[#0F2747]">
								1
							</span>

							<div>
								<h3 class="font-bold text-[#0F2747]">
									Ceritakan kebutuhan siswa
								</h3>

								<p class="mt-1 text-sm leading-6 text-slate-500">
									Jenjang, mata pelajaran, tujuan, atau kesulitan yang sedang dihadapi.
								</p>
							</div>
						</div>

						<div class="flex gap-4">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#F3BC34] text-xs font-bold text-[#0F2747]">
								2
							</span>

							<div>
								<h3 class="font-bold text-[#0F2747]">
									Kami bantu arahkan
								</h3>

								<p class="mt-1 text-sm leading-6 text-slate-500">
									Tim NOVA akan membantu menjelaskan pilihan program dan format kelas.
								</p>
							</div>
						</div>

						<div class="flex gap-4">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#F3BC34] text-xs font-bold text-[#0F2747]">
								3
							</span>

							<div>
								<h3 class="font-bold text-[#0F2747]">
									Tentukan langkah berikutnya
								</h3>

								<p class="mt-1 text-sm leading-6 text-slate-500">
									Pilih jadwal konsultasi, trial, atau pendaftaran sesuai kebutuhan.
								</p>
							</div>
						</div>
					</div>
				</div>

				<!-- FORM -->
				<div class="border-t-4 border-[#F3BC34] bg-[#F7F8FC] p-6 sm:p-8 lg:p-10">
					<div class="flex items-start justify-between gap-6">
						<div>
							<p class="text-sm font-bold text-[#0F2747]">
								Kirim pertanyaan ke NOVA
							</p>

							<p class="mt-2 text-sm leading-6 text-slate-500">
								Setelah dikirim, pesan akan dibuka melalui WhatsApp.
							</p>
						</div>

						<div class="hidden h-10 w-10 items-center justify-center rounded-full bg-[#F3BC34] text-[#0F2747] sm:flex">
							<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
							</svg>
						</div>
					</div>

					<form id="contact-form" class="mt-8 grid gap-5">
						<div class="grid gap-5 md:grid-cols-2">
							<label class="grid gap-2">
								<span class="text-sm font-semibold text-[#0F2747]">
									Nama
								</span>

								<input
									id="contact-name"
									name="name"
									type="text"
									autocomplete="name"
									required
									placeholder="Nama Anda"
									class="h-12 w-full border border-slate-300 bg-white px-4 text-sm text-[#0F2747] outline-none transition placeholder:text-slate-400 focus:border-[#0F2747]"
								/>
							</label>

							<label class="grid gap-2">
								<span class="text-sm font-semibold text-[#0F2747]">
									Nomor WhatsApp
								</span>

								<input
									id="contact-phone"
									name="phone"
									type="tel"
									autocomplete="tel"
									required
									placeholder="08xxxxxxxxxx"
									class="h-12 w-full border border-slate-300 bg-white px-4 text-sm text-[#0F2747] outline-none transition placeholder:text-slate-400 focus:border-[#0F2747]"
								/>
							</label>
						</div>

						<div class="grid gap-5 md:grid-cols-2">
							<label class="grid gap-2">
								<span class="text-sm font-semibold text-[#0F2747]">
									Jenjang / Program
								</span>

								<select
									id="contact-program"
									name="program"
									required
									class="h-12 w-full border border-slate-300 bg-white px-4 text-sm text-[#0F2747] outline-none transition focus:border-[#0F2747]"
								>
									<option value="" selected disabled>
										Pilih program
									</option>

									{
										programs.map((program) => (
											<option value={program}>
												{program}
											</option>
										))
									}
								</select>
							</label>

							<label class="grid gap-2">
								<span class="text-sm font-semibold text-[#0F2747]">
									Nama Siswa
									<span class="font-normal text-slate-400">(opsional)</span>
								</span>

								<input
									id="student-name"
									name="studentName"
									type="text"
									placeholder="Nama siswa"
									class="h-12 w-full border border-slate-300 bg-white px-4 text-sm text-[#0F2747] outline-none transition placeholder:text-slate-400 focus:border-[#0F2747]"
								/>
							</label>
						</div>

						<label class="grid gap-2">
							<span class="text-sm font-semibold text-[#0F2747]">
								Ceritakan kebutuhan belajarnya
							</span>

							<textarea
								id="contact-message"
								name="message"
								required
								rows="6"
								placeholder="Contoh: Anak saya kelas 7 dan membutuhkan pendampingan Matematika untuk kurikulum Cambridge..."
								class="w-full resize-none border border-slate-300 bg-white px-4 py-3 text-sm leading-6 text-[#0F2747] outline-none transition placeholder:text-slate-400 focus:border-[#0F2747]"
							></textarea>
						</label>

						<div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center sm:justify-between">
							<p class="max-w-md text-xs leading-5 text-slate-400">
								Dengan mengirim formulir ini, Anda akan diarahkan ke WhatsApp
								NOVA dengan pesan yang sudah disusun otomatis.
							</p>

							<button
								type="submit"
								class="inline-flex shrink-0 items-center justify-center gap-2 bg-[#F3BC34] px-6 py-3.5 font-bold text-[#0F2747] transition hover:bg-[#DFA722]"
							>
								Kirim via WhatsApp
								<span aria-hidden="true">→</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</section>

		<!-- LOCATION -->
		<section class="bg-[#0F2747] text-white">
			<div class="mx-auto grid max-w-7xl lg:grid-cols-[0.75fr_1.25fr]">
				<div class="px-6 py-16 lg:px-8 lg:py-20">
					<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#F3BC34]">
						Kunjungi NOVA
					</p>

					<h2 class="mt-4 text-4xl font-bold tracking-tight">
						Temui kami di Jakarta Utara.
					</h2>

					<p class="mt-6 max-w-md text-base leading-8 text-blue-100">
						Ruko Grand Orchard Blok C-21<br />
						Jl. Terusan Kelapa Hybrida<br />
						Sukapura, Cilincing<br />
						Jakarta Utara 14140
					</p>

					<a
						href="https://www.google.com/maps/search/?api=1&query=Ruko+Grand+Orchard+Blok+C-21+Jl.+Terusan+Kelapa+Hybrida+Sukapura+Cilincing+Jakarta+Utara+14140"
						target="_blank"
						rel="noreferrer"
						class="mt-8 inline-flex items-center gap-2 border-b border-[#F3BC34] pb-1 text-sm font-semibold text-white transition hover:text-[#F3BC34]"
					>
						Buka di Google Maps
						<span aria-hidden="true">↗</span>
					</a>
				</div>

				<div class="min-h-[420px] bg-slate-200 lg:min-h-[500px]">
					<iframe
						title="Lokasi NOVA Learning Centre"
						src="https://www.google.com/maps?q=Ruko%20Grand%20Orchard%20Blok%20C-21%20Jl.%20Terusan%20Kelapa%20Hybrida%20Sukapura%20Cilincing%20Jakarta%20Utara%2014140&output=embed"
						class="h-full min-h-[420px] w-full border-0 lg:min-h-[500px]"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>
		</section>

		<!-- FAQ MINI -->
		<section class="bg-[#F7F8FC] py-20">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							Sebelum Menghubungi Kami
						</p>

						<h2 class="mt-4 text-3xl font-bold tracking-tight text-[#0F2747] md:text-4xl">
							Pertanyaan yang sering muncul.
						</h2>
					</div>

					<div class="divide-y divide-slate-200 border-y border-slate-200">
						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-bold text-[#0F2747]">
								Apakah harus tahu program yang ingin diambil?
								<span class="text-xl text-[#A87300] transition group-open:rotate-45">+</span>
							</summary>

							<p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">
								Tidak. Anda dapat menjelaskan kebutuhan siswa terlebih dahulu dan
								tim NOVA akan membantu mengarahkan pilihan program.
							</p>
						</details>

						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-bold text-[#0F2747]">
								Apakah tersedia kelas private?
								<span class="text-xl text-[#A87300] transition group-open:rotate-45">+</span>
							</summary>

							<p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">
								Ya. NOVA menyediakan pilihan pembelajaran kelompok kecil dan
								private class, tergantung program serta kebutuhan siswa.
							</p>
						</details>

						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-bold text-[#0F2747]">
								Apakah ada kelas online?
								<span class="text-xl text-[#A87300] transition group-open:rotate-45">+</span>
							</summary>

							<p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">
								NOVA memiliki pembelajaran online dan e-learning untuk program
								tertentu. Ketersediaannya dapat dikonsultasikan dengan tim kami.
							</p>
						</details>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- FOOTER -->
	<footer class="bg-[#091D36] text-white">
		<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-[1.4fr_0.8fr_1fr]">
				<div>
					<a href="/" aria-label="NOVA Learning Centre">
						<img
							src="/images/primary-logo.png"
							alt="NOVA Learning Centre"
							class="h-14 w-auto brightness-0 invert"
						/>
					</a>

					<p class="mt-6 max-w-md text-sm leading-7 text-blue-100">
						Pusat pembelajaran modern untuk anak, remaja, dan pembelajar
						sepanjang hayat melalui kelas tatap muka dan e-learning.
					</p>

					<p class="mt-6 text-sm font-semibold text-[#F3BC34]">
						Learn with purpose. Grow with confidence.
					</p>
				</div>

				<div>
					<h3 class="text-sm font-bold uppercase tracking-[0.18em] text-[#F3BC34]">
						Navigasi
					</h3>

					<div class="mt-6 grid gap-3">
						{
							footerLinks.map((item) => (
								<a href={item.href} class="text-sm text-blue-100 transition hover:text-white">
									{item.name}
								</a>
							))
						}
					</div>
				</div>

				<div>
					<h3 class="text-sm font-bold uppercase tracking-[0.18em] text-[#F3BC34]">
						Hubungi Kami
					</h3>

					<div class="mt-6 space-y-5 text-sm text-blue-100">
						<div>
							<p class="font-semibold text-white">WhatsApp</p>
							<a
								href="https://wa.me/6285195511236"
								target="_blank"
								rel="noreferrer"
								class="mt-1 block transition hover:text-white"
							>
								+62 851 9551 1236
							</a>
						</div>

						<div>
							<p class="font-semibold text-white">Email</p>
							<a
								href="mailto:halo@novalearningcentre.id"
								class="mt-1 block break-all transition hover:text-white"
							>
								halo@novalearningcentre.id
							</a>
						</div>

						<a
							href="https://wa.me/6285195511236"
							target="_blank"
							rel="noreferrer"
							class="inline-flex bg-[#F3BC34] px-5 py-3 font-bold text-[#0F2747] transition hover:bg-[#DFA722]"
						>
							Hubungi NOVA
						</a>
					</div>
				</div>
			</div>

			<div
