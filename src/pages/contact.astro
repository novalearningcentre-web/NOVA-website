---
import Layout from '../layouts/Layout.astro';

const whatsappNumber = '6285195511236';

const whatsappUrl =
	'https://wa.me/6285195511236?text=Halo%20NOVA%20Learning%20Centre%2C%20saya%20ingin%20bertanya%20mengenai%20program%20belajar.';

const mapsUrl =
	'https://maps.app.goo.gl/V71v81TpoHjW266z9';

---

<Layout
	title="Kontak | NOVA Learning Centre"
	description="Hubungi NOVA Learning Centre untuk konsultasi program, trial class, jadwal, biaya, atau kunjungan ke learning centre."
>
	<main class="overflow-hidden">
		<!-- HERO -->
		<section class="relative overflow-hidden bg-white">
			<div
				class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[#f3bc34]/14 blur-3xl"
				aria-hidden="true"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-20">
				<div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
					<div>
						<p class="section-label">
							<span class="lang-id">Kontak NOVA</span>
							<span class="lang-en">Contact NOVA</span>
						</p>

						<h1
							class="mt-5 max-w-3xl text-4xl font-extrabold leading-[1.08] tracking-[-0.045em] text-[#1d2f5c] sm:text-5xl lg:text-[58px]"
						>
							<span class="lang-id">
								Mari bicara tentang kebutuhan&nbsp;
								<span class="relative inline-block">
									belajar anak.
									<span
										class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/70"
										aria-hidden="true"
									></span>
								</span>
							</span>

							<span class="lang-en">
								Let’s talk about your child’s
								<span class="relative inline-block">
									learning needs.
									<span
										class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/70"
										aria-hidden="true"
									></span>
								</span>
							</span>
						</h1>

						<p class="mt-6 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">
							<span class="lang-id">
								Punya pertanyaan tentang program, jadwal, trial class, atau biaya?
								Tim NOVA siap membantu menemukan pilihan yang sesuai.
							</span>

							<span class="lang-en">
								Have questions about programs, schedules, trial classes or fees?
								The NOVA team can help you find a suitable option.
							</span>
						</p>

						<div class="mt-8 flex flex-col gap-3 sm:flex-row">
							<a
								href={whatsappUrl}
								target="_blank"
								rel="noreferrer"
								class="inline-flex items-center justify-center bg-[#f3bc34] px-6 py-3.5 font-extrabold text-[#1d2f5c] transition hover:-translate-y-0.5 hover:shadow-lg"
							>
								<span class="lang-id">Chat via WhatsApp</span>
								<span class="lang-en">Chat on WhatsApp</span>
								<span class="ml-2">→</span>
							</a>

							<a
								href="#contact-form"
								class="inline-flex items-center justify-center border border-[#1d2f5c]/18 bg-white px-6 py-3.5 font-bold text-[#1d2f5c] transition hover:border-[#1d2f5c] hover:bg-[#1d2f5c] hover:text-white"
							>
								<span class="lang-id">Isi Form Konsultasi</span>
								<span class="lang-en">Fill in Enquiry Form</span>
							</a>
						</div>
					</div>

					<div class="bg-[#f7f8fc] p-6 md:p-8">
						<p class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#1d2f5c]/45">
							<span class="lang-id">Cara Tercepat Menghubungi Kami</span>
							<span class="lang-en">The Quickest Way to Reach Us</span>
						</p>

						<div class="mt-5 space-y-5">
							<div class="flex gap-4">
								<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#f3bc34] font-black text-[#1d2f5c]">
									1
								</div>

								<div>
									<p class="font-extrabold text-[#1d2f5c]">WhatsApp</p>
									<p class="mt-1 text-sm leading-6 text-slate-500">
										<span class="lang-id">Untuk konsultasi program, jadwal, dan trial class.</span>
										<span class="lang-en">For program, schedule and trial class enquiries.</span>
									</p>
								</div>
							</div>

							<div class="border-t border-slate-200 pt-5">
								<div class="flex gap-4">
									<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#1d2f5c] font-black text-white">
										2
									</div>

									<div>
										<p class="font-extrabold text-[#1d2f5c]">
											<span class="lang-id">Kunjungan Langsung</span>
											<span class="lang-en">Visit NOVA</span>
										</p>
										<p class="mt-1 text-sm leading-6 text-slate-500">
											<span class="lang-id">Hubungi kami terlebih dahulu agar tim dapat menyiapkan waktu konsultasi.</span>
											<span class="lang-en">Contact us first so the team can arrange a suitable consultation time.</span>
										</p>
									</div>
								</div>
							</div>
						</div>

						<div class="mt-6 border-t border-slate-200 pt-5 text-sm text-slate-500">
							<p class="font-bold text-[#1d2f5c]">0851 9551 1236</p>
							<p class="mt-1">novalearningcentre@gmail.com</p>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- QUICK CONTACT -->
		<section class="border-y border-slate-200 bg-[#f7f8fc]">
			<div class="mx-auto grid max-w-7xl gap-px bg-slate-200 md:grid-cols-3">
				<a
					href={whatsappUrl}
					target="_blank"
					rel="noreferrer"
					class="group bg-[#f7f8fc] px-6 py-8 transition hover:bg-[#f3bc34]"
				>
					<div class="flex items-center justify-between gap-5">
						<div>
							<p class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#1d2f5c]/45">
								WhatsApp
							</p>
							<p class="mt-2 text-lg font-extrabold text-[#1d2f5c]">
								0851 9551 1236
							</p>
							<p class="mt-2 text-sm leading-6 text-slate-500 transition group-hover:text-[#1d2f5c]/70">
								<span class="lang-id">Cara tercepat untuk menghubungi NOVA.</span>
								<span class="lang-en">The quickest way to reach NOVA.</span>
							</p>
						</div>

						<span class="text-xl font-bold text-[#1d2f5c]">→</span>
					</div>
				</a>

				<a
					href="mailto:novalearningcentre@gmail.com"
					class="group bg-[#f7f8fc] px-6 py-8 transition hover:bg-[#f3bc34]"
				>
					<div class="flex items-center justify-between gap-5">
						<div>
							<p class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#1d2f5c]/45">
								Email
							</p>
							<p class="mt-2 break-all text-lg font-extrabold text-[#1d2f5c]">
								novalearningcentre@gmail.com
							</p>
							<p class="mt-2 text-sm leading-6 text-slate-500 transition group-hover:text-[#1d2f5c]/70">
								<span class="lang-id">Untuk pertanyaan atau informasi tertulis.</span>
								<span class="lang-en">For written enquiries and information.</span>
							</p>
						</div>

						<span class="text-xl font-bold text-[#1d2f5c]">→</span>
					</div>
				</a>

				<a
					href={mapsUrl}
					target="_blank"
					rel="noreferrer"
					class="group bg-[#f7f8fc] px-6 py-8 transition hover:bg-[#f3bc34]"
				>
					<div class="flex items-center justify-between gap-5">
						<div>
							<p class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#1d2f5c]/45">
								<span class="lang-id">Lokasi</span>
								<span class="lang-en">Location</span>
							</p>
							<p class="mt-2 text-lg font-extrabold text-[#1d2f5c]">
								Kelapa Gading, Jakarta Utara
							</p>
							<p class="mt-2 text-sm leading-6 text-slate-500 transition group-hover:text-[#1d2f5c]/70">
								<span class="lang-id">Buka lokasi di Google Maps.</span>
								<span class="lang-en">Open the location in Google Maps.</span>
							</p>
						</div>

						<span class="text-xl font-bold text-[#1d2f5c]">→</span>
					</div>
				</a>
			</div>
		</section>

		<!-- CONTACT + FORM -->
		<section id="contact-form" class="scroll-mt-28 bg-white py-24">
			<div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[0.78fr_1.22fr] lg:px-8">
				<!-- INFO -->
				<div>
					<p class="section-label">
						<span class="lang-id">Kunjungi NOVA</span>
						<span class="lang-en">Visit NOVA</span>
					</p>

					<h2
						class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
					>
						<span class="lang-id">Kami siap membantu.</span>
						<span class="lang-en">We’re here to help.</span>
					</h2>

					<div class="mt-8 space-y-7">
						<div>
							<p class="info-label">
								<span class="lang-id">Alamat</span>
								<span class="lang-en">Address</span>
							</p>

							<a
								href={mapsUrl}
								target="_blank"
								rel="noreferrer"
								class="mt-2 block max-w-md text-base font-semibold leading-7 text-[#1d2f5c] transition hover:text-[#1d2f5c]/65"
							>
								Ruko Grand Orchard Blok C-21,<br />
								Jl. Terusan Kelapa Hybrida, Sukapura,<br />
								Cilincing, Jakarta Utara 14140
							</a>

							<a
								href={mapsUrl}
								target="_blank"
								rel="noreferrer"
								class="mt-3 inline-flex items-center gap-2 text-sm font-extrabold text-[#1d2f5c]"
							>
								<span class="lang-id">Buka di Google Maps</span>
								<span class="lang-en">Open in Google Maps</span>
								<span>→</span>
							</a>
						</div>

						<div class="border-t border-slate-200 pt-6">
							<p class="info-label">
								<span class="lang-id">Jam Operasional</span>
								<span class="lang-en">Opening Hours</span>
							</p>

							<div class="mt-3 grid max-w-sm grid-cols-[150px_1fr] gap-y-2 text-sm leading-6 text-slate-600">
								<span class="font-semibold text-[#1d2f5c]">
									<span class="lang-id">Senin – Jumat</span>
									<span class="lang-en">Monday – Friday</span>
								</span>
								<span>10.00 – 20.00</span>

								<span class="font-semibold text-[#1d2f5c]">
									<span class="lang-id">Sabtu</span>
									<span class="lang-en">Saturday</span>
								</span>
								<span>09.00 – 15.00</span>

								<span class="font-semibold text-[#1d2f5c]">
									<span class="lang-id">Minggu</span>
									<span class="lang-en">Sunday</span>
								</span>
								<span>
									<span class="lang-id">Tutup</span>
									<span class="lang-en">Closed</span>
								</span>
							</div>
						</div>

						<div class="border-t border-slate-200 pt-6">
							<p class="info-label">
								<span class="lang-id">Sebelum Berkunjung</span>
								<span class="lang-en">Before You Visit</span>
							</p>

							<p class="mt-2 max-w-md text-sm leading-7 text-slate-500">
								<span class="lang-id">
									Untuk konsultasi atau melihat ruang belajar, kami menyarankan
									menghubungi NOVA terlebih dahulu agar tim dapat mempersiapkan waktu
									yang sesuai.
								</span>

								<span class="lang-en">
									For consultations or facility visits, we recommend contacting
									NOVA in advance so the team can arrange a suitable time.
								</span>
							</p>
						</div>
					</div>
				</div>

				<!-- SIMPLE FORM -->
				<div class="border border-slate-200 bg-[#f7f8fc] p-6 md:p-8">
					<div class="max-w-xl">
						<p class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#1d2f5c]/45">
							<span class="lang-id">Konsultasi Singkat</span>
							<span class="lang-en">Quick Enquiry</span>
						</p>

						<h3 class="mt-3 text-2xl font-extrabold text-[#1d2f5c]">
							<span class="lang-id">Ceritakan kebutuhan anak.</span>
							<span class="lang-en">Tell us what your child needs.</span>
						</h3>

						<p class="mt-3 text-sm leading-7 text-slate-500">
							<span class="lang-id">
								Isi informasi dasar saja. Setelah klik tombol di bawah, WhatsApp akan
								terbuka dengan pesan yang sudah disiapkan.
							</span>

							<span class="lang-en">
								Just provide the basic details. After selecting the button below,
								WhatsApp will open with a prepared message.
							</span>
						</p>
					</div>

					<div class="mt-7 grid gap-5 sm:grid-cols-2">
						<label class="block">
							<span class="form-label">
								<span class="lang-id">Nama Orang Tua</span>
								<span class="lang-en">Parent Name</span>
							</span>

							<input
								id="parent-name"
								type="text"
								class="form-input"
								placeholder="Nama"
							/>
						</label>

						<label class="block">
							<span class="form-label">
								<span class="lang-id">Nomor WhatsApp</span>
								<span class="lang-en">WhatsApp Number</span>
							</span>

							<input
								id="phone-number"
								type="tel"
								class="form-input"
								placeholder="08..."
							/>
						</label>

						<label class="block">
							<span class="form-label">
								<span class="lang-id">Nama / Usia Anak</span>
								<span class="lang-en">Student Name / Age</span>
							</span>

							<input
								id="student-info"
								type="text"
								class="form-input"
								placeholder="Contoh: Kevin, 10 tahun"
							/>
						</label>

						<label class="block">
							<span class="form-label">
								<span class="lang-id">Yang Ingin Ditanyakan</span>
								<span class="lang-en">Enquiry Type</span>
							</span>

							<select id="enquiry-type" class="form-input">
								<option value="program">Program Belajar / Learning Program</option>
								<option value="trial">Trial Class</option>
								<option value="fees">Biaya / Fees</option>
								<option value="schedule">Jadwal / Schedule</option>
								<option value="visit">Kunjungan / Facility Visit</option>
								<option value="other">Lainnya / Other</option>
							</select>
						</label>

						<label class="block sm:col-span-2">
							<span class="form-label">
								<span class="lang-id">Pesan / Kebutuhan Belajar</span>
								<span class="lang-en">Message / Learning Needs</span>
							</span>

							<textarea
								id="message"
								rows="5"
								class="form-input resize-none"
								placeholder="Ceritakan sedikit kebutuhan atau pertanyaan Anda..."
							></textarea>
						</label>
					</div>

					<button
						id="submit-whatsapp"
						type="button"
						class="mt-6 inline-flex w-full items-center justify-center bg-[#f3bc34] px-6 py-4 font-extrabold text-[#1d2f5c] transition hover:bg-[#1d2f5c] hover:text-white"
					>
						<span class="lang-id">Lanjutkan via WhatsApp</span>
						<span class="lang-en">Continue on WhatsApp</span>
						<span class="ml-2">→</span>
					</button>

					<p class="mt-4 text-center text-xs leading-5 text-slate-400">
						<span class="lang-id">
							Form ini tidak mengirim data ke server. Pesan akan diteruskan melalui WhatsApp.
						</span>

						<span class="lang-en">
							This form does not submit data to a server. Your message will continue through WhatsApp.
						</span>
					</p>
				</div>
			</div>
		</section>

		<!-- MAP -->
		<section class="bg-[#f7f8fc] py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-center">
					<div>
						<p class="section-label">
							<span class="lang-id">Lokasi NOVA</span>
							<span class="lang-en">NOVA Location</span>
						</p>

						<h2
							class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
						>
							<span class="lang-id">Temukan kami dengan mudah.</span>
							<span class="lang-en">Find us easily.</span>
						</h2>

						<p class="mt-5 max-w-md text-base leading-7 text-slate-600">
							<span class="lang-id">
								Gunakan panel lokasi di sebelah kanan untuk membuka pin NOVA dan petunjuk arah melalui Google Maps.
							</span>

							<span class="lang-en">
								Use the location panel to open NOVA’s pin and directions in Google Maps.
							</span>
						</p>

					</div>

					<a
						href={mapsUrl}
						target="_blank"
						rel="noreferrer"
						class="group relative flex min-h-[430px] items-center justify-center overflow-hidden bg-[#1d2f5c] p-8 text-center shadow-sm"
					>
						<div
							class="absolute -left-20 -top-20 h-64 w-64 rounded-full bg-[#f3bc34]/16 blur-3xl"
							aria-hidden="true"
						></div>

						<div
							class="absolute -bottom-24 -right-20 h-72 w-72 rounded-full bg-white/8 blur-3xl"
							aria-hidden="true"
						></div>

						<div class="relative max-w-md text-white">
							<div
								class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#f3bc34] text-2xl font-black text-[#1d2f5c] transition group-hover:scale-105"
							>
								⌖
							</div>

							<p class="mt-6 text-xs font-extrabold uppercase tracking-[0.16em] text-[#f3bc34]">
								Google Maps
							</p>

							<h3 class="mt-3 text-2xl font-extrabold">
								<span class="lang-id">Buka Pin Lokasi NOVA</span>
								<span class="lang-en">Open NOVA Location Pin</span>
							</h3>

							<p class="mt-4 text-sm leading-7 text-white/70">
								Ruko Grand Orchard Blok C-21,<br />
								Jl. Terusan Kelapa Hybrida, Sukapura,<br />
								Cilincing, Jakarta Utara 14140
							</p>

							<span
								class="mt-7 inline-flex bg-[#f3bc34] px-6 py-3.5 font-extrabold text-[#1d2f5c] transition group-hover:-translate-y-0.5"
							>
								<span class="lang-id">Buka Lokasi</span>
								<span class="lang-en">Open Location</span>
								<span class="ml-2">→</span>
							</span>
						</div>
					</a>
				</div>
			</div>
		</section>

		<!-- FINAL CTA -->
		<section class="bg-[#1d2f5c] py-20 text-white">
			<div class="mx-auto max-w-4xl px-6 text-center">
				<p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#f3bc34]">
					NOVA Learning Centre
				</p>

				<h2
					class="mt-4 text-4xl font-extrabold tracking-[-0.035em] md:text-5xl"
				>
					<span class="lang-id">Masih bingung mulai dari mana?</span>
					<span class="lang-en">Not sure where to start?</span>
				</h2>

				<p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/70">
					<span class="lang-id">
						Chat langsung dengan tim NOVA. Ceritakan kebutuhan anak dan kami bantu arahkan program yang sesuai.
					</span>

					<span class="lang-en">
						Chat directly with the NOVA team. Tell us about your child’s needs and we can help recommend a suitable program.
					</span>
				</p>

				<a
					href={whatsappUrl}
					target="_blank"
					rel="noreferrer"
					class="mt-8 inline-flex bg-[#f3bc34] px-8 py-4 font-extrabold text-[#1d2f5c] transition hover:-translate-y-0.5 hover:shadow-xl"
				>
					<span class="lang-id">Chat dengan NOVA</span>
					<span class="lang-en">Chat with NOVA</span>
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
	const whatsappNumber = '6285195511236';

	const submitButton =
		document.querySelector<HTMLButtonElement>('#submit-whatsapp');

	submitButton?.addEventListener('click', () => {
		const parentName =
			document.querySelector<HTMLInputElement>('#parent-name')?.value || '-';

		const phone =
			document.querySelector<HTMLInputElement>('#phone-number')?.value || '-';

		const studentInfo =
			document.querySelector<HTMLInputElement>('#student-info')?.value || '-';

		const enquiryType =
			document.querySelector<HTMLSelectElement>('#enquiry-type')?.value || 'program';

		const message =
			document.querySelector<HTMLTextAreaElement>('#message')?.value || '-';

		const language =
			document.documentElement.dataset.lang === 'en' ? 'en' : 'id';

		const enquiryLabelsId: Record<string, string> = {
			program: 'Program Belajar',
			trial: 'Trial Class',
			fees: 'Biaya',
			schedule: 'Jadwal',
			visit: 'Kunjungan',
			other: 'Lainnya',
		};

		const enquiryLabelsEn: Record<string, string> = {
			program: 'Learning Program',
			trial: 'Trial Class',
			fees: 'Fees',
			schedule: 'Schedule',
			visit: 'Facility Visit',
			other: 'Other',
		};

		const messageId = [
			'Halo NOVA Learning Centre,',
			'',
			`Nama orang tua: ${parentName}`,
			`Nomor WhatsApp: ${phone}`,
			`Nama / usia anak: ${studentInfo}`,
			`Pertanyaan mengenai: ${enquiryLabelsId[enquiryType] || enquiryType}`,
			`Pesan: ${message}`,
			'',
			'Mohon informasi lebih lanjut. Terima kasih.',
		].join('\n');

		const messageEn = [
			'Hello NOVA Learning Centre,',
			'',
			`Parent name: ${parentName}`,
			`WhatsApp number: ${phone}`,
			`Student name / age: ${studentInfo}`,
			`Enquiry about: ${enquiryLabelsEn[enquiryType] || enquiryType}`,
			`Message: ${message}`,
			'',
			'Please share further information. Thank you.',
		].join('\n');

		const finalMessage =
			language === 'en' ? messageEn : messageId;

		window.open(
			`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(finalMessage)}`,
			'_blank',
			'noopener,noreferrer',
		);
	});
</script>

