---
import Layout from '../layouts/Layout.astro';

const currentYear = new Date().getFullYear();

const navItems = [
	{ name: 'Beranda', href: '/' },
	{ name: 'Tentang Kami', href: '/about' },
	{ name: 'Program', href: '/programs' },
	{ name: 'Fasilitas', href: '/facilities' },
	{ name: 'E-Learning', href: '/elearning' },
	{ name: 'Kontak', href: '/contact' },
];

/*
	Ganti thumbnail nanti jika sudah ada:
	thumbnail: '/images/elearning/math-grade7.jpg'
*/
const courses = [
	{
		title: 'Matematika Dasar Kelas 7',
		category: 'Matematika',
		level: 'SMP',
		modules: '8 modul',
		duration: '± 6 jam',
		thumbnail: '',
	},
	{
		title: 'English Grammar Essentials',
		category: 'English',
		level: 'Primary–Secondary',
		modules: '6 modul',
		duration: '± 4 jam',
		thumbnail: '',
	},
	{
		title: 'Science Foundations',
		category: 'Science',
		level: 'Primary',
		modules: '7 modul',
		duration: '± 5 jam',
		thumbnail: '',
	},
	{
		title: 'Creative Coding Basics',
		category: 'Coding',
		level: 'Primary',
		modules: '6 modul',
		duration: '± 5 jam',
		thumbnail: '',
	},
	{
		title: 'Python for Beginners',
		category: 'Coding',
		level: 'SMP–SMA',
		modules: '8 modul',
		duration: '± 7 jam',
		thumbnail: '',
	},
	{
		title: 'Mandarin Foundations',
		category: 'Mandarin',
		level: 'Beginner',
		modules: '6 modul',
		duration: '± 4 jam',
		thumbnail: '',
	},
];

const footerLinks = [
	{ name: 'Beranda', href: '/' },
	{ name: 'Tentang Kami', href: '/about' },
	{ name: 'Program', href: '/programs' },
	{ name: 'Fasilitas', href: '/facilities' },
	{ name: 'E-Learning', href: '/elearning' },
	{ name: 'Kontak', href: '/contact' },
];
---

<Layout
	title="E-Learning | NOVA Learning Centre"
	description="Belajar mandiri melalui kursus asynchronous NOVA Learning Centre."
>
	<!-- NAVBAR -->
	<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
		<nav
			class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8"
			aria-label="Navigasi utama"
		>
			<a href="/" class="flex items-center" aria-label="NOVA Learning Centre">
				<img
					src="/images/primary-logo-icon.png"
					alt="NOVA Learning Centre"
					class="h-10 w-10 object-contain sm:hidden"
				/>

				<img
					src="/images/primary-logo.png"
					alt="NOVA Learning Centre"
					class="hidden h-11 w-auto object-contain sm:block"
				/>
			</a>

			<div class="hidden items-center gap-7 lg:flex">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class:list={[
								'text-sm font-semibold transition',
								item.href === '/elearning'
									? 'text-[#0F2747]'
									: 'text-slate-600 hover:text-[#A87300]',
							]}
						>
							{item.name}
						</a>
					))
				}
			</div>

			<a
				href="/contact"
				class="hidden rounded-xl bg-[#F3BC34] px-5 py-3 text-sm font-bold text-[#0F2747] transition hover:bg-[#DFA722] lg:inline-flex"
			>
				Konsultasi Gratis
			</a>

			<button
				id="mobile-menu-button"
				type="button"
				class="flex h-11 w-11 items-center justify-center border border-slate-300 bg-white text-[#0F2747] lg:hidden"
				aria-label="Buka menu navigasi"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg
					width="23"
					height="23"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16"></path>
					<path d="M4 12h16"></path>
					<path d="M4 17h16"></path>
				</svg>
			</button>
		</nav>

		<div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-5 lg:hidden">
			<div class="flex flex-col gap-4">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class="mobile-nav-link text-sm font-semibold text-slate-700 transition hover:text-[#A87300]"
						>
							{item.name}
						</a>
					))
				}

				<a
					href="/contact"
					class="mobile-nav-link mt-2 bg-[#F3BC34] px-5 py-3 text-center text-sm font-bold text-[#0F2747]"
				>
					Konsultasi Gratis
				</a>
			</div>
		</div>
	</header>

	<main>
		<!-- HERO -->
		<section class="bg-[#0F2747] text-white">
			<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
				<div class="max-w-4xl">
					<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#F3BC34]">
						NOVA E-Learning
					</p>

					<h1
						class="mt-5 text-5xl font-bold leading-[1.04] tracking-[-0.05em] sm:text-6xl lg:text-[70px]"
					>
						Belajar kapan saja.
						<span class="text-[#F3BC34]">Tetap terarah.</span>
					</h1>

					<p class="mt-6 max-w-2xl text-lg leading-8 text-blue-100">
						Kursus asynchronous dengan video, materi, latihan, dan kuis
						yang dapat dipelajari sesuai ritme masing-masing.
					</p>
				</div>
			</div>
		</section>

		<!-- COURSES -->
		<section class="bg-[#F7F8FC] py-20">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							Kursus Asynchronous
						</p>

						<h2 class="mt-3 text-4xl font-bold tracking-tight text-[#0F2747]">
							Pilih kelas dan mulai belajar.
						</h2>
					</div>

					<p class="max-w-md text-sm leading-6 text-slate-500">
						Kursus dapat dipelajari secara mandiri tanpa harus mengikuti
						jadwal kelas tetap.
					</p>
				</div>

				<div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
					{
						courses.map((course, index) => (
							<a
								href="#"
								class="group overflow-hidden border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-[#F3BC34] hover:shadow-xl"
							>
								<div class="relative aspect-[16/9] overflow-hidden bg-[#0F2747]">
									{course.thumbnail ? (
										<img
											src={course.thumbnail}
											alt={course.title}
											class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
											loading="lazy"
										/>
									) : (
										<div class="flex h-full items-center justify-center bg-[linear-gradient(135deg,#0F2747,#17385F)]">
											<div class="flex h-14 w-14 items-center justify-center bg-[#F3BC34] text-[#0F2747]">
												<svg
													width="25"
													height="25"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													aria-hidden="true"
												>
													<polygon points="8 5 19 12 8 19 8 5"></polygon>
												</svg>
											</div>
										</div>
									)}

									<span class="absolute left-4 top-4 bg-white px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[#0F2747]">
										{course.category}
									</span>
								</div>

								<div class="p-5">
									<p class="text-xs font-semibold text-[#A87300]">
										{course.level}
									</p>

									<h3 class="mt-2 text-lg font-bold text-[#0F2747]">
										{course.title}
									</h3>

									<div class="mt-5 flex items-center gap-4 border-t border-slate-100 pt-4 text-xs text-slate-500">
										<span>{course.modules}</span>
										<span>•</span>
										<span>{course.duration}</span>
									</div>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<!-- HOW IT WORKS -->
		<section class="bg-white py-14">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="mx-auto max-w-3xl text-center">
					<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
						Cara Belajar
					</p>

					<h2 class="mt-3 text-3xl font-bold tracking-tight text-[#0F2747] md:text-4xl">
						Belajar online tanpa ribet.
					</h2>

					<p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-500">
						Tiga langkah sederhana untuk mulai belajar secara mandiri.
					</p>
				</div>

				<div class="learning-steps mt-10">
					<article class="learning-step-card">
						<div class="step-number step-blue">01</div>

						<div>
							<h3 class="text-lg font-bold text-[#0F2747]">
								Pilih Kursus
							</h3>

							<p class="mt-2 text-sm leading-6 text-slate-500">
								Pilih topik dan level yang ingin dipelajari.
							</p>
						</div>
					</article>

					<article class="learning-step-card">
						<div class="step-number step-yellow">02</div>

						<div>
							<h3 class="text-lg font-bold text-[#0F2747]">
								Belajar Mandiri
							</h3>

							<p class="mt-2 text-sm leading-6 text-slate-500">
								Tonton materi, baca modul, dan kerjakan latihan.
							</p>
						</div>
					</article>

					<article class="learning-step-card">
						<div class="step-number step-navy">03</div>

						<div>
							<h3 class="text-lg font-bold text-[#0F2747]">
								Selesaikan Modul
							</h3>

							<p class="mt-2 text-sm leading-6 text-slate-500">
								Lanjutkan progres dan selesaikan kursus bertahap.
							</p>
						</div>
					</article>
				</div>
			</div>
		</section>
		<!-- CTA -->
		<section class="bg-[#F7F8FC] pb-20 pt-4">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid overflow-hidden bg-[#0F2747] lg:grid-cols-[1.25fr_0.75fr]">
					<div class="px-7 py-9 md:px-10 lg:px-12 lg:py-10">
						<p class="text-xs font-bold uppercase tracking-[0.22em] text-[#F3BC34]">
							NOVA E-Learning
						</p>

						<h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight text-white md:text-4xl">
							Mulai dari satu kelas. Belajar dengan ritme sendiri.
						</h2>

						<p class="mt-4 max-w-xl text-sm leading-7 text-blue-100">
							Cocok untuk siswa yang ingin belajar lebih fleksibel tanpa
							terikat jadwal kelas tetap.
						</p>
					</div>

					<div
						class="flex items-center border-t border-white/10 bg-[#102D50] px-7 py-8 lg:border-l lg:border-t-0 lg:px-10"
					>
						<a
							href="/contact"
							class="inline-flex w-full items-center justify-between bg-[#F3BC34] px-6 py-4 text-sm font-bold text-[#0F2747] transition hover:bg-[#DFA722]"
						>
							<span>Tanya tentang E-Learning</span>
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- FOOTER -->
	<footer class="bg-[#091D36] text-white">
		<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-[1.4fr_0.8fr_1fr]">
				<div>
					<a href="/" aria-label="NOVA Learning Centre">
						<img
							src="/images/primary-logo.png"
							alt="NOVA Learning Centre"
							class="h-14 w-auto brightness-0 invert"
						/>
					</a>

					<p class="mt-6 max-w-md text-sm leading-7 text-blue-100">
						Pusat pembelajaran modern untuk anak, remaja, dan pembelajar
						sepanjang hayat melalui kelas tatap muka dan e-learning.
					</p>

					<p class="mt-6 text-sm font-semibold text-[#F3BC34]">
						Learn with purpose. Grow with confidence.
					</p>
				</div>

				<div>
					<h3 class="text-sm font-bold uppercase tracking-[0.18em] text-[#F3BC34]">
						Navigasi
					</h3>

					<div class="mt-6 grid gap-3">
						{
							footerLinks.map((item) => (
								<a href={item.href} class="text-sm text-blue-100 transition hover:text-white">
									{item.name}
								</a>
							))
						}
					</div>
				</div>

				<div>
					<h3 class="text-sm font-bold uppercase tracking-[0.18em] text-[#F3BC34]">
						Hubungi Kami
					</h3>

					<div class="mt-6 space-y-5 text-sm text-blue-100">
						<div>
							<p class="font-semibold text-white">Lokasi</p>
							<p class="mt-1 leading-6">Kelapa Gading, Jakarta Utara</p>
						</div>

						<div>
							<p class="font-semibold text-white">Email</p>
							<a
								href="mailto:halo@novalearningcentre.id"
								class="mt-1 block break-all transition hover:text-white"
							>
								halo@novalearningcentre.id
							</a>
						</div>

						<a
							href="/contact"
							class="inline-flex bg-[#F3BC34] px-5 py-3 font-bold text-[#0F2747] transition hover:bg-[#DFA722]"
						>
							Hubungi NOVA
						</a>
					</div>
				</div>
			</div>

			<div
				class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-7 text-xs text-blue-200 sm:flex-row sm:items-center sm:justify-between"
			>
				<p>© {currentYear} NOVA Learning Centre. All rights reserved.</p>

				<div class="flex gap-5">
					<a href="/privacy" class="transition hover:text-white">
						Kebijakan Privasi
					</a>

					<a href="/terms" class="transition hover:text-white">
						Syarat & Ketentuan
					</a>
				</div>
			</div>
		</div>
	</footer>
</Layout>

<script>
	const mobileMenuButton =
		document.querySelector<HTMLButtonElement>('#mobile-menu-button');
	const mobileMenu =
		document.querySelector<HTMLElement>('#mobile-menu');
	const mobileNavLinks =
		document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

	const closeMobileMenu = () => {
		mobileMenu?.classList.add('hidden');
		mobileMenuButton?.setAttribute('aria-expanded', 'false');
	};

	mobileMenuButton?.addEventListener('click', () => {
		const isNowHidden = mobileMenu?.classList.toggle('hidden') ?? true;
		mobileMenuButton.setAttribute('aria-expanded', String(!isNowHidden));
	});

	mobileNavLinks.forEach((link) => {
		link.addEventListener('click', closeMobileMenu);
	});
</script>

<style>
	.learning-steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.learning-step-card {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		border: 1px solid #e2e8f0;
		background: #f8fafc;
		padding: 1.25rem;
	}

	.step-number {
		display: flex;
		width: 52px;
		height: 52px;
		align-items: center;
		justify-content: center;
		font-weight: 800;
		font-size: 0.9rem;
	}

	.step-blue {
		border: 2px solid #8FB7E8;
		background: #ffffff;
		color: #0F2747;
	}

	.step-yellow {
		background: #F3BC34;
		color: #0F2747;
	}

	.step-navy {
		background: #0F2747;
		color: #ffffff;
	}

	@media (max-width: 767px) {
		.learning-steps {
			grid-template-columns: 1fr;
		}
	}


	@media (prefers-reduced-motion: reduce) {
		* {
			scroll-behavior: auto !important;
		}

		a,
		button,
		img {
			transition-duration: 0.01ms !important;
		}
	}
</style>
