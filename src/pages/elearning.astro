---
import Layout from '../layouts/Layout.astro';

type LearningContent = {
	number: string;
	titleId: string;
	titleEn: string;
	descriptionId: string;
	descriptionEn: string;
};

type Course = {
	titleId: string;
	titleEn: string;
	levelId: string;
	levelEn: string;
	descriptionId: string;
	descriptionEn: string;
	progress: string;
	image: string;
};

const learningContents: LearningContent[] = [
	{
		number: '01',
		titleId: 'Concept Video',
		titleEn: 'Concept Video',
		descriptionId:
			'Video singkat untuk menjelaskan konsep utama dengan visual dan contoh yang mudah diikuti.',
		descriptionEn:
			'Short videos explaining key concepts using clear visuals and easy-to-follow examples.',
	},
	{
		number: '02',
		titleId: 'Worked Example',
		titleEn: 'Worked Example',
		descriptionId:
			'Contoh soal dibahas langkah demi langkah agar siswa memahami proses, bukan hanya jawabannya.',
		descriptionEn:
			'Worked examples are explained step by step so students understand the process, not only the answer.',
	},
	{
		number: '03',
		titleId: 'Practice & Worksheet',
		titleEn: 'Practice & Worksheet',
		descriptionId:
			'Latihan terstruktur untuk membantu siswa menerapkan konsep secara mandiri.',
		descriptionEn:
			'Structured practice helps students apply concepts independently.',
	},
	{
		number: '04',
		titleId: 'Quiz & Progress Check',
		titleEn: 'Quiz & Progress Check',
		descriptionId:
			'Kuis singkat digunakan untuk mengecek pemahaman sebelum melanjutkan ke modul berikutnya.',
		descriptionEn:
			'Short quizzes check understanding before students continue to the next module.',
	},
];

const courses: Course[] = [
	{
		titleId: 'Matematika Dasar',
		titleEn: 'Mathematics Foundations',
		levelId: 'SMP / Lower Secondary',
		levelEn: 'Lower Secondary',
		descriptionId:
			'Konsep, worked examples, latihan, dan quiz untuk membantu siswa membangun fondasi matematika yang lebih kuat.',
		descriptionEn:
			'Concepts, worked examples, practice and quizzes designed to strengthen mathematical foundations.',
		progress: '8 Modules',
		image: '/images/program-academic-class.png',
	},
	{
		titleId: 'Spreadsheet Skills',
		titleEn: 'Spreadsheet Skills',
		levelId: 'ICT / Computing',
		levelEn: 'ICT / Computing',
		descriptionId:
			'Pembelajaran fungsi spreadsheet, formula, data modelling, dan latihan aplikasi secara bertahap.',
		descriptionEn:
			'Step-by-step learning in spreadsheet functions, formulas, data modelling and practical application.',
		progress: '6 Modules',
		image: '/images/multimedia-classroom.png',
	},
	{
		titleId: 'Coding Fundamentals',
		titleEn: 'Coding Fundamentals',
		levelId: 'Coding & Digital',
		levelEn: 'Coding & Digital',
		descriptionId:
			'Belajar logika coding melalui video, project kecil, latihan, dan challenge sederhana.',
		descriptionEn:
			'Learn coding logic through videos, mini projects, practice tasks and simple challenges.',
		progress: '8 Modules',
		image: '/images/program-coding-robotics.png',
	},
];

const whatsappUrl =
	'https://wa.me/6285195511236?text=Halo%20NOVA%20Learning%20Centre%2C%20saya%20ingin%20bertanya%20mengenai%20NOVA%20E-Learning.';
---

<Layout
	title="E-Learning | NOVA Learning Centre"
	description="NOVA E-Learning menghadirkan video pembelajaran, worked examples, worksheet, quiz, dan progress tracking dalam satu alur belajar yang terstruktur."
>
	<main class="overflow-hidden">
		<!-- HERO -->
		<section class="relative bg-[#f7f8fc]">
			<div
				class="absolute -right-24 top-6 h-80 w-80 rounded-full bg-[#f3bc34]/18 blur-3xl"
				aria-hidden="true"
			></div>

			<div class="relative mx-auto grid max-w-7xl items-center gap-14 px-6 py-20 lg:grid-cols-[0.92fr_1.08fr] lg:px-8 lg:py-28">
				<div>
					<p class="section-label">
						NOVA E-Learning
					</p>

					<h1
						class="mt-5 max-w-4xl text-5xl font-extrabold leading-[1.03] tracking-[-0.05em] text-[#1d2f5c] sm:text-6xl lg:text-[70px]"
					>
						<span class="lang-id">
							Belajar mandiri,
							<span class="block">
								tapi tetap&nbsp;
								<span class="relative inline-block">
									terarah.
									<span
										class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/70"
										aria-hidden="true"
									></span>
								</span>
							</span>
						</span>

						<span class="lang-en">
							Learn independently,
							<span class="block">
								with a
								<span class="relative inline-block">
									clear structure.
									<span
										class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/70"
										aria-hidden="true"
									></span>
								</span>
							</span>
						</span>
					</h1>

					<p class="mt-7 max-w-xl text-lg leading-8 text-slate-600">
						<span class="lang-id">
							NOVA E-Learning dirancang agar siswa dapat belajar ulang,
							berlatih, dan mengecek pemahaman kapan saja melalui alur modul
							yang sederhana dan mudah diikuti.
						</span>

						<span class="lang-en">
							NOVA E-Learning is designed so students can revisit concepts,
							practise and check their understanding at any time through a
							simple, structured module flow.
						</span>
					</p>

					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a
							href="#how-it-works"
							class="inline-flex items-center justify-center bg-[#f3bc34] px-6 py-3.5 font-extrabold text-[#1d2f5c] transition hover:-translate-y-0.5 hover:shadow-lg"
						>
							<span class="lang-id">Lihat Cara Kerjanya</span>
							<span class="lang-en">See How It Works</span>
							<span class="ml-2">↓</span>
						</a>

						<a
							href={whatsappUrl}
							target="_blank"
							rel="noreferrer"
							class="inline-flex items-center justify-center border border-[#1d2f5c]/20 bg-white px-6 py-3.5 font-bold text-[#1d2f5c] transition hover:border-[#1d2f5c] hover:bg-[#1d2f5c] hover:text-white"
						>
							<span class="lang-id">Tanya E-Learning</span>
							<span class="lang-en">Ask About E-Learning</span>
						</a>
					</div>
				</div>

				<!-- PLATFORM PREVIEW -->
				<div class="relative">
					<div class="absolute -bottom-5 -left-5 h-24 w-24 bg-[#f3bc34]" aria-hidden="true"></div>

					<div class="relative bg-[#1d2f5c] p-4 shadow-[0_28px_70px_rgba(29,47,92,0.18)]">
						<div class="bg-white p-6">
							<div class="flex items-center justify-between gap-5 border-b border-slate-100 pb-5">
								<div>
									<p class="text-xs font-extrabold uppercase tracking-[0.14em] text-slate-400">
										<span class="lang-id">Lanjutkan Belajar</span>
										<span class="lang-en">Continue Learning</span>
									</p>

									<h2 class="mt-2 text-xl font-extrabold text-[#1d2f5c]">
										<span class="lang-id">Matematika Dasar Kelas 7</span>
										<span class="lang-en">Year 7 Mathematics Foundations</span>
									</h2>
								</div>

								<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#f3bc34] font-bold text-[#1d2f5c]">
									▶
								</div>
							</div>

							<div class="mt-6 grid gap-3 sm:grid-cols-2">
								<div class="border border-slate-200 p-4">
									<p class="text-xs font-extrabold uppercase tracking-[0.12em] text-[#1d2f5c]/45">
										Video
									</p>
									<p class="mt-2 text-sm font-extrabold text-[#1d2f5c]">
										<span class="lang-id">Konsep & Contoh</span>
										<span class="lang-en">Concepts & Examples</span>
									</p>
								</div>

								<div class="border border-slate-200 p-4">
									<p class="text-xs font-extrabold uppercase tracking-[0.12em] text-[#1d2f5c]/45">
										Practice
									</p>
									<p class="mt-2 text-sm font-extrabold text-[#1d2f5c]">
										Worksheet & Quiz
									</p>
								</div>
							</div>

							<div class="mt-6 bg-[#f7f8fc] p-5">
								<div class="flex justify-between gap-4 text-sm">
									<span class="font-bold text-[#1d2f5c]">
										<span class="lang-id">Modul 4 dari 8</span>
										<span class="lang-en">Module 4 of 8</span>
									</span>
									<span class="text-slate-500">50%</span>
								</div>

								<div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-200">
									<div class="h-full w-1/2 rounded-full bg-[#f3bc34]"></div>
								</div>
							</div>

							<p class="mt-5 text-xs leading-6 text-slate-400">
								<span class="lang-id">
									Tampilan di atas merupakan ilustrasi alur belajar E-Learning.
								</span>
								<span class="lang-en">
									The interface above is an illustration of the E-Learning experience.
								</span>
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- HOW IT WORKS -->
		<section id="how-it-works" class="scroll-mt-28 bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-3xl">
					<p class="section-label">
						<span class="lang-id">Cara Kerja</span>
						<span class="lang-en">How It Works</span>
					</p>

					<h2
						class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
					>
						<span class="lang-id">Satu modul. Empat langkah sederhana.</span>
						<span class="lang-en">One module. Four simple steps.</span>
					</h2>

					<p class="mt-5 max-w-2xl text-base leading-7 text-slate-600">
						<span class="lang-id">
							Siswa tidak hanya menonton video. Setiap modul dirancang agar ada
							penjelasan, contoh, latihan, dan pengecekan pemahaman.
						</span>

						<span class="lang-en">
							Students do more than watch videos. Each module combines explanation,
							examples, practice and a quick understanding check.
						</span>
					</p>
				</div>

				<div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
					{
						learningContents.map((item) => (
							<article class="border-t-4 border-[#f3bc34] bg-[#f7f8fc] p-6">
								<p class="text-xs font-black tracking-[0.15em] text-[#1d2f5c]/35">
									{item.number}
								</p>

								<h3 class="mt-5 text-xl font-extrabold text-[#1d2f5c]">
									<span class="lang-id">{item.titleId}</span>
									<span class="lang-en">{item.titleEn}</span>
								</h3>

								<p class="mt-3 text-sm leading-7 text-slate-500">
									<span class="lang-id">{item.descriptionId}</span>
									<span class="lang-en">{item.descriptionEn}</span>
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- WHAT VIDEOS -->
		<section class="bg-[#1d2f5c] py-24 text-white">
			<div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[0.75fr_1.25fr] lg:items-center lg:px-8">
				<div>
					<p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#f3bc34]">
						<span class="lang-id">Video Apa yang Ada?</span>
						<span class="lang-en">What Videos Are Included?</span>
					</p>

					<h2
						class="mt-4 text-4xl font-extrabold tracking-[-0.035em] md:text-5xl"
					>
						<span class="lang-id">
							Video dibuat pendek, fokus, dan langsung ke inti konsep.
						</span>

						<span class="lang-en">
							Videos are short, focused and built around one clear learning goal.
						</span>
					</h2>

					<p class="mt-6 max-w-xl text-lg leading-8 text-white/70">
						<span class="lang-id">
							Tujuannya bukan menggantikan guru dengan video, tetapi memberi siswa
							kesempatan untuk mengulang penjelasan dan contoh kapan pun dibutuhkan.
						</span>

						<span class="lang-en">
							The goal is not to replace teachers with videos, but to give students
							a way to revisit explanations and examples whenever they need them.
						</span>
					</p>
				</div>

				<div class="grid gap-5 sm:grid-cols-2">
					<article class="border border-white/15 bg-white/[0.06] p-6">
						<div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#f3bc34] font-black text-[#1d2f5c]">
							▶
						</div>

						<h3 class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Concept Explainer</span>
							<span class="lang-en">Concept Explainer</span>
						</h3>

						<p class="mt-3 text-sm leading-7 text-white/70">
							<span class="lang-id">
								Penjelasan konsep inti dengan bahasa sederhana, visual, dan contoh
								yang relevan.
							</span>

							<span class="lang-en">
								Key concepts explained using simple language, visuals and relevant examples.
							</span>
						</p>
					</article>

					<article class="border border-white/15 bg-white/[0.06] p-6">
						<div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#f3bc34] font-black text-[#1d2f5c]">
							✓
						</div>

						<h3 class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Worked Example</span>
							<span class="lang-en">Worked Example</span>
						</h3>

						<p class="mt-3 text-sm leading-7 text-white/70">
							<span class="lang-id">
								Contoh pengerjaan langkah demi langkah agar siswa memahami cara
								berpikir di balik solusi.
							</span>

							<span class="lang-en">
								Step-by-step demonstrations that show the thinking behind a solution.
							</span>
						</p>
					</article>

					<article class="border border-white/15 bg-white/[0.06] p-6">
						<div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#f3bc34] font-black text-[#1d2f5c]">
							?
						</div>

						<h3 class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Common Mistakes</span>
							<span class="lang-en">Common Mistakes</span>
						</h3>

						<p class="mt-3 text-sm leading-7 text-white/70">
							<span class="lang-id">
								Pembahasan kesalahan yang sering dilakukan agar siswa lebih sadar
								dengan proses dan strategi belajar.
							</span>

							<span class="lang-en">
								Explanations of common mistakes to help students become more aware
								of their thinking and learning strategies.
							</span>
						</p>
					</article>

					<article class="border border-white/15 bg-white/[0.06] p-6">
						<div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#f3bc34] font-black text-[#1d2f5c]">
							★
						</div>

						<h3 class="mt-5 text-xl font-extrabold">
							<span class="lang-id">Challenge & Extension</span>
							<span class="lang-en">Challenge & Extension</span>
						</h3>

						<p class="mt-3 text-sm leading-7 text-white/70">
							<span class="lang-id">
								Video tambahan untuk siswa yang ingin mencoba soal atau aplikasi
								yang lebih menantang.
							</span>

							<span class="lang-en">
								Extension videos for students ready to try more challenging questions
								or applications.
							</span>
						</p>
					</article>
				</div>
			</div>
		</section>

		<!-- COURSE PREVIEW -->
		<section class="bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
					<div>
						<p class="section-label">
							<span class="lang-id">Contoh Materi</span>
							<span class="lang-en">Sample Learning Areas</span>
						</p>

						<h2
							class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
						>
							<span class="lang-id">Belajar sesuai kebutuhan dan jenjang.</span>
							<span class="lang-en">Learning matched to level and need.</span>
						</h2>
					</div>

					<p class="max-w-xl text-base leading-7 text-slate-600 lg:justify-self-end">
						<span class="lang-id">
							Area berikut merupakan contoh jenis materi yang dapat dikembangkan
							dalam NOVA E-Learning. Ketersediaan modul akan bertambah secara bertahap.
						</span>

						<span class="lang-en">
							The areas below illustrate the types of learning modules being developed
							for NOVA E-Learning. Module availability will expand progressively.
						</span>
					</p>
				</div>

				<div class="mt-12 grid gap-6 md:grid-cols-3">
					{
						courses.map((course) => (
							<article class="group overflow-hidden border border-slate-200 bg-white transition hover:-translate-y-1 hover:border-[#f3bc34] hover:shadow-xl">
								<div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
									<img
										src={course.image}
										alt={course.titleEn}
										class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
										loading="lazy"
									/>

									<div class="absolute inset-0 bg-gradient-to-t from-[#1d2f5c]/65 via-transparent to-transparent"></div>

									<span class="absolute bottom-4 left-4 bg-[#f3bc34] px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-[0.12em] text-[#1d2f5c]">
										{course.progress}
									</span>
								</div>

								<div class="p-6">
									<p class="text-xs font-extrabold uppercase tracking-[0.14em] text-slate-400">
										<span class="lang-id">{course.levelId}</span>
										<span class="lang-en">{course.levelEn}</span>
									</p>

									<h3 class="mt-2 text-xl font-extrabold text-[#1d2f5c]">
										<span class="lang-id">{course.titleId}</span>
										<span class="lang-en">{course.titleEn}</span>
									</h3>

									<p class="mt-3 text-sm leading-7 text-slate-500">
										<span class="lang-id">{course.descriptionId}</span>
										<span class="lang-en">{course.descriptionEn}</span>
									</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- FOR PARENTS -->
		<section class="bg-[#f7f8fc] py-24">
			<div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[0.75fr_1.25fr] lg:px-8">
				<div>
					<p class="section-label">
						<span class="lang-id">Untuk Orang Tua</span>
						<span class="lang-en">For Parents</span>
					</p>

					<h2
						class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
					>
						<span class="lang-id">Bukan sekadar “nonton video”.</span>
						<span class="lang-en">More than simply watching videos.</span>
					</h2>

					<p class="mt-5 max-w-md text-base leading-7 text-slate-600">
						<span class="lang-id">
							Setiap modul dirancang sebagai alur belajar yang jelas supaya siswa
							tahu apa yang harus dilakukan selanjutnya.
						</span>

						<span class="lang-en">
							Each module follows a clear learning sequence so students know what
							to do next.
						</span>
					</p>
				</div>

				<div class="grid gap-px bg-slate-200 sm:grid-cols-2">
					<div class="bg-white p-6">
						<p class="text-lg font-extrabold text-[#1d2f5c]">
							<span class="lang-id">Belajar Ulang Kapan Saja</span>
							<span class="lang-en">Revisit Learning Anytime</span>
						</p>
						<p class="mt-3 text-sm leading-7 text-slate-500">
							<span class="lang-id">
								Siswa dapat mengulang bagian yang belum dipahami tanpa harus menunggu
								pertemuan berikutnya.
							</span>
							<span class="lang-en">
								Students can revisit difficult concepts without waiting for the next lesson.
							</span>
						</p>
					</div>

					<div class="bg-white p-6">
						<p class="text-lg font-extrabold text-[#1d2f5c]">
							<span class="lang-id">Alur yang Terstruktur</span>
							<span class="lang-en">Structured Learning Flow</span>
						</p>
						<p class="mt-3 text-sm leading-7 text-slate-500">
							<span class="lang-id">
								Video, latihan, worksheet, dan quiz ditempatkan dalam urutan yang mudah diikuti.
							</span>
							<span class="lang-en">
								Videos, practice, worksheets and quizzes are organised in a clear sequence.
							</span>
						</p>
					</div>

					<div class="bg-white p-6">
						<p class="text-lg font-extrabold text-[#1d2f5c]">
							<span class="lang-id">Progress Lebih Mudah Dilihat</span>
							<span class="lang-en">Clearer Progress</span>
						</p>
						<p class="mt-3 text-sm leading-7 text-slate-500">
							<span class="lang-id">
								Siswa dapat melihat modul mana yang sudah selesai dan apa yang perlu dilanjutkan.
							</span>
							<span class="lang-en">
								Students can see what they have completed and what comes next.
							</span>
						</p>
					</div>

					<div class="bg-white p-6">
						<p class="text-lg font-extrabold text-[#1d2f5c]">
							<span class="lang-id">Pendamping Tatap Muka</span>
							<span class="lang-en">Supports Face-to-Face Learning</span>
						</p>
						<p class="mt-3 text-sm leading-7 text-slate-500">
							<span class="lang-id">
								E-Learning dapat digunakan sebagai pendamping kelas tatap muka, bukan harus berdiri sendiri.
							</span>
							<span class="lang-en">
