---
import Layout from '../layouts/Layout.astro';

type Founder = {
	name: string;
	roleId: string;
	roleEn: string;
	photo: string;
	descriptionId: string;
	descriptionEn: string;
};

type TeamMember = {
	name: string;
	roleId: string;
	roleEn: string;
	photo: string;
};

type CoreValue = {
	letter: string;
	title: string;
	descriptionId: string;
	descriptionEn: string;
};

const founders: Founder[] = [
	{
		name: 'Olivia Novita',
		roleId: 'Co-Founder',
		roleEn: 'Co-Founder',
		photo: '/images/founder-olivia.png',
		descriptionId:
			'Membawa perspektif bisnis, pengembangan layanan, dan pengalaman pelanggan untuk membantu NOVA tumbuh sebagai learning centre yang relevan bagi keluarga modern.',
		descriptionEn:
			'Brings a business, service development and customer experience perspective to help NOVA grow as a learning centre that is relevant to modern families.',
	},
	{
		name: 'Conan',
		roleId: 'Co-Founder',
		roleEn: 'Co-Founder',
		photo: '/images/founder-conan.png',
		descriptionId:
			'Berperan dalam pengembangan arah bisnis dan pertumbuhan NOVA dengan fokus pada keberlanjutan, kualitas layanan, dan peluang jangka panjang.',
		descriptionEn:
			'Supports NOVA’s business direction and growth with a focus on sustainability, service quality and long-term opportunities.',
	},
];

const team: TeamMember[] = [
	{
		name: 'Halley Kuncoro',
		roleId: 'Academic & Learning Development',
		roleEn: 'Academic & Learning Development',
		photo: '/images/teacher-1.png',
	},
	{
		name: 'Juli Silaen',
		roleId: 'Administration & Student Support',
		roleEn: 'Administration & Student Support',
		photo: '/images/teacher-6.png',
	},
	{
		name: 'Monica Putri Pertiwi',
		roleId: 'Early Years & Primary Educator',
		roleEn: 'Early Years & Primary Educator',
		photo: '/images/teacher-4.png',
	},
	{
		name: 'Karimah Fajriani',
		roleId: 'Science & Mathematics Educator',
		roleEn: 'Science & Mathematics Educator',
		photo: '/images/teacher-5.png',
	},
];

const coreValues: CoreValue[] = [
	{
		letter: 'N',
		title: 'NURTURE',
		descriptionId:
			'Kami menumbuhkan kekuatan unik, kepercayaan diri, dan kecintaan setiap siswa terhadap proses belajar.',
		descriptionEn:
			"We cultivate each student's unique strengths, confidence, and passion for learning.",
	},
	{
		letter: 'O',
		title: 'OPPORTUNITY',
		descriptionId:
			'Kami memberikan kesempatan yang setara bagi setiap siswa untuk tumbuh, bereksplorasi, dan berhasil.',
		descriptionEn:
			'We provide equal opportunities for every student to grow, explore, and succeed.',
	},
	{
		letter: 'V',
		title: 'VISION',
		descriptionId:
			'Kami mendorong siswa untuk melihat melampaui hari ini, menetapkan tujuan yang bermakna, dan menjadi individu yang siap menghadapi masa depan.',
		descriptionEn:
			'We encourage students to think beyond today, set meaningful goals, and become future-ready individuals.',
	},
	{
		letter: 'A',
		title: 'ACHIEVEMENT',
		descriptionId:
			'Kami menghargai kemajuan, ketekunan, dan keunggulan dalam perkembangan akademik maupun pribadi.',
		descriptionEn:
			'We celebrate progress, perseverance, and excellence in both academic and personal development.',
	},
];
---

<Layout
	title="Tentang NOVA | NOVA Learning Centre"
	description="Kenali cerita, visi, misi, tim, dan nilai inti NOVA Learning Centre."
>
	<main class="overflow-hidden">
		<!-- HERO -->
		<section class="relative bg-white">
			<div
				class="absolute -right-24 top-10 h-80 w-80 rounded-full bg-[#f3bc34]/15 blur-3xl"
				aria-hidden="true"
			></div>

			<div class="relative mx-auto max-w-7xl px-6 pb-16 pt-20 lg:px-8 lg:pb-24 lg:pt-28">
				<div class="grid gap-12 lg:grid-cols-[1.18fr_0.82fr] lg:items-end">
					<div class="reveal">
						<p class="section-label">
							<span class="lang-id">Tentang NOVA</span>
							<span class="lang-en">About NOVA</span>
						</p>

						<h1
							class="mt-5 max-w-5xl text-5xl font-extrabold leading-[1.03] tracking-[-0.05em] text-[#1d2f5c] sm:text-6xl lg:text-[74px]"
						>
							<span class="lang-id">
								Kami tidak hanya membantu siswa
								<span class="relative inline-block">
									menjawab soal.
									<span
										class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/70"
										aria-hidden="true"
									></span>
								</span>
							</span>

							<span class="lang-en">
								We do more than help students&nbsp;
								<span class="relative inline-block">
									find answers.
									<span
										class="absolute -bottom-1 left-0 h-2 w-full bg-[#f3bc34]/70"
										aria-hidden="true"
									></span>
								</span>
							</span>
						</h1>
					</div>

					<div class="reveal border-l-4 border-[#f3bc34] pl-6">
						<p class="text-lg leading-8 text-slate-600">
							<span class="lang-id">
								NOVA dibangun untuk membantu siswa memahami
								<strong class="font-bold text-[#1d2f5c]">cara belajar</strong>,
								bukan hanya apa yang harus dipelajari.
							</span>

							<span class="lang-en">
								NOVA was built to help students understand
								<strong class="font-bold text-[#1d2f5c]">how to learn</strong>,
								not only what to learn.
							</span>
						</p>
					</div>
				</div>

				<div class="reveal mt-14 border-y border-slate-200 py-6">
					<div class="flex flex-wrap items-center gap-x-7 gap-y-3 text-sm font-semibold text-slate-500">
						<span class="text-[#1d2f5c]">NOVA Learning Centre</span>
						<span class="hidden h-1 w-1 rounded-full bg-[#f3bc34] sm:block"></span>
						<span>Academic Learning</span>
						<span class="hidden h-1 w-1 rounded-full bg-[#f3bc34] sm:block"></span>
						<span>Skills & Enrichment</span>
						<span class="hidden h-1 w-1 rounded-full bg-[#f3bc34] sm:block"></span>
						<span>E-Learning</span>
					</div>
				</div>
			</div>
		</section>

		<!-- OUR STORY -->
		<section class="bg-[#f7f8fc] py-24">
			<div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
				<div class="reveal">
					<p class="section-label">
						<span class="lang-id">Cerita Kami</span>
						<span class="lang-en">Our Story</span>
					</p>

					<h2
						class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
					>
						<span class="lang-id">NOVA lahir dari sebuah pertanyaan sederhana.</span>
						<span class="lang-en">NOVA began with a simple question.</span>
					</h2>
				</div>

				<div class="reveal space-y-6 text-lg leading-8 text-slate-600">
					<p>
						<span class="lang-id">
							Bagaimana jika sebuah learning centre tidak hanya membantu siswa
							menyelesaikan pelajaran hari ini, tetapi juga membantu mereka
							membangun cara berpikir, kebiasaan belajar, dan kepercayaan diri
							untuk masa depan?
						</span>

						<span class="lang-en">
							What if a learning centre could do more than help students complete
							today’s lessons — and instead help them build stronger thinking
							skills, learning habits and confidence for the future?
						</span>
					</p>

					<p>
						<span class="lang-id">
							Dari pemikiran tersebut, NOVA dirancang sebagai ruang belajar yang
							memadukan pendampingan pengajar, kelompok kecil, pembelajaran aktif,
							teknologi, serta program pengayaan yang relevan dengan perkembangan
							anak dan remaja.
						</span>

						<span class="lang-en">
							From that idea, NOVA was designed as a learning space that combines
							teacher guidance, small groups, active learning, technology and
							enrichment programs relevant to children and teenagers.
						</span>
					</p>

					<p class="font-bold text-[#1d2f5c]">
						Inspiring Young Minds, Building Bright Futures.
					</p>
				</div>
			</div>
		</section>

		<!-- FOUNDING TEAM -->
		

		<!-- NOVA NAME + VALUES -->
		<section class="bg-[#1d2f5c] py-24 text-white">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-[0.78fr_1.22fr]">
					<div class="reveal">
						<p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#f3bc34]">
							<span class="lang-id">Arti NOVA</span>
							<span class="lang-en">What NOVA Stands For</span>
						</p>

						<h2
							class="mt-4 text-4xl font-extrabold tracking-[-0.035em] md:text-5xl"
						>
							<span class="lang-id">
								Empat nilai yang membentuk cara kami bertumbuh.
							</span>

							<span class="lang-en">
								Four values that shape the way we grow.
							</span>
						</h2>

						<p class="mt-6 max-w-xl text-lg leading-8 text-white/70">
							<span class="lang-id">
								Nama NOVA bukan hanya identitas. Setiap huruf mewakili prinsip
								yang ingin kami hadirkan dalam pengalaman belajar setiap siswa.
							</span>

							<span class="lang-en">
								NOVA is more than a name. Each letter represents a principle
								we want every student to experience throughout their learning
								journey.
							</span>
						</p>
					</div>

					<div class="grid gap-4 sm:grid-cols-2">
						{
							coreValues.map((value) => (
								<article class="value-card reveal border border-white/15 bg-white/[0.06] p-6 transition hover:-translate-y-1 hover:border-[#f3bc34] hover:bg-white/[0.09]">
									<div class="flex items-center gap-4">
										<div class="flex h-14 w-14 shrink-0 items-center justify-center bg-[#f3bc34] text-2xl font-black text-[#1d2f5c]">
											{value.letter}
										</div>

										<h3 class="text-xl font-extrabold">{value.title}</h3>
									</div>

									<p class="mt-5 text-sm leading-7 text-white/72">
										<span class="lang-id">{value.descriptionId}</span>
										<span class="lang-en">{value.descriptionEn}</span>
									</p>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- VISION & MISSION -->
		<section class="bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="reveal text-center">
					<p class="section-label justify-center">
						<span class="lang-id">Visi & Misi</span>
						<span class="lang-en">Vision & Mission</span>
					</p>

					<h2
						class="mx-auto mt-4 max-w-4xl text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
					>
						<span class="lang-id">
							Membangun pengalaman belajar yang relevan untuk hari ini dan masa depan.
						</span>

						<span class="lang-en">
							Building learning experiences that are relevant for today and the future.
						</span>
					</h2>
				</div>

				<div class="mt-12 grid gap-5 lg:grid-cols-2">
					<article class="reveal border-t-4 border-[#f3bc34] bg-[#f7f8fc] p-8 md:p-10">
						<p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#1d2f5c]/50">
							<span class="lang-id">Visi</span>
							<span class="lang-en">Vision</span>
						</p>

						<h3 class="mt-5 text-2xl font-extrabold leading-9 text-[#1d2f5c]">
							<span class="lang-id">
								Menjadi learning centre yang membantu siswa tumbuh menjadi
								pembelajar yang percaya diri, mandiri, dan siap menghadapi masa depan.
							</span>

							<span class="lang-en">
								To be a learning centre that helps students grow into confident,
								independent and future-ready learners.
							</span>
						</h3>
					</article>

					<article class="reveal border-t-4 border-[#1d2f5c] bg-[#f7f8fc] p-8 md:p-10">
						<p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#1d2f5c]/50">
							<span class="lang-id">Misi</span>
							<span class="lang-en">Mission</span>
						</p>

						<ul class="mt-5 grid gap-4 text-base leading-7 text-slate-600">
							<li class="flex gap-3">
								<span class="mt-2 h-2 w-2 shrink-0 bg-[#f3bc34]"></span>
								<span class="lang-id">
									Memberikan pembelajaran yang terarah, personal, dan relevan
									dengan kebutuhan siswa.
								</span>
								<span class="lang-en">
									Provide focused, personalised learning that responds to each
									student's needs.
								</span>
							</li>

							<li class="flex gap-3">
								<span class="mt-2 h-2 w-2 shrink-0 bg-[#f3bc34]"></span>
								<span class="lang-id">
									Membangun lingkungan yang aman untuk bertanya, mencoba,
									berkolaborasi, dan berkembang.
								</span>
								<span class="lang-en">
									Build a safe environment to ask, explore, collaborate and grow.
								</span>
							</li>

							<li class="flex gap-3">
								<span class="mt-2 h-2 w-2 shrink-0 bg-[#f3bc34]"></span>
								<span class="lang-id">
									Menggabungkan kualitas pengajar, pembelajaran aktif, dan
									teknologi untuk mendukung perkembangan siswa.
								</span>
								<span class="lang-en">
									Combine strong educators, active learning and technology to
									support student development.
								</span>
							</li>
						</ul>
					</article>
				</div>
			</div>
		</section>

		<!-- MEET THE TEAM -->
		<section id="team" class="bg-[#f7f8fc] py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="reveal">
					<p class="section-label">
						Meet the Team
					</p>

					<h2
						class="mt-4 max-w-4xl text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
					>
						<span class="lang-id">
							Orang-orang yang membantu NOVA berjalan setiap hari.
						</span>

						<span class="lang-en">
							The people who help NOVA move forward every day.
						</span>
					</h2>

					<p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
						<span class="lang-id">
							Dari pengembangan akademik hingga dukungan siswa, setiap anggota tim
							memiliki peran untuk menciptakan pengalaman belajar yang lebih baik.
						</span>

						<span class="lang-en">
							From academic development to student support, every member of the
							team contributes to creating a better learning experience.
						</span>
					</p>
				</div>

				<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
					{
						team.map((member) => (
							<article class="team-card reveal overflow-hidden border border-slate-200 bg-white transition hover:-translate-y-1 hover:border-[#f3bc34] hover:shadow-xl">
								<div class="relative aspect-[4/4.6] bg-[#f3bc34]">
									<img
										src={member.photo}
										alt={member.name}
										class="absolute inset-0 h-full w-full object-cover"
										loading="lazy"
									/>
								</div>

								<div class="p-5">
									<h3 class="text-lg font-extrabold text-[#1d2f5c]">
										{member.name}
									</h3>

									<p class="mt-2 text-sm leading-6 text-slate-500">
										<span class="lang-id">{member.roleId}</span>
										<span class="lang-en">{member.roleEn}</span>
									</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="bg-[#f3bc34] py-20">
			<div class="reveal mx-auto max-w-4xl px-6 text-center">
				<p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#1d2f5c]/60">
					<span class="lang-id">Kenal Lebih Dekat</span>
					<span class="lang-en">Get to Know NOVA</span>
				</p>

				<h2
					class="mt-4 text-4xl font-extrabold tracking-[-0.035em] text-[#1d2f5c] md:text-5xl"
				>
					<span class="lang-id">
						Mari tumbuh dan belajar bersama NOVA.
					</span>

					<span class="lang-en">
						Learn and grow with NOVA.
					</span>
				</h2>

				<a
					href="/contact"
					class="mt-8 inline-flex rounded-lg bg-[#1d2f5c] px-8 py-4 font-bold text-white transition hover:-translate-y-0.5 hover:shadow-xl"
				>
					<span class="lang-id">Temukan Program NOVA</span>
					<span class="lang-en">Discover NOVA Programs</span>
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
	const revealElements = document.querySelectorAll<HTMLElement>('.reveal');

	if ('IntersectionObserver' in window) {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.12 },
		);

		revealElements.forEach((element) => revealObserver.observe(element));
	} else {
		revealElements.forEach((element) => element.classList.add('is-visible'));
	}
</script>

<style>
	.section-label {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.875rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: #1d2f5c;
	}

	.section-label::before {
		content: '';
		width: 2.2rem;
		height: 0.22rem;
		background: #f3bc34;
	}

	.reveal {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 650ms ease,
			transform 650ms ease;
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.founder-card img,
	.team-card img {
		transition: transform 500ms ease;
	}

	.founder-card:hover img,
	.team-card:hover img {
		transform: scale(1.035);
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			opacity: 1;
			transform: none;
		}
	}
</style>
