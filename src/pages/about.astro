---
import Layout from '../layouts/Layout.astro';

const currentYear = new Date().getFullYear();

const navItems = [
	{ name: 'Beranda', href: '/' },
	{ name: 'Tentang Kami', href: '/about' },
	{ name: 'Program', href: '/programs' },
	{ name: 'Fasilitas', href: '/facilities' },
	{ name: 'E-Learning', href: '/elearning' },
	{ name: 'Kontak', href: '/contact' },
];

const pillars = [
	{
		number: '01',
		title: 'Clarity',
		kicker: 'Belajar dengan arah',
		description:
			'Siswa memahami apa yang dipelajari, mengapa hal itu penting, dan apa langkah berikutnya.',
	},
	{
		number: '02',
		title: 'Agency',
		kicker: 'Aktif dalam proses',
		description:
			'Siswa diberi ruang untuk bertanya, mencoba, memilih strategi, dan menjelaskan pemahamannya.',
	},
	{
		number: '03',
		title: 'Growth',
		kicker: 'Kemajuan yang nyata',
		description:
			'Fokus kami bukan sekadar selesai materi, tetapi perkembangan pemahaman, kebiasaan, dan kepercayaan diri.',
	},
];

const learningStages = [
	{
		label: 'Understand',
		title: 'Pahami kebutuhannya',
		text:
			'Kami melihat kondisi awal siswa, tujuan belajar, tantangan utama, dan pola belajar yang sudah terbentuk.',
	},
	{
		label: 'Guide',
		title: 'Berikan arah yang tepat',
		text:
			'Pengajar memberi struktur, penjelasan, contoh, dan feedback sesuai kebutuhan—tidak terlalu sedikit, tidak berlebihan.',
	},
	{
		label: 'Explore',
		title: 'Biarkan siswa aktif',
		text:
			'Siswa mencoba, berdiskusi, berlatih, memecahkan masalah, dan membangun pemahaman melalui pengalaman.',
	},
	{
		label: 'Reflect',
		title: 'Tinjau dan lanjutkan',
		text:
			'Perkembangan ditinjau agar langkah belajar berikutnya tetap relevan dan menantang.',
	},
];

const commitments = [
	'Kelas kelompok kecil agar interaksi lebih dekat.',
	'Pendampingan akademik yang tetap membangun kemandirian.',
	'Komunikasi perkembangan belajar yang jelas.',
	'Pembelajaran onsite dan digital yang saling terhubung.',
	'Lingkungan belajar yang aman untuk bertanya dan mencoba.',
];

const footerLinks = [
	{ name: 'Beranda', href: '/' },
	{ name: 'Tentang Kami', href: '/about' },
	{ name: 'Program', href: '/programs' },
	{ name: 'Fasilitas', href: '/facilities' },
	{ name: 'E-Learning', href: '/elearning' },
	{ name: 'Kontak', href: '/contact' },
];
---

<Layout
	title="Tentang Kami | NOVA Learning Centre"
	description="Kenali NOVA Learning Centre, filosofi pembelajaran, pendekatan, dan cara kami membantu siswa belajar lebih terarah dan percaya diri."
>
	<!-- NAVBAR -->
	<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
		<nav
			class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8"
			aria-label="Navigasi utama"
		>
			<a href="/" class="flex items-center" aria-label="NOVA Learning Centre">
				<img
					src="/images/primary-logo-icon.png"
					alt="NOVA Learning Centre"
					class="h-10 w-10 object-contain sm:hidden"
				/>

				<img
					src="/images/primary-logo.png"
					alt="NOVA Learning Centre"
					class="hidden h-11 w-auto object-contain sm:block"
				/>
			</a>

			<div class="hidden items-center gap-7 lg:flex">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class:list={[
								'text-sm font-semibold transition',
								item.href === '/about'
									? 'text-[#0F2747]'
									: 'text-slate-600 hover:text-[#A87300]',
							]}
						>
							{item.name}
						</a>
					))
				}
			</div>

			<a
				href="/contact"
				class="hidden rounded-xl bg-[#F3BC34] px-5 py-3 text-sm font-bold text-[#0F2747] transition hover:bg-[#DFA722] lg:inline-flex"
			>
				Konsultasi Gratis
			</a>

			<button
				id="mobile-menu-button"
				type="button"
				class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-300 bg-white text-[#0F2747] lg:hidden"
				aria-label="Buka menu navigasi"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg
					width="23"
					height="23"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16"></path>
					<path d="M4 12h16"></path>
					<path d="M4 17h16"></path>
				</svg>
			</button>
		</nav>

		<div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-5 lg:hidden">
			<div class="flex flex-col gap-4">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class="mobile-nav-link text-sm font-semibold text-slate-700 transition hover:text-[#A87300]"
						>
							{item.name}
						</a>
					))
				}

				<a
					href="/contact"
					class="mobile-nav-link mt-2 rounded-xl bg-[#F3BC34] px-5 py-3 text-center text-sm font-bold text-[#0F2747]"
				>
					Konsultasi Gratis
				</a>
			</div>
		</div>
	</header>

	<main>
		<!-- EDITORIAL HERO -->
		<section class="bg-white">
			<div class="mx-auto max-w-7xl px-6 pb-16 pt-20 lg:px-8 lg:pb-24 lg:pt-28">
				<div class="grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							Tentang NOVA
						</p>

						<h1
							class="mt-5 max-w-5xl text-5xl font-bold leading-[1.02] tracking-[-0.05em] text-[#0F2747] sm:text-6xl lg:text-[78px]"
						>
							Kami tidak hanya membantu siswa
							<span class="text-[#A87300]">menjawab soal.</span>
						</h1>
					</div>

					<div class="border-l-4 border-[#F3BC34] pl-6">
						<p class="text-lg leading-8 text-slate-600">
							NOVA dibangun untuk membantu siswa memahami
							<strong class="font-semibold text-[#0F2747]">cara belajar</strong>,
							bukan hanya apa yang harus dipelajari.
						</p>
					</div>
				</div>

				<div class="mt-16 border-y border-slate-200 py-6">
					<div class="flex flex-wrap items-center gap-x-8 gap-y-3 text-sm font-semibold text-slate-500">
						<span class="text-[#0F2747]">NOVA Learning Centre</span>
						<span class="hidden h-1 w-1 rounded-full bg-slate-300 sm:block"></span>
						<span>Kelapa Gading</span>
						<span class="hidden h-1 w-1 rounded-full bg-slate-300 sm:block"></span>
						<span>Academic Support</span>
						<span class="hidden h-1 w-1 rounded-full bg-slate-300 sm:block"></span>
						<span>Skills Development</span>
						<span class="hidden h-1 w-1 rounded-full bg-slate-300 sm:block"></span>
						<span>Digital Learning</span>
					</div>
				</div>
			</div>
		</section>

		<!-- BRAND MANIFESTO -->
		<section class="bg-[#0F2747] text-white">
			<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
				<div class="grid gap-16 lg:grid-cols-[0.7fr_1.3fr]">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#F3BC34]">
							Our Belief
						</p>

						<p class="mt-5 text-sm leading-7 text-blue-100">
							Prinsip sederhana yang menjadi dasar cara kami merancang pengalaman belajar.
						</p>
					</div>

					<div>
						<p class="max-w-4xl text-3xl font-semibold leading-[1.35] tracking-tight text-white md:text-4xl lg:text-5xl">
							Siswa berkembang paling baik ketika mereka mendapat
							<span class="text-[#F3BC34]">arah yang jelas</span>,
							tetapi tetap memiliki ruang untuk
							<span class="text-[#F3BC34]">berpikir, mencoba, dan menemukan.</span>
						</p>

						<div class="mt-12 grid gap-8 border-t border-white/15 pt-10 md:grid-cols-2">
							<p class="text-base leading-8 text-blue-100">
								Karena itu, pembelajaran di NOVA tidak sepenuhnya teacher-centered dan tidak juga
								melepas siswa belajar sendiri tanpa struktur.
							</p>

							<p class="text-base leading-8 text-blue-100">
								Pengajar memberi kerangka dan dukungan yang dibutuhkan, sementara siswa tetap aktif
								mengambil bagian dalam proses belajarnya.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- THREE PILLARS -->
		<section class="bg-[#F7F8FC] py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							Apa yang Kami Bangun
						</p>

						<h2 class="mt-4 text-4xl font-bold tracking-tight text-[#0F2747] md:text-5xl">
							Bukan hanya nilai.
						</h2>

						<p class="mt-5 max-w-md text-lg leading-8 text-slate-600">
							Hasil akademik penting, tetapi cara siswa sampai ke sana juga penting.
						</p>
					</div>

					<div class="divide-y divide-slate-200 border-y border-slate-200">
						{
							pillars.map((pillar) => (
								<article class="grid gap-5 py-8 sm:grid-cols-[76px_1fr] sm:items-start">
									<div class="text-4xl font-bold tracking-tight text-[#F3BC34]">
										{pillar.number}
									</div>

									<div class="grid gap-4 md:grid-cols-[0.8fr_1.2fr]">
										<div>
											<p class="text-xs font-bold uppercase tracking-[0.18em] text-[#A87300]">
												{pillar.title}
											</p>

											<h3 class="mt-2 text-2xl font-bold text-[#0F2747]">
												{pillar.kicker}
											</h3>
										</div>

										<p class="text-base leading-7 text-slate-600">
											{pillar.description}
										</p>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- STORY / WHY NOVA -->
		<section class="bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-14 lg:grid-cols-2 lg:items-start">
					<div class="lg:sticky lg:top-28">
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							Mengapa NOVA Ada
						</p>

						<h2 class="mt-4 max-w-xl text-4xl font-bold tracking-tight text-[#0F2747] md:text-5xl">
							Karena banyak siswa sebenarnya mampu—mereka hanya belum menemukan cara belajar yang tepat.
						</h2>
					</div>

					<div class="space-y-10">
						<div class="border-l border-slate-200 pl-7">
							<p class="text-xl leading-9 text-[#0F2747]">
								Ada siswa yang memahami konsep setelah satu penjelasan. Ada yang membutuhkan visual,
								contoh konkret, diskusi, atau kesempatan mencoba beberapa kali.
							</p>
						</div>

						<div class="border-l border-slate-200 pl-7">
							<p class="text-base leading-8 text-slate-600">
								Perbedaan itu bukan masalah. Tantangannya adalah memastikan siswa tetap mendapat
								struktur yang cukup, tanpa membuat mereka terlalu bergantung pada pengajar.
							</p>
						</div>

						<div class="border-l border-[#F3BC34] pl-7">
							<p class="text-base leading-8 text-slate-600">
								NOVA dibangun untuk menemukan keseimbangan tersebut: pengajar hadir ketika siswa
								membutuhkan arah, kemudian perlahan memberi ruang agar siswa semakin mampu mengambil
								tanggung jawab atas proses belajarnya sendiri.
							</p>
						</div>

						<div class="rounded-2xl bg-[#F3BC34] p-7">
							<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0F2747]/55">
								Tujuan Kami
							</p>

							<p class="mt-3 text-2xl font-bold leading-tight text-[#0F2747]">
								Membantu siswa menjadi lebih paham, lebih mandiri, dan lebih percaya diri.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- LEARNING METHOD -->
		<section class="bg-[#0F2747] py-24 text-white">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="max-w-3xl">
					<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#F3BC34]">
						How Learning Happens
					</p>

					<h2 class="mt-4 text-4xl font-bold tracking-tight md:text-5xl">
						Empat langkah. Satu proses yang terus berulang.
					</h2>
				</div>

				<div class="mt-16">
					{
						learningStages.map((stage, index) => (
							<article class="grid gap-6 border-t border-white/15 py-8 md:grid-cols-[90px_0.7fr_1.3fr] md:items-start">
								<div class="text-sm font-bold text-[#F3BC34]">
									0{index + 1}
								</div>

								<div>
									<p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-300">
										{stage.label}
									</p>

									<h3 class="mt-2 text-2xl font-bold">
										{stage.title}
									</h3>
								</div>

								<p class="max-w-2xl text-base leading-8 text-blue-100">
									{stage.text}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- COMMITMENT -->
		<section class="bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-14 lg:grid-cols-[1fr_1fr]">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							Komitmen NOVA
						</p>

						<h2 class="mt-4 text-4xl font-bold tracking-tight text-[#0F2747] md:text-5xl">
							Pengalaman belajar yang terasa dekat, jelas, dan relevan.
						</h2>

						<p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
							Kami merancang pengalaman belajar yang tidak terasa seperti kelas tambahan yang
							berulang, tetapi sebagai ruang untuk memahami, berkembang, dan membangun kebiasaan baru.
						</p>
					</div>

					<div class="divide-y divide-slate-200 border-y border-slate-200">
						{
							commitments.map((commitment, index) => (
								<div class="flex items-start gap-5 py-5">
									<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#F3BC34] text-xs font-bold text-[#0F2747]">
										{index + 1}
									</span>

									<p class="text-base font-medium leading-7 text-[#0F2747]">
										{commitment}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- ECOSYSTEM BAND -->
		<section class="border-y border-slate-200 bg-[#F7F8FC]">
			<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							NOVA Learning Ecosystem
						</p>

						<h2 class="mt-4 text-4xl font-bold tracking-tight text-[#0F2747] md:text-5xl">
							Belajar tidak berhenti ketika kelas selesai.
						</h2>
					</div>

					<div class="grid gap-4 sm:grid-cols-3">
						<div class="border-l-2 border-[#0F2747] pl-5">
							<p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">
								Onsite
							</p>
							<p class="mt-2 font-bold text-[#0F2747]">
								Learn & Discuss
							</p>
						</div>

						<div class="border-l-2 border-[#F3BC34] pl-5">
							<p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">
								Practice
							</p>
							<p class="mt-2 font-bold text-[#0F2747]">
								Review & Apply
							</p>
						</div>

						<div class="border-l-2 border-[#0F2747] pl-5">
							<p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">
								E-Learning
							</p>
							<p class="mt-2 font-bold text-[#0F2747]">
								Continue Anytime
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="grid gap-8 border-t-4 border-[#F3BC34] pt-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.22em] text-[#A87300]">
							Kenali NOVA Lebih Dekat
						</p>

						<h2 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-[#0F2747] md:text-5xl">
							Temukan lingkungan belajar yang sesuai untuk perkembangan siswa.
						</h2>
					</div>

					<div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
						<a
							href="/programs"
							class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-6 py-3.5 font-semibold text-[#0F2747] transition hover:border-[#0F2747]"
						>
							Lihat Program
						</a>

						<a
							href="/contact"
							class="inline-flex items-center justify-center rounded-xl bg-[#F3BC34] px-6 py-3.5 font-bold text-[#0F2747] transition hover:bg-[#DFA722]"
						>
							Konsultasi Gratis
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- FOOTER -->
	<footer class="bg-[#091D36] text-white">
		<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-[1.4fr_0.8fr_1fr]">
				<div>
					<a href="/" aria-label="NOVA Learning Centre">
						<img
							src="/images/primary-logo.png"
							alt="NOVA Learning Centre"
							class="h-14 w-auto brightness-0 invert"
						/>
					</a>

					<p class="mt-6 max-w-md text-sm leading-7 text-blue-100">
						Pusat pembelajaran modern untuk anak, remaja, dan pembelajar
						sepanjang hayat melalui kelas tatap muka dan e-learning.
					</p>

					<p class="mt-6 text-sm font-semibold text-[#F3BC34]">
						Learn with purpose. Grow with confidence.
					</p>
				</div>

				<div>
					<h3 class="text-sm font-bold uppercase tracking-[0.18em] text-[#F3BC34]">
						Navigasi
					</h3>

					<div class="mt-6 grid gap-3">
						{
							footerLinks.map((item) => (
								<a href={item.href} class="text-sm text-blue-100 transition hover:text-white">
									{item.name}
								</a>
							))
						}
					</div>
				</div>

				<div>
					<h3 class="text-sm font-bold uppercase tracking-[0.18em] text-[#F3BC34]">
						Hubungi Kami
					</h3>

					<div class="mt-6 space-y-5 text-sm text-blue-100">
						<div>
							<p class="font-semibold text-white">Lokasi</p>
							<p class="mt-1 leading-6">Kelapa Gading, Jakarta Utara</p>
						</div>

						<div>
							<p class="font-semibold text-white">Email</p>
							<a
								href="mailto:novalearningcentre@gmail.com"
								class="mt-1 block break-all transition hover:text-white"
							>
								novalearningcentre@gmail.com
							</a>
						</div>

						<div>
							<p class="font-semibold text-white">
								Phone
							</p>

							<a
								href="https://wa.me/6285195511236"
								class="mt-1 block break-all transition hover:text-white"
							>
								+62 851 9551 1236
							</a>
						</div>

						<a
							href="/contact"
							class="inline-flex bg-[#F3BC34] px-5 py-3 font-bold text-[#0F2747] transition hover:bg-[#DFA722]"
						>
							Hubungi NOVA
						</a>
					</div>
				</div>
			</div>

			<div
				class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-7 text-xs text-blue-200 sm:flex-row sm:items-center sm:justify-between"
			>
				<p>© {currentYear} NOVA Learning Centre. All rights reserved.</p>

				<div class="flex gap-5">
					<a href="/privacy" class="transition hover:text-white">
						Kebijakan Privasi
					</a>

					<a href="/terms" class="transition hover:text-white">
						Syarat & Ketentuan
					</a>
				</div>
			</div>
		</div>
	</footer>
</Layout>

<script>
	const mobileMenuButton =
		document.querySelector<HTMLButtonElement>('#mobile-menu-button');
	const mobileMenu =
		document.querySelector<HTMLElement>('#mobile-menu');
	const mobileNavLinks =
		document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

	const closeMobileMenu = () => {
		mobileMenu?.classList.add('hidden');
		mobileMenuButton?.setAttribute('aria-expanded', 'false');
	};

	mobileMenuButton?.addEventListener('click', () => {
		const isNowHidden = mobileMenu?.classList.toggle('hidden') ?? true;
		mobileMenuButton.setAttribute('aria-expanded', String(!isNowHidden));
	});

	mobileNavLinks.forEach((link) => {
		link.addEventListener('click', closeMobileMenu);
	});
</script>

