---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'NOVA Learning Centre',
	description = 'Inspiring Young Minds, Building Bright Futures.',
} = Astro.props;

const currentYear = new Date().getFullYear();

const navItems = [
	{ nameId: 'Beranda', nameEn: 'Home', href: '/' },
	{ nameId: 'Tentang Kami', nameEn: 'About Us', href: '/about' },
	{ nameId: 'Program', nameEn: 'Programs', href: '/programs' },
	{ nameId: 'Fasilitas', nameEn: 'Facilities', href: '/facilities' },
	{ nameId: 'E-Learning', nameEn: 'E-Learning', href: '/elearning' },
	{ nameId: 'Kontak', nameEn: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActivePage = (href: string) => {
	if (href === '/') return currentPath === '/';
	return currentPath === href || currentPath.startsWith(`${href}/`);
};

const mapsUrl =
	'https://maps.app.goo.gl/V71v81TpoHjW266z9';

const whatsappUrl =
	'https://wa.me/6285195511236?text=Halo%20NOVA%20Learning%20Centre%2C%20saya%20ingin%20bertanya%20mengenai%20program%20belajar.';
---

<!doctype html>
<html lang="id" data-lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />

		<link rel="icon" type="image/png" href="/images/primary-logo-icon.png" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<title>{title}</title>

		<script is:inline>
			try {
				const savedLanguage = localStorage.getItem('nova-language');
				if (savedLanguage === 'en' || savedLanguage === 'id') {
					document.documentElement.dataset.lang = savedLanguage;
					document.documentElement.lang =
						savedLanguage === 'en' ? 'en-AU' : 'id';
				}
			} catch {
				// Keep Indonesian as default.
			}
		</script>
	</head>

	<body>
		<!-- HEADER / NAVIGATION -->
		<header
			class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-xl"
		>
			<nav
				class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-3 lg:px-8"
				aria-label="Main navigation"
			>
				<a
					href="/"
					class="flex shrink-0 items-center"
					aria-label="NOVA Learning Centre"
				>
					<img
						src="/images/primary-logo.png"
						alt="NOVA Learning Centre"
						class="h-16 w-auto object-contain sm:h-20"
					/>
				</a>

				<div class="hidden items-center gap-1 lg:flex">
					{
						navItems.map((item) => {
							const active = isActivePage(item.href);

							return (
								<a
									href={item.href}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'rounded-lg px-3.5 py-2.5 text-sm font-semibold transition',
										active
											? 'bg-[#f3bc34] text-[#1d2f5c] shadow-sm'
											: 'text-[#1d2f5c]/75 hover:bg-[#1d2f5c]/5 hover:text-[#1d2f5c]',
									]}
								>
									<span class="lang-id">{item.nameId}</span>
									<span class="lang-en">{item.nameEn}</span>
								</a>
							);
						})
					}
				</div>

				<div class="hidden items-center gap-3 lg:flex">
					<div
						class="language-switcher flex items-center rounded-lg border border-slate-200 bg-slate-50 p-1"
						aria-label="Language"
					>
						<button
							type="button"
							data-language="id"
							class="language-button rounded-md px-3 py-2 text-xs font-bold"
							aria-pressed="true"
						>
							IDN
						</button>

						<button
							type="button"
							data-language="en"
							class="language-button rounded-md px-3 py-2 text-xs font-bold"
							aria-pressed="false"
						>
							ENG
						</button>
					</div>

					<a
						href="/contact"
						class="inline-flex rounded-lg bg-[#f3bc34] px-5 py-3 text-sm font-bold text-[#1d2f5c] transition hover:-translate-y-0.5 hover:shadow-lg"
					>
						<span class="lang-id">Konsultasi Gratis</span>
						<span class="lang-en">Free Consultation</span>
					</a>
				</div>

				<button
					id="mobile-menu-button"
					type="button"
					class="flex h-11 w-11 items-center justify-center rounded-lg border border-slate-200 bg-white text-[#1d2f5c] lg:hidden"
					aria-label="Open navigation"
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<svg
						width="23"
						height="23"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M4 7h16"></path>
						<path d="M4 12h16"></path>
						<path d="M4 17h16"></path>
					</svg>
				</button>
			</nav>

			<!-- MOBILE MENU -->
			<div
				id="mobile-menu"
				class="hidden border-t border-slate-200 bg-white px-6 py-5 lg:hidden"
			>
				<div class="flex flex-col gap-2">
					{
						navItems.map((item) => {
							const active = isActivePage(item.href);

							return (
								<a
									href={item.href}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'mobile-nav-link rounded-lg px-4 py-3 text-sm font-semibold',
										active
											? 'bg-[#f3bc34] text-[#1d2f5c]'
											: 'text-slate-700 hover:bg-slate-50',
									]}
								>
									<span class="lang-id">{item.nameId}</span>
									<span class="lang-en">{item.nameEn}</span>
								</a>
							);
						})
					}

					<div
						class="mt-3 flex items-center justify-between border-t border-slate-100 pt-4"
					>
						<div
							class="language-switcher flex items-center rounded-lg border border-slate-200 bg-slate-50 p-1"
						>
							<button
								type="button"
								data-language="id"
								class="language-button rounded-md px-3 py-2 text-xs font-bold"
								aria-pressed="true"
							>
								IDN
							</button>

							<button
								type="button"
								data-language="en"
								class="language-button rounded-md px-3 py-2 text-xs font-bold"
								aria-pressed="false"
							>
								ENG
							</button>
						</div>

						<a
							href="/contact"
							class="mobile-nav-link rounded-lg bg-[#f3bc34] px-4 py-3 text-sm font-bold text-[#1d2f5c]"
						>
							<span class="lang-id">Konsultasi</span>
							<span class="lang-en">Consultation</span>
						</a>
					</div>
				</div>
			</div>
		</header>

		<!-- PAGE CONTENT -->
		<slot />

		<!-- FOOTER -->
		<footer class="bg-[#1d2f5c] text-white">
			<div class="mx-auto max-w-7xl px-6 py-14 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-[1.2fr_0.7fr_1.15fr]">
					<!-- BRAND -->
					<div>
						<a
							href="/"
							aria-label="NOVA Learning Centre"
							class="inline-flex"
						>
							<img
								src="/images/primary-logo-reversed.png"
								alt="NOVA Learning Centre"
								class="h-20 w-auto object-contain sm:h-24"
							/>
						</a>

						<p class="mt-6 max-w-md text-sm leading-7 text-white/70">
							<span class="lang-id">
								Pusat pembelajaran modern untuk anak dan remaja melalui
								pembelajaran akademik, enrichment, dan e-learning.
							</span>

							<span class="lang-en">
								A modern learning centre for children and teenagers through
								academic learning, enrichment and e-learning.
							</span>
						</p>

						<p class="mt-6 text-base font-extrabold text-[#f3bc34]">
							Inspiring Young Minds, Building Bright Futures
						</p>

						<div class="mt-5 flex items-center gap-3" aria-label="NOVA social media">
							<a
								href="https://www.instagram.com/novalearningcentre.id/"
								target="_blank"
								rel="noreferrer"
								aria-label="Instagram NOVA Learning Centre"
								title="Instagram"
								class="social-link"
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect x="3" y="3" width="18" height="18" rx="5"></rect>
									<circle cx="12" cy="12" r="4"></circle>
									<circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none"></circle>
								</svg>
							</a>

							<a
								href="https://www.facebook.com/novalearningcentre.id/"
								target="_blank"
								rel="noreferrer"
								aria-label="Facebook NOVA Learning Centre"
								title="Facebook"
								class="social-link"
							>
								<svg
									viewBox="0 0 24 24"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="M14.5 8.2V6.7c0-.8.5-1 1-1h2.3V2.2L14.6 2c-3.2 0-4.7 1.9-4.7 4.5v1.7H7v4h2.9V22h4.3v-9.8h3.2l.5-4h-3.4Z"></path>
								</svg>
							</a>

							<a
								href="https://www.threads.net/@novalearningcentre.id"
								target="_blank"
								rel="noreferrer"
								aria-label="Threads NOVA Learning Centre"
								title="Threads"
								class="social-link"
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M12 2.5c5.3 0 9.2 3.7 9.2 9.2 0 5.3-3.6 9.8-9.1 9.8-5.8 0-9.3-4.3-9.3-9.6 0-5.4 3.8-9.4 9.2-9.4Z"></path>
									<path d="M8.1 9.1c.5-2 2-3.2 4.1-3.2 3.1 0 5.2 2.1 5.2 5.2 0 3.3-1.7 5.6-4.7 5.6-2.2 0-3.7-1.2-3.7-3 0-1.9 1.6-3 3.8-3 2.1 0 3.7.7 4.8 2"></path>
								</svg>
							</a>

							<a
								href="https://www.tiktok.com/@novalearningcentre.id"
								target="_blank"
								rel="noreferrer"
								aria-label="TikTok NOVA Learning Centre"
								title="TikTok"
								class="social-link"
							>
								<svg
									viewBox="0 0 24 24"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="M14.4 2h3.2c.2 1.5 1 2.8 2.2 3.7 1 .7 2 1 3.2 1v3.3c-1.5 0-3-.4-4.3-1.1-.4-.2-.7-.4-1.1-.7v6.4c0 4.1-3.3 7.4-7.4 7.4S2.8 18.7 2.8 14.6s3.3-7.4 7.4-7.4c.4 0 .8 0 1.2.1v3.4c-.4-.1-.8-.2-1.2-.2-2.2 0-4.1 1.8-4.1 4.1s1.8 4.1 4.1 4.1 4.2-1.7 4.2-4V2Z"></path>
								</svg>
							</a>
						</div>

						<p class="mt-3 text-xs font-semibold text-white/45">
							@novalearningcentre.id
						</p>
					</div>

					<!-- NAVIGATION -->
					<div>
						<h3
							class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#f3bc34]"
						>
							<span class="lang-id">Navigasi</span>
							<span class="lang-en">Navigation</span>
						</h3>

						<div class="mt-5 grid gap-1">
							{
								navItems.map((item) => (
									<a
										href={item.href}
										class="group flex items-center gap-2 py-2 text-sm font-semibold text-white/75 transition hover:text-[#f3bc34]"
									>
										<span
											class="h-px w-0 bg-[#f3bc34] transition-all group-hover:w-4"
										>
										</span>

										<span class="lang-id">{item.nameId}</span>
										<span class="lang-en">{item.nameEn}</span>
									</a>
								))
							}
						</div>
					</div>

					<!-- CONTACT -->
					<div>
						<h3
							class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#f3bc34]"
						>
							<span class="lang-id">Hubungi Kami</span>
							<span class="lang-en">Contact Us</span>
						</h3>

						<div class="mt-6 space-y-5 text-sm text-white/75">
							<div>
								<p class="font-extrabold text-white">
									<span class="lang-id">Lokasi</span>
									<span class="lang-en">Location</span>
								</p>

								<a
									href={mapsUrl}
									target="_blank"
									rel="noreferrer"
									class="mt-1 block max-w-md leading-6 transition hover:text-[#f3bc34]"
								>
									Ruko Grand Orchard Blok C-21,<br />
									Jl. Terusan Kelapa Hybrida, Sukapura,<br />
									Cilincing, Jakarta Utara 14140
								</a>
							</div>

							<div>
								<p class="font-extrabold text-white">
									<span class="lang-id">Jam Operasional</span>
									<span class="lang-en">Opening Hours</span>
								</p>

								<div
									class="mt-2 grid grid-cols-[130px_1fr] gap-y-1 leading-6"
								>
									<span>
										<span class="lang-id">Senin – Jumat</span>
										<span class="lang-en">Monday – Friday</span>
									</span>
									<span>10.00 – 20.00</span>

									<span>
										<span class="lang-id">Sabtu</span>
										<span class="lang-en">Saturday</span>
									</span>
									<span>09.00 – 15.00</span>

									<span>
										<span class="lang-id">Minggu</span>
										<span class="lang-en">Sunday</span>
									</span>
									<span>
										<span class="lang-id">Tutup</span>
										<span class="lang-en">Closed</span>
									</span>
								</div>
							</div>

							<div>
								<p class="font-extrabold text-white">
									Email
								</p>

								<a
									href="mailto:novalearningcentre@gmail.com"
									class="mt-1 block transition hover:text-[#f3bc34]"
								>
									novalearningcentre@gmail.com
								</a>
							</div>

							<a
								href={whatsappUrl}
								target="_blank"
								rel="noreferrer"
								class="inline-flex rounded-lg bg-[#f3bc34] px-5 py-3 font-extrabold text-[#1d2f5c] transition hover:-translate-y-0.5 hover:shadow-lg"
							>
								<span class="lang-id">Hubungi NOVA via WhatsApp</span>
								<span class="lang-en">Contact NOVA on WhatsApp</span>
							</a>
						</div>
					</div>
				</div>

				<div
					class="mt-12 flex flex-col gap-4 border-t border-white/15 pt-7 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between"
				>
					<p>
						© {currentYear} NOVA Learning Centre. All rights reserved.
					</p>

					<div class="flex gap-5">
						<a
							href="/privacy"
							class="transition hover:text-[#f3bc34]"
						>
							<span class="lang-id">Kebijakan Privasi</span>
							<span class="lang-en">Privacy Policy</span>
						</a>

						<a
							href="/terms"
							class="transition hover:text-[#f3bc34]"
						>
							<span class="lang-id">Syarat & Ketentuan</span>
							<span class="lang-en">Terms & Conditions</span>
						</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// LANGUAGE SWITCHER
			const languageButtons = Array.from(
				document.querySelectorAll<HTMLButtonElement>('[data-language]'),
			);

			const applyLanguage = (language: 'id' | 'en') => {
				document.documentElement.dataset.lang = language;
				document.documentElement.lang =
					language === 'en' ? 'en-AU' : 'id';

				languageButtons.forEach((button) => {
					const isActive = button.dataset.language === language;

					button.classList.toggle('is-active', isActive);
					button.setAttribute(
						'aria-pressed',
						String(isActive),
					);
				});

				try {
					window.localStorage.setItem(
						'nova-language',
						language,
					);
				} catch {
					// Local storage may be unavailable.
				}
			};

			let storedLanguage: 'id' | 'en' = 'id';

			try {
				const savedLanguage =
					window.localStorage.getItem('nova-language');

				if (
					savedLanguage === 'en' ||
					savedLanguage === 'id'
				) {
					storedLanguage = savedLanguage;
				}
			} catch {
				// Indonesian remains the default.
			}

			applyLanguage(storedLanguage);

			languageButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const language = button.dataset.language;

					if (language === 'id' || language === 'en') {
						applyLanguage(language);
					}
				});
			});

			// MOBILE MENU
			const mobileMenuButton =
				document.querySelector<HTMLButtonElement>(
					'#mobile-menu-button',
				);

			const mobileMenu =
				document.querySelector<HTMLElement>('#mobile-menu');

			const mobileNavLinks =
				document.querySelectorAll<HTMLAnchorElement>(
					'.mobile-nav-link',
				);

			const closeMobileMenu = () => {
				mobileMenu?.classList.add('hidden');
				mobileMenuButton?.setAttribute(
					'aria-expanded',
					'false',
				);
			};

			mobileMenuButton?.addEventListener('click', () => {
				const isNowHidden =
					mobileMenu?.classList.toggle('hidden') ?? true;

				mobileMenuButton.setAttribute(
					'aria-expanded',
					String(!isNowHidden),
				);
			});

			mobileNavLinks.forEach((link) => {
				link.addEventListener('click', closeMobileMenu);
			});
		</script>
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
		background: #ffffff;
		color: #1d2f5c;
		font-family: 'Figtree', Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html:not([data-lang='en']) .lang-en,
	html[data-lang='en'] .lang-id {
		display: none !important;
	}

	.language-button {
		color: rgba(29, 47, 92, 0.58);
		transition:
			background-color 180ms ease,
			color 180ms ease,
			box-shadow 180ms ease;
	}

	.language-button.is-active {
		background: #1d2f5c;
		color: #ffffff;
		box-shadow: 0 2px 8px rgba(29, 47, 92, 0.16);
	}

	.social-link {
		display: inline-flex;
		width: 2.5rem;
		height: 2.5rem;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.78);
		transition:
			transform 180ms ease,
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.social-link svg {
		width: 1.12rem;
		height: 1.12rem;
	}

	.social-link:hover {
		transform: translateY(-2px);
		border-color: #f3bc34;
		background: #f3bc34;
		color: #1d2f5c;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
		}
	}
</style>
