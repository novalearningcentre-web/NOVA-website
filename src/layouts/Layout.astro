---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'NOVA Learning Centre',
	description = 'A modern learning centre for children, teens, and lifelong learners.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link
			rel="icon"
			type="image/png"
			href="/images/logo-icon-biru.png"
		/>

		<title>{title}</title>
	</head>

	<body>
		<slot />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
		background: #ffffff;
		color: #0f2747;
		font-family:
			Inter,
			Arial,
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
</style>