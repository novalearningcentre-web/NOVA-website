---
import Layout from '../layouts/Layout.astro';

const currentYear = new Date().getFullYear();

/*
	Ganti setelah NOVA memiliki jumlah siswa aktif yang bisa dipublikasikan.
	Contoh: const studentCount = 48;
*/
const studentCount = 0;

type Statistic = {
	value: string;
	label: string;
};

type Program = {
	number: string;
	title: string;
	description: string;
	label: string;
	href: string;
};

type Teacher = {
	initials: string;
	name: string;
	photo?: string;
	credentials: string;
	subjects: string[];
	quote: string;
};

type Testimonial = {
	quote: string;
	name: string;
	relation: string;
	program: string;
	rating: number;
	photo?: string;
	demo?: boolean;
};

const navItems = [
	{ name: 'Beranda', href: '/' },
	{ name: 'Tentang Kami', href: '/about' },
	{ name: 'Program', href: '/programs' },
	{ name: 'Fasilitas', href: '/facilities' },
	{ name: 'E-Learning', href: '/elearning' },
	{ name: 'Kontak', href: '/contact' },
];

const statistics: Statistic[] =
	studentCount > 0
		? [
				{
					value: `${studentCount}+`,
					label: 'Siswa telah bergabung',
				},
				{
					value: '4+',
					label: 'Jenjang pendidikan',
				},
				{
					value: 'Small Group',
					label: 'Kelas lebih terarah',
				},
				{
					value: 'Onsite & Online',
					label: 'Pilihan pembelajaran',
				},
			]
		: [
				{
					value: 'Angkatan 1',
					label: 'Pendaftaran segera dibuka',
				},
				{
					value: '4+',
					label: 'Jenjang pendidikan',
				},
				{
					value: 'Small Group',
					label: 'Kelas lebih terarah',
				},
				{
					value: 'Onsite & Online',
					label: 'Pilihan pembelajaran',
				},
			];

const programs: Program[] = [
	{
		number: '01',
		title: 'Early Learners',
		description:
			'Program eksploratif untuk PAUD dan TK melalui aktivitas bermain, bergerak, berkomunikasi, dan belajar.',
		label: 'Usia 3–6 tahun',
		href: '/programs#early-learners',
	},
	{
		number: '02',
		title: 'Primary',
		description:
			'Pendampingan akademik untuk membangun fondasi konsep, kebiasaan belajar, dan kepercayaan diri.',
		label: 'SD Kelas 1–6',
		href: '/programs#primary',
	},
	{
		number: '03',
		title: 'Secondary',
		description:
			'Program terarah untuk memahami konsep, mengembangkan strategi belajar, dan mempersiapkan ujian.',
		label: 'SMP & SMA',
		href: '/programs#secondary',
	},
	{
		number: '04',
		title: 'Language & Skills',
		description:
			'Kelas bahasa dan keterampilan praktis untuk anak, remaja, mahasiswa, dan pembelajar dewasa.',
		label: 'Semua jenjang',
		href: '/programs#language-skills',
	},
];

/*
	Untuk menampilkan foto:
	Foto teacher disimpan langsung di public/images/
	Path pada data teacher sudah disesuaikan dengan nama file yang digunakan.
	Jika photo dikosongkan, sistem tetap menampilkan inisial.
*/
/*
	CATATAN:
	Empat profil selain Halley Kuncoro masih placeholder untuk preview website.
	Ganti nama, gelar, mata pelajaran, dan quote sebelum website dipublikasikan.
*/
const teachers: Teacher[] = [
	{
		initials: 'HK',
		name: 'Halley Kuncoro',
		photo: '/images/teacher-1.png',
		credentials:
			'Master of Educational Technology · STEM Certified Educator · Google Certified Educator',
		subjects: ['Matematika', 'ICT', 'Computing'],
		quote:
			'Belajar bukan hanya memahami materi, tetapi membangun cara berpikir dan rasa percaya diri.',
	},
	{
		initials: 'MP',
		name: 'Monica Putri Pertiwi',
		photo: '/images/teacher-4.png',
		credentials:
			'S.pd Early Childhood & English Educator',
		subjects: ['English', 'Pre-School', 'Primary'],
		quote:
			'Nurturing young minds to grow, explore, and shine.',
	},
	{
		initials: 'KF',
		name: 'Karimah Fajriani',
		photo: '/images/teacher-5.png',
		credentials:
			'S.Pd., • Physics Educator',
		subjects: ['Science', 'Matematika', 'SMP', 'Fisika', 'SMA'],
		quote:
			'Menciptakan ruang belajar yang mendorong siswa untuk bertanya, memahami, dan percaya pada kemampuannya.',
	},
	{
		initials: 'JS',
		name: 'Juli Silaen',
		photo: '/images/teacher-6.png',
		credentials:
			'S.Psi. · Early Childhood Educator · Child-Centered Learning',
		subjects: ['PAUD', 'TK', 'School Readiness'],
		quote:
			'Anak belajar paling baik ketika kegiatan terasa aman, menyenangkan, dan sesuai tahap perkembangannya.',
	},
	{
		initials: 'ON',
		name: 'Olivia Novita',
		photo: '/images/teacher-2.png',
		credentials:
			'MBA · Business & Marketing Educator · Early Childhood Educator',
		subjects: ['English', 'Language Skills'],
		quote:
			'Kemampuan bahasa tumbuh lewat latihan yang konsisten, konteks yang nyata, dan keberanian untuk berkomunikasi.',
	},
];

/*
	CONTOH COPY TESTIMONI UNTUK PREVIEW DESAIN.
	Jangan dipublikasikan seolah-olah ini testimoni nyata.
	Sebelum website go-live, ganti teks, nama, dan foto dengan testimoni asli
	yang sudah mendapat izin dari siswa/orang tua.
*/
const testimonials: Testimonial[] = [
	{
		quote:
			'Yang paling terasa, anak saya sekarang lebih berani bertanya ketika belum paham. Belajarnya juga jadi lebih teratur dan tidak lagi terasa seperti beban.',
		name: 'Rina Santoso',
		relation: 'Orang tua siswa SD',
		program: 'Program Primary',
		rating: 5,
		photo: '',
		demo: true,
	},
	{
		quote:
			'Saya suka karena pengajarnya tidak hanya mengejar banyak soal. Konsepnya benar-benar dijelaskan sampai anak paham, lalu baru dilatih supaya lebih mandiri.',
		name: 'Melissa Wijaya',
		relation: 'Orang tua siswa SMP',
		program: 'Program Secondary',
		rating: 5,
		photo: '',
		demo: true,
	},
	{
		quote:
			'Kelasnya terasa nyaman dan tidak membuat saya takut salah. Saya jadi lebih percaya diri untuk mencoba, bertanya, dan menjelaskan jawaban saya sendiri.',
		name: 'Jessica Tan',
		relation: 'Siswa SMP',
		program: 'English & Academic Skills',
		rating: 5,
		photo: '',
		demo: true,
	},
	{
		quote:
			'Komunikasi dengan orang tua jelas dan perkembangan belajar anak lebih mudah dipantau. Kami jadi tahu bagian mana yang sudah kuat dan mana yang masih perlu dibantu.',
		name: 'Dewi Anggraini',
		relation: 'Orang tua siswa',
		program: 'Private Class',
		rating: 5,
		photo: '',
		demo: true,
	},
	{
		quote:
			'Materi online membantu saya mengulang pelajaran kapan saja. Kalau ada bagian yang belum paham, saya bisa kembali ke materinya sebelum lanjut ke latihan berikutnya.',
		name: 'Ethan Hartono',
		relation: 'Siswa SMA',
		program: 'NOVA E-Learning',
		rating: 5,
		photo: '',
		demo: true,
	},
];

const footerLinks = [
	{ name: 'Beranda', href: '/' },
	{ name: 'Tentang Kami', href: '/about' },
	{ name: 'Program', href: '/programs' },
	{ name: 'Fasilitas', href: '/facilities' },
	{ name: 'E-Learning', href: '/elearning' },
	{ name: 'Kontak', href: '/contact' },
];
---

<Layout
	title="NOVA Learning Centre"
	description="Pusat pembelajaran modern untuk anak, remaja, dan pembelajar sepanjang hayat di Kelapa Gading."
>
	<!-- NAVBAR -->
	<header
		class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl"
	>
		<nav
			class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8"
			aria-label="Navigasi utama"
		>
			<a
				href="/"
				class="flex items-center"
				aria-label="NOVA Learning Centre"
			>
				<img
					src="/images/primary-logo.png"
					alt="NOVA Learning Centre"
					class="h-30 w-30 object-contain sm:hidden"
				/>

				<img
					src="/images/primary-logo.png"
					alt="NOVA Learning Centre"
					class="hidden h-20 w-auto object-contain sm:block"
				/>
			</a>

			<div class="hidden items-center gap-7 lg:flex">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class="text-sm font-semibold text-slate-600 transition hover:text-[#A87300]"
						>
							{item.name}
						</a>
					))
				}
			</div>

			<a
				href="/contact"
				class="hidden rounded-xl bg-[#F3BC34] px-5 py-3 text-sm font-bold text-[#0F2747] shadow-sm transition hover:-translate-y-0.5 hover:bg-[#DFA722] lg:inline-flex"
			>
				Konsultasi Gratis
			</a>

			<button
				id="mobile-menu-button"
				type="button"
				class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-300 bg-white text-[#0F2747] lg:hidden"
				aria-label="Buka menu navigasi"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg
					width="23"
					height="23"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16"></path>
					<path d="M4 12h16"></path>
					<path d="M4 17h16"></path>
				</svg>
			</button>
		</nav>

		<div
			id="mobile-menu"
			class="hidden border-t border-slate-200 bg-white px-6 py-5 lg:hidden"
		>
			<div class="flex flex-col gap-4">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class="mobile-nav-link text-sm font-semibold text-slate-700 transition hover:text-[#A87300]"
						>
							{item.name}
						</a>
					))
				}

				<a
					href="/contact"
					class="mobile-nav-link mt-2 rounded-xl bg-[#F3BC34] px-5 py-3 text-center text-sm font-bold text-[#0F2747]"
				>
					Konsultasi Gratis
				</a>
			</div>
		</div>
	</header>

	<main class="overflow-hidden">
		<!-- HERO -->
		<section class="relative bg-[#F7F8FC]">
			<div
				class="absolute -left-32 top-20 h-80 w-80 rounded-full bg-[#F3BC34]/20 blur-3xl"
				aria-hidden="true"
			>
			</div>

			<div
				class="absolute -right-32 bottom-10 h-96 w-96 rounded-full bg-blue-200/40 blur-3xl"
				aria-hidden="true"
			>
			</div>

			<div
				class="relative mx-auto grid min-h-[760px] max-w-7xl items-center gap-14 px-6 py-20 lg:grid-cols-[1.02fr_0.98fr] lg:px-8 lg:py-24"
			>
				<div class="relative z-10">
					<div
						class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#F3BC34]/35 bg-white px-4 py-2 shadow-sm"
					>
						<span class="h-2 w-2 rounded-full bg-[#F3BC34]"></span>

						<span class="text-sm font-semibold text-[#0F2747]">
							Pusat Belajar Modern di Kelapa Gading
						</span>
					</div>

					<h1
						class="max-w-3xl text-5xl font-bold leading-[1.08] tracking-[-0.04em] text-[#0F2747] sm:text-6xl lg:text-7xl"
					>
						Belajar lebih terarah.

						<span class="block text-[#F3BC34]">
							Tumbuh lebih percaya diri.
						</span>
					</h1>

					<p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">
						NOVA menghadirkan pembelajaran personal melalui kelas tatap
						muka, kelompok kecil, private class, dan kursus e-learning yang
						fleksibel.
					</p>

					<div class="mt-9 flex flex-col gap-4 sm:flex-row">
						<a
							href="/programs"
							class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#F3BC34] px-7 py-4 font-bold text-[#0F2747] shadow-lg shadow-[#F3BC34]/20 transition hover:-translate-y-0.5 hover:bg-[#DFA722]"
						>
							Lihat Program

							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
							>
								<path d="M5 12h14"></path>
								<path d="m13 6 6 6-6 6"></path>
							</svg>
						</a>

						<a
							href="/contact"
							class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-7 py-4 font-semibold text-[#0F2747] transition hover:border-[#0F2747] hover:bg-slate-50"
						>
							Konsultasi Gratis
						</a>
					</div>

					<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
						<div class="flex items-center gap-3">
							<div
								class="flex h-10 w-10 items-center justify-center rounded-full bg-green-100 text-green-700"
							>
								<svg
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
								>
									<path d="m5 12 4 4L19 6"></path>
								</svg>
							</div>

							<div>
								<p class="text-sm font-semibold text-[#0F2747]">
									Kelas kelompok kecil
								</p>

								<p class="text-xs text-slate-500">
									Belajar lebih fokus
								</p>
							</div>
						</div>

						<div class="flex items-center gap-3">
							<div
								class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 text-blue-700"
							>
								<svg
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
								>
									<circle cx="12" cy="12" r="9"></circle>
									<path d="M12 7v5l3 2"></path>
								</svg>
							</div>

							<div>
								<p class="text-sm font-semibold text-[#0F2747]">
									Jadwal fleksibel
								</p>

								<p class="text-xs text-slate-500">
									Online dan onsite
								</p>
							</div>
						</div>
					</div>
				</div>

				<!-- HERO VISUAL -->
				<div class="relative mx-auto w-full max-w-xl lg:max-w-none">
					<div
						class="absolute -left-8 top-16 h-40 w-40 rounded-full bg-[#F3BC34]/20 blur-2xl"
						aria-hidden="true"
					>
					</div>

					<div
						class="relative overflow-hidden rounded-[32px] border border-white/70 bg-white p-4 shadow-[0_30px_80px_rgba(15,39,71,0.16)]"
					>
						<div
							class="relative min-h-[560px] overflow-hidden rounded-[24px] bg-[#0F2747]"
						>
							<div
								class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(245,130,32,0.32),transparent_42%)]"
								aria-hidden="true"
							>
							</div>

							<div
								class="absolute left-7 right-7 top-7 flex items-center justify-between"
							>
								<div class="flex items-center gap-3">
									<div
										class="flex h-10 w-10 items-center justify-center rounded-xl bg-white"
									>
										<img
											src="/images/primary-logo-icon.png"
											alt=""
											class="h-8 w-8 object-contain"
										/>
									</div>

									<div>
										<p class="text-sm font-bold text-white">
											NOVA Learning
										</p>

										<p class="text-xs text-blue-200">
											Personalized Learning
										</p>
									</div>
								</div>

								<div class="flex gap-2" aria-hidden="true">
									<span class="h-2 w-2 rounded-full bg-white/40"></span>
									<span class="h-2 w-2 rounded-full bg-white/70"></span>
									<span class="h-2 w-2 rounded-full bg-[#F3BC34]"></span>
								</div>
							</div>

							<div class="absolute inset-x-7 top-28">
								<div
									class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-md"
								>
									<div class="flex items-start justify-between gap-5">
										<div>
											<p
												class="text-xs font-semibold uppercase tracking-[0.18em] text-[#F3BC34]"
											>
												Program NOVA
											</p>

											<h2 class="mt-3 text-3xl font-bold text-white">
												Belajar sesuai kebutuhan setiap siswa.
											</h2>
										</div>

										<div
											class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#F3BC34] text-[#0F2747]"
										>
											<svg
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												aria-hidden="true"
											>
												<path d="m5 12 4 4L19 6"></path>
											</svg>
										</div>
									</div>

									<div class="mt-8">
										<div class="flex items-center justify-between text-sm">
											<span class="text-blue-100">
												Perkembangan belajar
											</span>

											<span class="font-semibold text-white">
												78%
											</span>
										</div>

										<div
											class="mt-3 h-2 overflow-hidden rounded-full bg-white/15"
										>
											<div
												class="h-full w-[78%] rounded-full bg-[#F3BC34]"
											>
											</div>
										</div>
									</div>
								</div>
							</div>

							<div
								class="absolute bottom-7 left-7 right-7 grid gap-4 sm:grid-cols-2"
							>
								<div class="rounded-2xl bg-white p-5 shadow-xl">
									<div class="flex items-center justify-between">
										<div
											class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F3BC34]/20 text-[#F3BC34]"
										>
											<svg
												width="20"
												height="20"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												aria-hidden="true"
											>
												<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20">
												</path>
												<path
													d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"
												>
												</path>
											</svg>
										</div>

										<span
											class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700"
										>
											Aktif
										</span>
									</div>

									<p class="mt-5 text-sm font-semibold text-slate-500">
										Kelas Tatap Muka
									</p>

									<p class="mt-1 text-xl font-bold text-[#0F2747]">
										Small Group Class
									</p>
								</div>

								<div
									class="rounded-2xl bg-[#F3BC34] p-5 text-[#0F2747] shadow-xl"
								>
									<div
										class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/20"
									>
										<svg
											width="20"
											height="20"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											aria-hidden="true"
										>
											<polygon points="5 3 19 12 5 21 5 3"></polygon>
										</svg>
									</div>

									<p class="mt-5 text-sm font-semibold text-[#FFF0BF]">
										E-Learning
									</p>

									<p class="mt-1 text-xl font-bold">
										Belajar Kapan Saja
									</p>
								</div>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- STATISTICS -->
		<section class="border-y border-slate-200 bg-white">
			<div
				class="mx-auto grid max-w-7xl grid-cols-2 px-6 py-8 md:grid-cols-4 lg:px-8"
			>
				{
					statistics.map((stat) => (
						<div class="border-slate-200 px-4 py-5 text-center even:border-l md:border-l md:px-6 md:first:border-l-0">
							<p class="text-2xl font-bold text-[#0F2747] md:text-3xl">
								{stat.value}
							</p>

							<p class="mt-2 text-sm leading-5 text-slate-500">
								{stat.label}
							</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- PROGRAMS -->
		<section class="bg-white py-24">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div
					class="flex flex-col justify-between gap-8 md:flex-row md:items-end"
				>
					<div>
						<p
							class="text-sm font-bold uppercase tracking-[0.2em] text-[#A87300]"
						>
							Program NOVA
