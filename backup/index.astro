<script>
	// MOBILE MENU
	const mobileMenuButton =
		document.querySelector<HTMLButtonElement>('#mobile-menu-button');
	const mobileMenu =
		document.querySelector<HTMLElement>('#mobile-menu');
	const mobileNavLinks =
		document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

	const closeMobileMenu = () => {
		mobileMenu?.classList.add('hidden');
		mobileMenuButton?.setAttribute('aria-expanded', 'false');
	};

	mobileMenuButton?.addEventListener('click', () => {
		const isNowHidden = mobileMenu?.classList.toggle('hidden') ?? true;
		mobileMenuButton.setAttribute('aria-expanded', String(!isNowHidden));
	});

	mobileNavLinks.forEach((link) => {
		link.addEventListener('click', closeMobileMenu);
	});

	// TEACHER SLIDER
	const teacherSlider =
		document.querySelector<HTMLElement>('#teacher-slider');
	const teacherPreviousButton =
		document.querySelector<HTMLButtonElement>('#teacher-prev');
	const teacherNextButton =
		document.querySelector<HTMLButtonElement>('#teacher-next');

	const getSliderGap = (element: HTMLElement) => {
		const computedStyle = window.getComputedStyle(element);
		const rawGap = computedStyle.columnGap || computedStyle.gap || '0';
		const gap = Number.parseFloat(rawGap);

		return Number.isFinite(gap) ? gap : 0;
	};

	const moveTeacherSlider = (direction: number) => {
		if (!teacherSlider) return;

		const firstCard =
			teacherSlider.querySelector<HTMLElement>('[data-teacher-card]');

		const step =
			(firstCard?.offsetWidth ?? 300) + getSliderGap(teacherSlider);

		teacherSlider.scrollBy({
			left: direction * step,
			behavior: 'smooth',
		});
	};

	teacherPreviousButton?.addEventListener('click', () => {
		moveTeacherSlider(-1);
	});

	teacherNextButton?.addEventListener('click', () => {
		moveTeacherSlider(1);
	});

	// TESTIMONIAL SLIDER
	const testimonialSlider =
		document.querySelector<HTMLElement>('#testimonial-slider');
	const testimonialCards = Array.from(
		document.querySelectorAll<HTMLElement>('[data-testimonial-card]'),
	);
	const testimonialDots = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]'),
	);
	const testimonialPreviousButton =
		document.querySelector<HTMLButtonElement>('#testimonial-prev');
	const testimonialNextButton =
		document.querySelector<HTMLButtonElement>('#testimonial-next');

	let testimonialIndex = 0;
	let testimonialTimer: number | undefined;
	let testimonialScrollFrame: number | undefined;

	const updateTestimonialDots = () => {
		testimonialDots.forEach((dot, index) => {
			const isActive = index === testimonialIndex;
			dot.classList.toggle('is-active', isActive);
			dot.setAttribute('aria-current', isActive ? 'true' : 'false');
		});

		testimonialCards.forEach((card, index) => {
			card.classList.toggle('is-active', index === testimonialIndex);
		});
	};

	const goToTestimonial = (index: number, smooth = true) => {
		if (!testimonialSlider || testimonialCards.length === 0) return;

		testimonialIndex =
			(index + testimonialCards.length) % testimonialCards.length;

		const activeCard = testimonialCards[testimonialIndex];
		const centeredPosition =
			activeCard.offsetLeft -
			(testimonialSlider.clientWidth - activeCard.offsetWidth) / 2;

		testimonialSlider.scrollTo({
			left: centeredPosition,
			behavior: smooth ? 'smooth' : 'auto',
		});

		updateTestimonialDots();
	};

	const startTestimonialAutoPlay = () => {
		window.clearInterval(testimonialTimer);

		testimonialTimer = window.setInterval(() => {
			goToTestimonial(testimonialIndex + 1);
		}, 6000);
	};

	const stopTestimonialAutoPlay = () => {
		window.clearInterval(testimonialTimer);
	};

	testimonialPreviousButton?.addEventListener('click', () => {
		goToTestimonial(testimonialIndex - 1);
		startTestimonialAutoPlay();
	});

	testimonialNextButton?.addEventListener('click', () => {
		goToTestimonial(testimonialIndex + 1);
		startTestimonialAutoPlay();
	});

	testimonialDots.forEach((dot, index) => {
		dot.addEventListener('click', () => {
			goToTestimonial(index);
			startTestimonialAutoPlay();
		});
	});

	testimonialSlider?.addEventListener('scroll', () => {
		if (testimonialScrollFrame) {
			window.cancelAnimationFrame(testimonialScrollFrame);
		}

		testimonialScrollFrame = window.requestAnimationFrame(() => {
			if (!testimonialSlider || testimonialCards.length === 0) return;

			const sliderCenter =
				testimonialSlider.scrollLeft + testimonialSlider.clientWidth / 2;

			let closestIndex = 0;
			let closestDistance = Number.POSITIVE_INFINITY;

			testimonialCards.forEach((card, index) => {
				const cardCenter = card.offsetLeft + card.offsetWidth / 2;
				const distance = Math.abs(cardCenter - sliderCenter);

				if (distance < closestDistance) {
					closestDistance = distance;
					closestIndex = index;
				}
			});

			if (closestIndex !== testimonialIndex) {
				testimonialIndex = closestIndex;
				updateTestimonialDots();
			}
		});
	});

	testimonialSlider?.addEventListener('mouseenter', stopTestimonialAutoPlay);
	testimonialSlider?.addEventListener('mouseleave', startTestimonialAutoPlay);
	testimonialSlider?.addEventListener('focusin', stopTestimonialAutoPlay);
	testimonialSlider?.addEventListener('focusout', startTestimonialAutoPlay);
	testimonialSlider?.addEventListener('touchstart', stopTestimonialAutoPlay, {
		passive: true,
	});
	testimonialSlider?.addEventListener('touchend', startTestimonialAutoPlay, {
		passive: true,
	});

	document.addEventListener('visibilitychange', () => {
		if (document.hidden) {
			stopTestimonialAutoPlay();
		} else {
			startTestimonialAutoPlay();
		}
	});

	updateTestimonialDots();
	startTestimonialAutoPlay();

	window.addEventListener('resize', () => {
		goToTestimonial(testimonialIndex, false);
	});
</script>

